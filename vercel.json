{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/calculator", "destination": "/calculator.html", "statusCode": 308 },
    { "source": "/success", "destination": "/success.html", "statusCode": 308 },
    { "source": "/love-match-result", "destination": "/love-match-result.html", "statusCode": 308 },
    { "source": "/synergy-guide", "destination": "/synergy-guide.html", "statusCode": 308 },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html", "statusCode": 308 },
    { "source": "/terms-of-service", "destination": "/terms-of-service.html", "statusCode": 308 },
    { "source": "/editorial-policy", "destination": "/editorial-policy.html", "statusCode": 308 },
    { "source": "/leaderboard", "destination": "/leaderboard.html", "statusCode": 308 },
    { "source": "/love-match", "destination": "/love-match.html", "statusCode": 308 },
    { "source": "/blog", "destination": "/blog.html", "statusCode": 308 },
    { "source": "/faq", "destination": "/faq.html", "statusCode": 308 },
    { "source": "/about", "destination": "/about.html", "statusCode": 308 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
