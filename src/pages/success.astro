---
import Base from '../layouts/Base.astro';
---

<Base
  title="Payment Successful — Your Reading is Unlocked | BaZi Destiny"
  description="Your Life Blueprint reading is unlocked. Return to your chart to see the full analysis."
  path="/success.html"
  noindex={true}
>
  <div class="wrap-narrow success-wrap">
    <div class="success-card panel" data-reveal>
      <div class="success-seal" aria-hidden="true">开</div>
      <h1 id="successTitle">Payment successful</h1>
      <p class="success-sub" id="successSub">Your full reading is unlocked — the seal is broken. Taking you back to your chart…</p>
      <div class="success-features" id="successFeatures">
        <span>✓ Full 12-section reading</span>
        <span>✓ Feng Shui analysis</span>
        <span>✓ Lucky kit</span>
        <span>✓ Print-ready report</span>
      </div>
      <a href="/calculator.html" class="btn btn-gold btn-lg" id="continueBtn">View My Full Reading →</a>
      <p class="success-note">Unlocked on this device. Questions? <a href="mailto:contact@mybazidestiny.com">contact@mybazidestiny.com</a></p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var title = document.getElementById('successTitle');
      var sub = document.getElementById('successSub');
      var features = document.getElementById('successFeatures');
      var btn = document.getElementById('continueBtn');

      var pending = null;
      var tier = null;
      try {
        tier = localStorage.getItem('pendingTier');
        var raw = localStorage.getItem('pendingReading');
        pending = raw ? JSON.parse(raw) : null;
      } catch (e) {}

      var validTier = tier === 'pro' || tier === 'synergy';
      var validPending = pending && typeof pending === 'object' && (
        tier === 'synergy'
          ? typeof pending.n1 === 'string' && typeof pending.n2 === 'string'
          : typeof pending.date === 'string'
      );

      // No matching checkout was started on this device — nothing to complete.
      if (!validTier || !validPending) {
        if (title) title.textContent = 'No active checkout';
        if (sub) sub.textContent = 'We could not find a recent purchase started on this device. Cast your chart first, then check out.';
        if (features) features.style.display = 'none';
        if (btn) { btn.textContent = 'Start a Free Reading'; btn.setAttribute('href', '/calculator.html'); }
        return;
      }

      var dest = '/calculator.html?payment=success';
      if (tier === 'synergy' && pending && pending.n1) {
        var q = new URLSearchParams();
        q.set('payment', 'success');
        q.set('n1', String(pending.n1 || 'Person 1'));
        q.set('n2', String(pending.n2 || 'Person 2'));
        q.set('e1', String(pending.e1 || 'Wood'));
        q.set('e2', String(pending.e2 || 'Fire'));
        dest = '/synergy-guide.html?' + q.toString();
        if (sub) sub.textContent = 'Your Synergy Boost Guide is unlocked — taking you there now…';
        if (btn) btn.textContent = 'Open My Synergy Guide →';
      }
      if (btn) btn.setAttribute('href', dest);
      setTimeout(function () { window.location.href = dest; }, 2600);
    })();
  </script>
</Base>

<style>
  .success-wrap { padding: calc(68px + clamp(3rem, 8vh, 6rem)) 0 2rem; }
  .success-card { text-align: center; padding: clamp(2rem, 5vw, 3.2rem); max-width: 560px; margin-inline: auto; }
  .success-seal {
    width: 64px; height: 64px; margin: 0 auto 1.3rem;
    display: grid; place-items: center;
    border-radius: 10px;
    background: linear-gradient(155deg, #e86050, var(--cinnabar) 45%, var(--cinnabar-deep));
    color: #fdf6ec; font-family: var(--font-han); font-size: 1.9rem;
    transform: rotate(-3deg);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14), 0 14px 34px -10px rgba(224,87,74,0.6);
  }
  .success-card h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .success-sub { color: var(--bone-dim); margin-top: 0.7rem; }
  .success-features {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem;
    margin: 1.4rem 0 1.8rem;
  }
  .success-features span {
    font-size: 0.78rem; color: var(--gold-bright);
    border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem;
    background: rgba(212,175,106,0.06);
  }
  .success-note { margin-top: 1.4rem; font-size: 0.8rem; color: var(--bone-faint); }
</style>
