---
import Base from '../layouts/Base.astro';
---

<Base
  title="Payment Successful — Your Reading is Unlocked | MyBaziDestiny"
  description="Your Life Blueprint reading is unlocked. Return to your chart to see the full analysis."
  path="/success.html"
  noindex={true}
>
  <div class="wrap-narrow success-wrap">
    <div class="success-card panel" data-reveal>
      <div class="success-seal" aria-hidden="true">开</div>
      <h1 id="successTitle">Verifying payment</h1>
      <p class="success-sub" id="successSub">Confirming your order securely with PayPal…</p>
      <div class="success-features" id="successFeatures">
        <span>✓ Full 12-section reading</span>
        <span>✓ Feng Shui analysis</span>
        <span>✓ Lucky kit</span>
        <span>✓ Print-ready report</span>
      </div>
      <a href="/calculator.html" class="btn btn-gold btn-lg" id="continueBtn" hidden>View My Full Reading →</a>
      <p class="success-note">Questions? <a href="mailto:contact@mybazidestiny.com">contact@mybazidestiny.com</a></p>
    </div>
  </div>

  <script is:inline>
    (async function () {
      var title = document.getElementById('successTitle');
      var sub = document.getElementById('successSub');
      var features = document.getElementById('successFeatures');
      var btn = document.getElementById('continueBtn');
      var params = new URLSearchParams(window.location.search);
      var tier = params.get('tier');
      var orderId = params.get('token');
      if ((tier !== 'pro' && tier !== 'synergy') || !orderId) {
        if (title) title.textContent = 'No active checkout';
        if (sub) sub.textContent = 'No PayPal order was returned to this page. Start from a paid reading to check out.';
        if (features) features.style.display = 'none';
        if (btn) { btn.hidden = false; btn.textContent = 'Start a Free Reading'; btn.setAttribute('href', '/calculator.html'); }
        return;
      }

      try {
        var response = await fetch('/api/paypal/capture-order', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ orderId: orderId, tier: tier })
        });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok || result.success !== true) throw new Error(result.error || 'Payment could not be verified');

        try {
          var purchaseKey = 'ga_purchase_' + orderId;
          if (!sessionStorage.getItem(purchaseKey) && typeof window.gtag === 'function') {
            var product = tier === 'synergy'
              ? { id: 'BAZI-SYNERGY', name: 'Synergy Boost Guide - Love Match', price: 4.90 }
              : { id: 'BAZI-PRO', name: 'Life Blueprint - Full BaZi Reading', price: 9.90 };
            window.gtag('event', 'purchase', {
              transaction_id: orderId,
              currency: 'USD',
              value: product.price,
              items: [{ item_id: product.id, item_name: product.name, price: product.price, quantity: 1 }]
            });
            sessionStorage.setItem(purchaseKey, '1');
          }
        } catch (_) {}

        if (title) title.textContent = 'Payment successful';
        if (sub) sub.textContent = tier === 'synergy'
          ? 'Your Synergy Boost Guide is unlocked — taking you there now…'
          : 'Your Life Blueprint is unlocked — taking you back to your chart…';
        var dest = tier === 'synergy' ? '/synergy-guide.html?checkout=complete' : '/calculator.html?checkout=complete';
        if (btn) {
          btn.hidden = false;
          btn.setAttribute('href', dest);
          btn.textContent = tier === 'synergy' ? 'Open My Synergy Guide →' : 'View My Full Reading →';
        }
        setTimeout(function () { window.location.href = dest; }, 1800);
      } catch (error) {
        if (title) title.textContent = 'Payment verification failed';
        if (sub) sub.textContent = 'We could not confirm this PayPal order. You have not been unlocked or charged again. Contact us if PayPal shows a completed payment.';
        if (features) features.style.display = 'none';
        if (btn) {
          btn.hidden = false;
          btn.textContent = 'Return to Calculator';
          btn.setAttribute('href', '/calculator.html');
        }
      }
    })();
  </script>
</Base>

<style>
  .success-wrap { padding: calc(68px + clamp(3rem, 8vh, 6rem)) 0 2rem; }
  .success-card { text-align: center; padding: clamp(2rem, 5vw, 3.2rem); max-width: 560px; margin-inline: auto; }
  .success-seal {
    width: 64px; height: 64px; margin: 0 auto 1.3rem;
    display: grid; place-items: center;
    border-radius: 10px;
    background: linear-gradient(155deg, #e86050, var(--cinnabar) 45%, var(--cinnabar-deep));
    color: #fdf6ec; font-family: var(--font-han); font-size: 1.9rem;
    transform: rotate(-3deg);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14), 0 14px 34px -10px rgba(224,87,74,0.6);
  }
  .success-card h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .success-sub { color: var(--bone-dim); margin-top: 0.7rem; }
  .success-features {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem;
    margin: 1.4rem 0 1.8rem;
  }
  .success-features span {
    font-size: 0.78rem; color: var(--gold-bright);
    border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem;
    background: rgba(212,175,106,0.06);
  }
  .success-note { margin-top: 1.4rem; font-size: 0.8rem; color: var(--bone-faint); }
</style>
