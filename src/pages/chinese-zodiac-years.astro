---
import Base from '../layouts/Base.astro';
import destinyEn from '../data/destiny-en.json';
import { SITE_URL } from '../lib/brand';

const decades = [...new Set(destinyEn.map((record) => Math.floor(record.year / 10) * 10))];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Chinese Zodiac Years from 1960 to 2030',
    url: `${SITE_URL}/chinese-zodiac-years.html`,
    description: 'An index of Chinese zodiac animals and Five Element year signs from 1960 to 2030.',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: destinyEn.length,
      itemListElement: destinyEn.map((record, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: record.h1,
        url: `${SITE_URL}/${record.slug}.html`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Chinese Zodiac Years' },
    ],
  },
];
---

<Base
  title="Chinese Zodiac Years 1960-2030: Signs & Elements"
  description="Find the Chinese zodiac animal and Five Element for birth years from 1960 to 2030, with calendar-boundary notes and links to each detailed year guide."
  keywords="Chinese zodiac years, Chinese zodiac by year, zodiac animal, Five Element year, birth year zodiac"
  path="/chinese-zodiac-years.html"
  jsonLd={jsonLd}
>
  <header class="years-hero">
    <div class="wrap-narrow center">
      <p class="eyebrow center"><span class="han">生肖年表</span> Year Index</p>
      <h1>Chinese Zodiac Years: <em>1960-2030</em></h1>
      <p class="years-lead">Find the zodiac animal and Five Element associated with a birth year, then open the year guide for traditional traits, compatibility, and calendar-boundary notes.</p>
    </div>
  </header>

  <section class="section years-intro">
    <div class="wrap-narrow">
      <h2>How to find your Chinese zodiac year</h2>
      <p>Your Chinese zodiac year combines one of 12 animals with one of the Five Elements. The cycle repeats every 60 years. If your birthday falls in January or early February, check the date boundary carefully: Lunar-zodiac references normally change at Lunar New Year, while BaZi Year Pillars commonly change at Li Chun.</p>
      <p>A birth-year sign is only a broad cultural reference. A complete <a href="/calculator.html">BaZi chart</a> also uses the birth month, day, hour, location, and solar-term boundaries.</p>
      <div class="featured-year">
        <div>
          <p class="eyebrow"><span class="han">丁未</span> Annual guide</p>
          <h2>2027 Fire Goat: the year ahead</h2>
          <p>Read the traditional themes of the 2027 Fire Goat year for all 12 animals, then use a full Four Pillars chart for a more personal context.</p>
        </div>
        <div class="featured-year-actions">
          <a class="btn btn-gold" href="/chinese-zodiac-2027-predictions.html">Read the 2027 guide</a>
          <a class="text-link" href="/calculator.html">Calculate my chart <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap years-directory">
    {decades.map((decade) => {
      const records = destinyEn.filter((record) => Math.floor(record.year / 10) * 10 === decade);
      return (
        <section class="decade" aria-labelledby={`decade-${decade}`}>
          <div class="decade-heading">
            <p class="eyebrow">Birth years</p>
            <h2 id={`decade-${decade}`}>{decade}s</h2>
          </div>
          <div class="year-grid">
            {records.map((record) => (
              <a class="year-link" href={`/${record.slug}.html`}>
                <span class="year-emoji" aria-hidden="true">{record.emoji}</span>
                <span class="year-copy">
                  <strong>{record.year}</strong>
                  <small>{record.h1.replace(`${record.year} `, '').replace(' Chinese Zodiac', '')}</small>
                </span>
                <span class="year-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <section class="section final-cta">
    <div class="wrap-narrow center">
      <h2>Go beyond your birth-year sign</h2>
      <p class="years-lead">Calculate all Four Pillars to identify your Day Master and Five Elements balance.</p>
      <a class="btn btn-gold btn-lg" href="/calculator.html">Open the Free BaZi Calculator</a>
    </div>
  </section>
</Base>

<style>
  .years-hero { padding: calc(68px + clamp(2.8rem, 7vh, 5rem)) 0 clamp(1.8rem, 4vh, 3rem); text-align: center; border-bottom: 1px solid var(--line-soft); }
  .years-hero h1 { font-size: clamp(2rem, 4.4vw, 3.3rem); }
  .years-hero h1 em { color: var(--gold); font-style: italic; }
  .years-lead { color: var(--bone-dim); max-width: 64ch; margin: 1rem auto 0; }
  .center { text-align: center; }
  .years-intro { padding-bottom: 0; }
  .years-intro h2 { font-size: 1.55rem; margin-bottom: 0.8rem; }
  .years-intro p { color: var(--bone-dim); line-height: 1.8; margin-top: 0.65rem; }
  .featured-year { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 2rem; padding: 1.5rem 1.7rem; border: 1px solid var(--gold-deep); background: rgba(212, 175, 106, 0.07); }
  .featured-year h2 { margin: 0.35rem 0 0.45rem; font-size: 1.45rem; }
  .featured-year p { margin: 0; max-width: 58ch; }
  .featured-year .eyebrow { margin: 0; color: var(--gold); }
  .featured-year-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 0.7rem; flex: 0 0 auto; }
  .text-link { color: var(--gold-bright); font-size: 0.88rem; text-decoration: underline; text-underline-offset: 3px; }
  .years-directory { padding-top: clamp(2.5rem, 6vh, 4.5rem); display: grid; gap: 2.6rem; }
  .decade { display: grid; grid-template-columns: minmax(100px, 0.24fr) 1fr; gap: 1.4rem 2rem; align-items: start; }
  .decade-heading { position: sticky; top: 88px; }
  .decade-heading h2 { color: var(--gold-bright); font-size: 1.8rem; }
  .year-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line-soft); }
  .year-link { min-height: 74px; display: grid; grid-template-columns: 38px 1fr 20px; align-items: center; gap: 0.75rem; padding: 0.8rem 0.9rem; color: var(--bone); border-bottom: 1px solid var(--line-soft); transition: color 0.2s, background 0.2s; }
  .year-link:nth-child(odd) { border-right: 1px solid var(--line-soft); }
  .year-link:hover { color: var(--gold-bright); background: rgba(212, 175, 106, 0.05); }
  .year-emoji { font-size: 1.45rem; }
  .year-copy { display: flex; flex-direction: column; min-width: 0; }
  .year-copy strong { font-family: var(--font-display); font-size: 1.18rem; }
  .year-copy small { color: var(--bone-dim); font-size: 0.78rem; }
  .year-arrow { color: var(--gold-deep); }
  .final-cta { border-top: 1px solid var(--line-soft); margin-top: var(--section-y); }
  .final-cta h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); }
  .final-cta .btn { margin-top: 1.4rem; }
  @media (max-width: 720px) {
    .decade { grid-template-columns: 1fr; gap: 0.7rem; }
    .decade-heading { position: static; }
    .year-grid { grid-template-columns: 1fr; }
    .year-link:nth-child(odd) { border-right: 0; }
    .featured-year { align-items: flex-start; flex-direction: column; gap: 1.2rem; }
    .featured-year-actions { align-items: flex-start; }
  }
</style>
