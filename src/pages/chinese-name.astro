---
import Base from '../layouts/Base.astro';
import ChineseNameGenerator from '../components/ChineseNameGenerator.astro';
import PaymentModal from '../components/PaymentModal.astro';
import ToolSeoContent from '../components/ToolSeoContent.astro';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from '../lib/brand';
import { productJsonLd } from '../lib/product-schema';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${SITE_URL}/chinese-name.html#application`,
    name: `${BRAND_NAME} Chinese Given Name Generator`,
    url: `${SITE_URL}/chinese-name.html`,
    description: 'Generate three meaningful Chinese given names inspired by BaZi, birth season, classical poetry, and Chinese botanical tradition.',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'All',
    provider: { '@id': ORGANIZATION_ID },
    isPartOf: { '@id': WEBSITE_ID },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  },
  productJsonLd('namingVerdict'),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How can a birthday inspire a Chinese name?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A birth date provides a season, solar-term context, and three or four BaZi pillars. Those details can narrow poetic and natural imagery for a Chinese given name without claiming that one name is destined or guaranteed to change a life path.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do I need my birth time to generate a Chinese name?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Birth time adds the Hour Pillar, but a date alone still provides birth season and broader elemental imagery. The generator allows an unknown birth time instead of asking users to guess.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does the generator create a Chinese surname?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Chinese surnames normally represent inherited family lineage. The generator creates a given name and does not assign a random family identity.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are all generated names direct quotations from Chinese poetry?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Results distinguish direct quotations, phrase-based selections, seasonal inspiration, and botanical imagery. Each name should explain its source rather than presenting an adaptation as an ancient quotation.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I choose a Chinese name?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Choose a name whose characters have a meaning you can explain, whose pronunciation feels comfortable, and whose source is honestly described. You can use this generator for culturally informed options, then ask a fluent speaker to check tone, associations, and everyday usage.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I get a Chinese name based on my birthday?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Entering a birthday lets the generator consider season, solar-term context, and available BaZi pillars when choosing imagery. The result is a cultural naming suggestion, not a claim that a date scientifically determines one correct name.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do Chinese names need to match the five elements?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Traditional naming sometimes considers the Five Elements, especially when a family wants a character associated with a perceived gap or balance. It is a cultural preference rather than a requirement, and this tool makes a birth-based option available without presenting it as scientific judgment.',
        },
      },
    ],
  },
];
---

<Base
  title="Chinese Name Generator by Birthday & Poetry | MyBaziDestiny"
  description="Find a meaningful Chinese given name inspired by your BaZi, birth season, classical poetry, and traditional botanical imagery."
  keywords="Chinese name generator, Chinese given name, Chinese name with meaning, BaZi name, Chinese poetry names"
  path="/chinese-name.html"
  jsonLd={jsonLd}
>
  <div class="name-page wrap">
    <ChineseNameGenerator />
  </div>
  <PaymentModal />

  <ToolSeoContent
    eyebrow="Meaning before translation"
    title="A Chinese name shaped by language and cultural context"
    summary="This generator does not simply transliterate an English name. It creates three Chinese given-name directions using birth season, BaZi-inspired imagery, classical literature, and a curated botanical source."
    headingId="chinese-name-generator-explained"
  >
    <div class="tool-seo-grid">
      <section>
        <h3>Birthday and season</h3>
        <p>Your date of birth identifies a season and traditional solar-term context. These provide coherent images such as spring growth, autumn clarity, winter stillness, or summer light.</p>
      </section>
      <section>
        <h3>Classical poetry</h3>
        <p>Poetic names are checked against the original line and modern usage. We distinguish exact quotations from names that are only inspired by an image or phrase.</p>
      </section>
      <section>
        <h3>Natural pronunciation</h3>
        <p>A meaningful character pair must also sound like a plausible person. Results include pinyin, an English pronunciation guide, meaning, source, and a modern usage impression.</p>
      </section>
      <section>
        <h3>A given name, not a surname</h3>
        <p>Chinese surnames carry lineage and are generally inherited. Assigning a random surname can imply a family identity the user does not have, so the tool creates given names only.</p>
      </section>
    </div>

    <section>
      <h3>How BaZi and the five elements shape a name</h3>
      <p>The generator starts with the birth season and traditional solar-term context, then looks at the broad Five Elements pattern suggested by the available BaZi pillars. Spring may invite images of growth and fresh branches, while autumn can suggest clarity, harvest, or quiet strength; these are poetic associations rather than fixed personality labels.</p>
      <p>When a birth time is available, the Hour Pillar adds another layer to the traditional chart. When it is unknown, the tool keeps that uncertainty visible instead of inventing precision. Candidate characters are then drawn from a curated cultural vocabulary that includes classical poetry, natural imagery, and Chinese botanical references.</p>
      <p>Each result explains its characters, pinyin, source type, and modern usage impression so you can judge the fit yourself. A name can echo an element without literally containing a character for wood, fire, earth, metal, or water. The aim is a balanced story that sounds like a plausible given name, not a coded prescription.</p>
      <p>In BaZi terminology, the Five Elements describe relationships and tendencies within a chart rather than five substances inside a person. A naming tradition may favor an image that symbolically supports a perceived weakness, but different schools calculate that balance in different ways. The generator keeps the language modest and shows the seasonal reasoning instead of claiming that one character will “fix” a chart.</p>
      <p>Character choice also depends on tone, stroke shape, and cultural associations. A beautiful meaning can feel awkward if the tones clash with a family name, if the character is too rare to read, or if it carries an unintended historical reference. That is why the explanations include pronunciation and usage notes alongside the traditional inspiration.</p>
      <p>Use these suggestions as a creative starting point: confirm pronunciation with a fluent speaker, check regional associations, and consider how the name will work in the places where you live and study. Naming is a cultural choice and a personal act of meaning, not a scientific determination of identity or fate.</p>
    </section>

    <section>
      <h3>Why this is not a random name generator</h3>
      <p>A random generator can join attractive characters without knowing whether their tones, meanings, or source claims sit well together. This tool begins with the birthday you provide, uses seasonal and BaZi-inspired context to narrow the field, and keeps the surname separate from the given name.</p>
      <p>It also connects each suggestion to a cultural source or image category. A direct line from poetry is labeled as such, while an adaptation or seasonal inspiration is described honestly. That distinction matters when a name will be introduced to Chinese-speaking friends, colleagues, or family.</p>
      <p>The final choice remains yours. Read the explanation aloud, test the pinyin in conversation, and ask for human feedback before adopting a name publicly. The tool offers thoughtful options and context; it does not decide who you are or guarantee a particular social response.</p>
      <p>Randomness still has a place in creative work, but it should happen after meaning and language have been checked. Here, the birthday sets a starting context, the source library supplies culturally legible images, and the explanation lets you reject a suggestion that does not sound like you. You can regenerate, compare the three directions, or keep only one character and pair it with advice from a native speaker.</p>
      <p>This approach is especially useful for learners choosing a courtesy name, an online name, or a first Chinese given name. It respects the difference between translation and naming: a name is meant to be spoken by other people, written repeatedly, and carried through ordinary introductions. Cultural context makes that everyday test part of the process rather than an afterthought.</p>
      <p>Before settling on a result, write the characters by hand and search how they appear in contemporary names. Check whether the pinyin is easy for the people around you to say, and ask what the pair evokes in the region or community where you will use it. A thoughtful second opinion is part of good naming practice, not a failure of the generator.</p>
      <p>You can also keep the name provisional. Try it in a class, game, profile, or language exchange, notice how it feels, and revise it as your relationship with Chinese language and culture grows. The tool gives you a reasoned shortlist; lived use supplies the final context.</p>
      <p>A good final check is simple: can you explain the meaning without overclaiming its source, and can another person say it after hearing it once? If yes, the name has passed both the cultural and everyday tests.</p>
    </section>

    <div class="tool-seo-links">
      <p><strong>Explore the naming method:</strong> read <a href="/chinese-name-based-on-birthday.html">Chinese Names Based on Your Birthday</a>, browse <a href="/chinese-names-from-poetry.html">names from the Shi Jing and Chu Ci</a>, or <a href="/calculator.html">calculate your full BaZi chart</a> first.</p>
    </div>

    <section class="tool-faq" aria-labelledby="name-faq-title">
      <h3 id="name-faq-title">Chinese name generator questions</h3>
      <details>
        <summary>How can a birthday inspire a Chinese name?</summary>
        <p>A birth date provides a season, solar-term context, and three or four BaZi pillars. Those details can narrow poetic and natural imagery for a Chinese given name without claiming that one name is destined or guaranteed to change a life path.</p>
      </details>
      <details>
        <summary>Do I need my birth time to generate a Chinese name?</summary>
        <p>No. Birth time adds the Hour Pillar, but a date alone still provides birth season and broader elemental imagery. The generator allows an unknown birth time instead of asking users to guess.</p>
      </details>
      <details>
        <summary>Does the generator create a Chinese surname?</summary>
        <p>No. Chinese surnames normally represent inherited family lineage. The generator creates a given name and does not assign a random family identity.</p>
      </details>
      <details>
        <summary>Are all generated names direct quotations from Chinese poetry?</summary>
        <p>No. Results distinguish direct quotations, phrase-based selections, seasonal inspiration, and botanical imagery. Each name should explain its source rather than presenting an adaptation as an ancient quotation.</p>
      </details>
      <details>
        <summary>How do I choose a Chinese name?</summary>
        <p>Choose a name whose characters have a meaning you can explain, whose pronunciation feels comfortable, and whose source is honestly described. You can use this generator for culturally informed options, then ask a fluent speaker to check tone, associations, and everyday usage.</p>
      </details>
      <details>
        <summary>Can I get a Chinese name based on my birthday?</summary>
        <p>Yes. Entering a birthday lets the generator consider season, solar-term context, and available BaZi pillars when choosing imagery. The result is a cultural naming suggestion, not a claim that a date scientifically determines one correct name.</p>
      </details>
      <details>
        <summary>Do Chinese names need to match the five elements?</summary>
        <p>Traditional naming sometimes considers the Five Elements, especially when a family wants a character associated with a perceived gap or balance. It is a cultural preference rather than a requirement, and this tool makes a birth-based option available without presenting it as scientific judgment.</p>
      </details>
    </section>
  </ToolSeoContent>
</Base>

<style>
  .name-page { padding-top: calc(68px + clamp(2rem, 5vh, 3.5rem)); }
</style>
