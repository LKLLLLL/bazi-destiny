---
import Base from '../layouts/Base.astro';
import LoveMatch from '../components/LoveMatch.astro';
import ToolSeoContent from '../components/ToolSeoContent.astro';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from '../lib/brand';
import { productJsonLd } from '../lib/product-schema';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${SITE_URL}/love-match.html#application`,
    name: `${BRAND_NAME} BaZi Love Match`,
    url: `${SITE_URL}/love-match.html`,
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    provider: { '@id': ORGANIZATION_ID },
    isPartOf: { '@id': WEBSITE_ID },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    description:
      'Free BaZi love compatibility calculator. Compare two birth charts for elemental harmony, day pillar bond, and relationship guidance.',
  },
  productJsonLd('synergyBoostGuide'),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What does a BaZi compatibility calculator compare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'This calculator compares two Day Pillars, Day Master polarity, and Five Elements relationships. The score is a transparent summary of those selected traditional factors, not a prediction that a relationship will succeed or fail.',
        },
      },
      {
        '@type': 'Question',
        name: 'How is the BaZi compatibility score calculated?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The score weights Day Pillar interaction at 40%, Day Master stem and polarity interaction at 30%, and Five Elements interaction at 30%.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is BaZi compatibility the same as Chinese zodiac compatibility?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Zodiac compatibility usually compares only the birth-year animals. BaZi compatibility can compare the Day Pillars, Heavenly Stems, Earthly Branches, and element relationships across two complete charts.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can BaZi compatibility predict whether a couple will stay together?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. BaZi is a traditional interpretive framework and cannot establish whether a relationship will succeed. Communication, safety, shared values, and real behavior matter more than a symbolic score.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which Chinese zodiac signs are most compatible?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Traditional zodiac lists often highlight the Six Harmony pairs and Three Harmony groups, such as Rat with Ox or Rat with Dragon and Monkey. These are broad year-animal associations; a complete BaZi comparison uses both people\'s full birth charts.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does a low BaZi compatibility score mean?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A low score means the selected traditional factors show more tension or fewer supportive links in this symbolic model. It does not label either person or predict a breakup; use the result as a prompt to discuss expectations, boundaries, and communication.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do zodiac animals matter in a relationship?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'They can matter as a cultural lens if both people enjoy the tradition, but opinions vary and year animals are only one small layer. Communication, respect, safety, shared values, and day-to-day behavior are more important in a real relationship.',
        },
      },
    ],
  },
];
---

<Base
  title="BaZi Love Compatibility Calculator | MyBaziDestiny"
  description="Compare two BaZi birth charts for Five Elements harmony, Day Pillar connections, relationship strengths, and potential challenges. Free and instant."
  keywords="bazi love match, chinese zodiac compatibility, bazi compatibility, love calculator, four pillars compatibility, 八字合婚"
  path="/love-match.html"
  altPath="/zh/love-match.html"
  jsonLd={jsonLd}
>
  <header class="lm-hero">
    <div class="wrap-narrow center">
      <p class="eyebrow center"><span class="han">合婚</span> Love Match</p>
      <h1>BaZi love compatibility: <em>how do your charts interact?</em></h1>
      <p class="lm-lead">
        In classical China, families compared the couple's Eight Characters before a wedding — 合婚.
        Enter both birthdays and let the Five Elements tell the story of the two of you.
      </p>
    </div>
  </header>

  <div class="wrap-narrow lm-tool">
    <LoveMatch />
  </div>

  <ToolSeoContent
    eyebrow="Two charts, one comparison"
    title="How this BaZi compatibility score is built"
    summary="The calculator compares selected traditional chart relationships and explains the result. It is designed for cultural exploration and conversation, not to decide whether a relationship should begin or end."
    headingId="bazi-compatibility-explained"
  >
    <div class="tool-seo-grid">
      <section>
        <h3>Day Pillar interaction: 40%</h3>
        <p>The Day Pillar is traditionally associated with the self and close relationships. Its stem and branch pairing receives the largest share of this calculator's score.</p>
      </section>
      <section>
        <h3>Day Master and polarity: 30%</h3>
        <p>The two Day Master stems are compared by element and Yin-Yang polarity. This describes a symbolic interaction pattern, not a fixed personality diagnosis.</p>
      </section>
      <section>
        <h3>Five Elements relationship: 30%</h3>
        <p>The calculator checks whether the Day Master elements generate, control, match, or remain neutral toward one another within the traditional Five Elements cycles.</p>
      </section>
      <section>
        <h3>More than zodiac animals</h3>
        <p>Year-animal compatibility uses one part of each chart. BaZi comparison adds the Day Pillars and elemental relationships, which makes it more specific than a zodiac-only match.</p>
      </section>
    </div>

    <section>
      <h3>The Six Harmony and Three Harmony groups</h3>
      <p>Traditional zodiac reading describes <strong>六合 (Six Harmony)</strong> pairs as complementary companions: Rat and Ox are linked with practical support; Tiger and Pig with generous courage; Rabbit and Dog with loyalty and care; Dragon and Rooster with shared ambition and polish; Snake and Monkey with strategy and quick thinking; Horse and Goat with warmth and creative ease.</p>
      <p>The <strong>三合 (Three Harmony)</strong> groups form wider circles: Monkey, Rat, and Dragon are often associated with initiative and resourcefulness; Snake, Rooster, and Ox with precision and persistence; Tiger, Horse, and Dog with action and conviction; Pig, Rabbit, and Goat with empathy, beauty, and steady cooperation. These traditional phrases describe a symbolic tone, not a guarantee that every person in a sign will behave alike.</p>
      <p>In a traditional reading, a Harmony pairing is used to ask what kind of cooperation may feel natural. Rat–Ox can be discussed through reliability and practical planning, while Tiger–Pig may invite a conversation about courage balanced by generosity. Rabbit–Dog is often framed around loyalty, Dragon–Rooster around standards and visibility, Snake–Monkey around wit and adaptability, and Horse–Goat around encouragement and shared creative space.</p>
      <p>The Three Harmony circles are less about a single perfect match and more about a social rhythm. Monkey–Rat–Dragon can suggest a group that moves quickly from an idea to a plan; Snake–Rooster–Ox can emphasize craft, detail, and follow-through; Tiger–Horse–Dog can bring direct action and protective loyalty; Pig–Rabbit–Goat can value tenderness, beauty, and mutual care. Real people still vary widely within every sign.</p>
      <p>These groupings cover only the zodiac dimension. For a complete compatibility reading, use this page to compare two complete BaZi charts, including both Day Pillars and their Five Elements relationships.</p>
    </section>

    <section>
      <h3>What a high score does and does not mean</h3>
      <p>A high score is a symbolic summary of the selected Day Pillar, Day Master, and Five Elements interactions. It can help two people notice a shared vocabulary for strengths, friction, and curiosity, but it cannot measure kindness, readiness, attraction, or the quality of daily repair after conflict.</p>
      <p>A lower score is not a verdict, either. It may point to different rhythms or communication habits worth naming early, while a high score can still coexist with poor boundaries or incompatible plans. Treat the number as one conversation starter among many, and give more weight to consent, safety, honest communication, and observable behavior.</p>
      <p>The score also leaves out important context: family expectations, financial pressure, distance, health, culture, and the reasons two people choose one another. A result can be useful when it turns into a specific question, such as “How do we handle different pacing?” or “Where do we need clearer boundaries?” It is less useful when it is treated as permission to ignore what a partner actually says and does.</p>
      <p>For a grounded conversation, read the three weighted components separately before looking at the total. Notice which interaction feels supportive, which feels tense, and whether that description matches your lived experience. If it does not, trust the observed relationship and use the traditional language only as a prompt for curiosity. BaZi symbolism can add context to a discussion; it cannot replace consent, accountability, or professional support.</p>
      <p>It can help to compare the result with the circumstances that brought you to the calculator. Are you celebrating a new connection, preparing for a family conversation, or trying to understand a recurring disagreement? Write down the practical question first, then see whether the chart language gives you a respectful way to ask it. This keeps the tool in its proper role: a structured reflection that supports communication.</p>
      <p>Remember that compatibility is not the same as similarity. Two people with different elemental patterns may offer useful perspective and learn to coordinate, while two people with a seemingly harmonious pairing may still avoid difficult conversations. A healthy relationship is built through repeated choices, repair, and shared responsibility. The traditional score can describe a theme, but only the people involved can decide what they do with it.</p>
      <p>For that reason, do not use a low number to pressure someone into staying, and do not use a high number to dismiss a clear warning sign. If a relationship involves fear, coercion, or harm, seek trusted human support rather than a symbolic reading. Cultural tools are most responsible when they leave room for agency, evidence, and the lived experience of both partners.</p>
      <p>You may also compare the same pair at different levels: begin with the year animals for a familiar cultural overview, then move to the Day Pillars and elements for a more detailed discussion. If the two layers seem to disagree, that is not an error to hide. It is a reminder that a person is larger than a birth-year label and that traditional systems contain several interpretive lenses.</p>
    </section>

    <div class="tool-seo-links">
      <p><strong>Understand the inputs:</strong> calculate each person's <a href="/calculator.html">Four Pillars chart</a>, read the <a href="/bazi-day-master-guide.html">Day Master guide</a>, or review <a href="/love-compatibility.html">how BaZi compatibility differs from zodiac matching</a>.</p>
    </div>

    <section class="tool-faq" aria-labelledby="match-faq-title">
      <h3 id="match-faq-title">BaZi compatibility questions</h3>
      <details>
        <summary>What does a BaZi compatibility calculator compare?</summary>
        <p>This calculator compares two Day Pillars, Day Master polarity, and Five Elements relationships. The score is a transparent summary of those selected traditional factors, not a prediction that a relationship will succeed or fail.</p>
      </details>
      <details>
        <summary>How is the BaZi compatibility score calculated?</summary>
        <p>The score weights Day Pillar interaction at 40%, Day Master stem and polarity interaction at 30%, and Five Elements interaction at 30%.</p>
      </details>
      <details>
        <summary>Is BaZi compatibility the same as Chinese zodiac compatibility?</summary>
        <p>No. Zodiac compatibility usually compares only the birth-year animals. BaZi compatibility can compare the Day Pillars, Heavenly Stems, Earthly Branches, and element relationships across two complete charts.</p>
      </details>
      <details>
        <summary>Can BaZi compatibility predict whether a couple will stay together?</summary>
        <p>No. BaZi is a traditional interpretive framework and cannot establish whether a relationship will succeed. Communication, safety, shared values, and real behavior matter more than a symbolic score.</p>
      </details>
      <details>
        <summary>Which Chinese zodiac signs are most compatible?</summary>
        <p>Traditional zodiac lists often highlight the Six Harmony pairs and Three Harmony groups, such as Rat with Ox or Rat with Dragon and Monkey. These are broad year-animal associations; a complete BaZi comparison uses both people's full birth charts.</p>
      </details>
      <details>
        <summary>What does a low BaZi compatibility score mean?</summary>
        <p>A low score means the selected traditional factors show more tension or fewer supportive links in this symbolic model. It does not label either person or predict a breakup; use the result as a prompt to discuss expectations, boundaries, and communication.</p>
      </details>
      <details>
        <summary>Do zodiac animals matter in a relationship?</summary>
        <p>They can matter as a cultural lens if both people enjoy the tradition, but opinions vary and year animals are only one small layer. Communication, respect, safety, shared values, and day-to-day behavior are more important in a real relationship.</p>
      </details>
    </section>
  </ToolSeoContent>
</Base>

<style>
  .lm-hero {
    padding: calc(68px + clamp(2.5rem, 6vh, 4.5rem)) 0 clamp(1.6rem, 3vh, 2.4rem);
    text-align: center;
  }
  .lm-hero h1 { font-size: clamp(2.1rem, 4.6vw, 3.3rem); }
  .lm-hero h1 em { font-style: italic; color: var(--cinnabar); }
  .lm-lead { margin-top: 1.1rem; color: var(--bone-dim); max-width: 54ch; margin-inline: auto; }
  .center { text-align: center; }
  .lm-tool { margin-top: 1rem; }
</style>
