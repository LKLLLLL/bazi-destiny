---
import Base from '../layouts/Base.astro';
---

<Base
  title="Synergy Boost Guide | BaZi Destiny"
  description="Your personalized relationship alignment guide — communication, shared activities, home energy, and conflict resolution."
  path="/synergy-guide.html"
  noindex={true}
>
  <div class="sg-wrap" id="sgWrap" hidden>
    <header class="sg-hero">
      <p class="eyebrow center"><span class="han"></span> Synergy Boost</p>
      <h1 id="sgTitle">Your Synergy Guide</h1>
      <p class="sg-sub" id="sgSub">Loading your personalized alignment plan…</p>
    </header>

    <div class="sg-intro panel" id="sgIntro">
      <div class="sg-intro-badge" id="sgBadge"></div>
      <p class="sg-intro-text" id="sgIntroText"></p>
    </div>

    <div class="sg-cards" id="sgCards"></div>

    <div class="sg-footer">
      <a href="/love-match.html" class="btn btn-ghost">← Back to Love Match</a>
      <button class="btn btn-gold" onclick="window.print()">Download PDF</button>
    </div>
  </div>

  <div class="sg-wrap" id="sgLocked">
    <div class="panel sg-locked">
      <div class="sg-locked-icon" aria-hidden="true">🔒</div>
      <h1 id="sgLockedTitle">Checking your purchase</h1>
      <p id="sgLockedText">Confirming access to your Synergy Boost Guide…</p>
      <a href="/love-match.html" class="btn btn-love btn-lg" id="sgLockedAction" hidden>Try Love Match — Free</a>
    </div>
  </div>
</Base>

<style>
  .sg-wrap { padding: calc(68px + 2rem) 1.25rem 4rem; max-width: 680px; margin: 0 auto; }
  .sg-wrap[hidden] { display: none; }
  .sg-hero { text-align: center; margin-bottom: 3rem; }
  .sg-hero h1 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; line-height: 1.2; margin-top: 0.4rem; }
  .sg-sub { color: var(--bone-dim); font-size: 0.95rem; margin-top: 0.6rem; max-width: 44ch; margin-inline: auto; line-height: 1.6; }
  .sg-intro { text-align: center; padding: 2rem 1.8rem; margin-bottom: 2.5rem; background: linear-gradient(160deg, rgba(212,175,106,0.06), transparent 70%), var(--ink-1); border: 1px solid var(--line); }
  .sg-intro-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; color: var(--gold-bright); padding: 0.5rem 1.2rem; border: 1px solid rgba(212,175,106,0.3); border-radius: 999px; margin-bottom: 1.2rem; background: rgba(212,175,106,0.06); }
  .sg-intro-text { color: var(--bone-dim); font-size: 0.95rem; line-height: 1.8; max-width: 52ch; margin: 0 auto; }
  .sg-footer { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; padding-top: 1.8rem; border-top: 1px solid var(--line-soft); }
  .sg-locked { text-align: center; padding: clamp(2.4rem, 6vw, 3.4rem) 2rem; margin-top: calc(68px + 2rem); }
  .sg-locked-icon { font-size: 2.4rem; margin-bottom: 1rem; }
  .sg-locked h1 { font-size: 1.6rem; margin-bottom: 0.7rem; }
  .sg-locked p { color: var(--bone-dim); font-size: 0.92rem; max-width: 42ch; margin: 0 auto 1.6rem; }
</style>

<script>
  import { clearPendingCheckout, getPaymentStatus, readPendingCheckout } from '../lib/paypal';
  import { getSynergyGuide, isEnglishElement } from '../lib/bazi/synergy';

  const params = new URLSearchParams(window.location.search);
  const completedCheckout = params.get('checkout') === 'complete';
  const pending = completedCheckout ? readPendingCheckout('synergy') as any : null;
  const name1 = pending?.n1 || params.get('n1') || 'Person 1';
  const name2 = pending?.n2 || params.get('n2') || 'Person 2';
  const element1 = pending?.e1 || params.get('e1') || 'Wood';
  const element2 = pending?.e2 || params.get('e2') || 'Fire';
  const wrap = document.getElementById('sgWrap');
  const locked = document.getElementById('sgLocked');
  const lockedTitle = document.getElementById('sgLockedTitle');
  const lockedText = document.getElementById('sgLockedText');
  const lockedAction = document.getElementById('sgLockedAction') as HTMLAnchorElement | null;

  async function loadGuide() {
    const status = await getPaymentStatus(true);
    if (!status.synergy) {
      if (lockedTitle) lockedTitle.textContent = 'This guide is locked';
      if (lockedText) lockedText.textContent = 'Run a free match first, then unlock the Synergy Boost Guide from your result page.';
      if (lockedAction) lockedAction.hidden = false;
      return;
    }

    if (!isEnglishElement(element1) || !isEnglishElement(element2)) {
      if (lockedTitle) lockedTitle.textContent = 'Guide unavailable';
      if (lockedText) lockedText.textContent = 'The saved match data is invalid. Please run the match again.';
      if (lockedAction) { lockedAction.hidden = false; lockedAction.textContent = 'Back to Love Match'; }
      return;
    }

    const guide = getSynergyGuide(element1, element2, name1, name2);
    document.getElementById('sgTitle')!.textContent = guide.title;
    document.getElementById('sgSub')!.textContent = guide.subtitle;
    document.getElementById('sgBadge')!.textContent = guide.badge;
    document.getElementById('sgIntroText')!.textContent = guide.intro;
    document.getElementById('sgCards')!.innerHTML = guide.cards.map((card: any) =>
      `<div class="sg-card"><div class="sg-card-header"><div class="sg-card-title">${card.title}</div></div><div class="sg-card-body">${card.bodyHtml}</div></div>`
    ).join('');
    document.title = `${guide.title} — Synergy Guide | BaZi Destiny`;
    if (completedCheckout) {
      clearPendingCheckout();
      const clean = new URLSearchParams({ n1: name1, n2: name2, e1: element1, e2: element2 });
      window.history.replaceState({}, document.title, `${window.location.pathname}?${clean}`);
    }
    if (locked) locked.hidden = true;
    if (wrap) wrap.hidden = false;
  }

  void loadGuide();
</script>
