---
import Base from '../layouts/Base.astro';
import StepCalculator from '../components/StepCalculator.astro';
import PaymentModal from '../components/PaymentModal.astro';
import ToolSeoContent from '../components/ToolSeoContent.astro';
import ExpertCredential from '../components/ExpertCredential.astro';
import { BRAND_NAME, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from '../lib/brand';
import { YE_QINGCHUN_ID, yeQingchunPersonJsonLd } from '../lib/expert';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${SITE_URL}/calculator.html#application`,
    name: `${BRAND_NAME} Free BaZi and Four Pillars of Destiny Calculator`,
    url: `${SITE_URL}/calculator.html`,
    description:
      'Free BaZi calculator and analysis tool for a Four Pillars chart, Day Master, Five Elements balance, and introductory reading.',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'All',
    inLanguage: 'en',
    browserRequirements: 'Requires JavaScript. No account or sign-up is required.',
    featureList: [
      'Four Pillars chart',
      'Day Master identification',
      'Five Elements balance',
      'Optional true solar time correction',
      'Introductory BaZi analysis',
    ],
    provider: { '@id': ORGANIZATION_ID },
    isPartOf: { '@id': WEBSITE_ID },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/OnlineOnly', url: `${SITE_URL}/calculator.html` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a BaZi calculator?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A BaZi calculator converts a birth date and time into the Four Pillars of Destiny: the Year, Month, Day, and Hour pillars. Each pillar contains a Heavenly Stem and an Earthly Branch, producing the eight characters known as BaZi.',
        },
      },
      {
        '@type': 'Question',
        name: 'What information do I need to calculate my BaZi chart?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A birth date is required. Birth time determines the Hour Pillar, while birthplace can be used for optional true solar time correction. If the time or city is unknown, the chart should be read with those limitations in mind.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does this BaZi calculator use true solar time?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. True solar time correction is optional and applies when a listed city with longitude data is selected. If a birthplace is not in the quick list, you can still use its name and continue with the local clock time entered.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is a BaZi calculator scientifically proven?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. BaZi is a traditional Chinese metaphysical and calendrical system, not a scientifically validated method for predicting life outcomes. The chart calculation can be reproduced, while interpretations remain cultural and symbolic.',
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE_URL}/calculator.html#webpage`,
    name: 'Free BaZi and Four Pillars of Destiny Calculator',
    url: `${SITE_URL}/calculator.html`,
    description: 'Calculate a Four Pillars chart and receive a free introductory BaZi analysis in the browser.',
    dateModified: '2026-09-12',
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': ORGANIZATION_ID },
    reviewedBy: { '@id': YE_QINGCHUN_ID },
    mainEntity: { '@id': `${SITE_URL}/calculator.html#application` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Free BaZi Calculator', item: `${SITE_URL}/calculator.html` },
    ],
  },
  yeQingchunPersonJsonLd,
];
---

<Base
  title="Free BaZi Calculator & Four Pillars Analysis"
  description="Use this free BaZi and Four Pillars of Destiny calculator to find your Day Master, Five Elements balance, and instant analysis. Private and no sign-up."
  keywords="free BaZi calculator, BaZi calculator and analysis, Four Pillars calculator, free BaZi reading, Chinese astrology chart"
  path="/calculator.html"
  altPath="/zh/calculator.html"
  ogType="website"
  jsonLd={jsonLd}
>
  <header class="calc-hero wrap-narrow">
    <p class="eyebrow"><span class="han">八字</span> Free Four Pillars Calculator</p>
    <h1>Free BaZi & Four Pillars of Destiny Calculator</h1>
    <p class="calc-intro">
      Enter your birth date and time to calculate your Four Pillars, Day Master, Five Elements balance, and an instant introductory reading. True solar time is optional, and no sign-up is required.
    </p>
    <ul class="calc-benefits" aria-label="Free calculator facts">
      <li><strong>Free</strong><span>Chart and introductory analysis</span></li>
      <li><strong>Private</strong><span>Birth data stays in your browser</span></li>
      <li><strong>Verifiable</strong><span>Method and test cases are published</span></li>
    </ul>
  </header>
  <div class="calc-page-wrap">
    <StepCalculator />
  </div>
  <PaymentModal />

  <ToolSeoContent
    eyebrow="What the free analysis includes"
    title="From birth details to your Four Pillars"
    summary="This free BaZi calculator converts your birth details into four stem-branch pairs, then explains the Day Master and Five Elements behind your chart."
    headingId="bazi-calculator-explained"
  >
    <div class="tool-seo-grid">
      <section>
        <h3>The Four Pillars</h3>
        <p>The Year, Month, Day, and Hour pillars each contain one Heavenly Stem and one Earthly Branch. Together they form the eight characters written as 八字, or BaZi.</p>
      </section>
      <section>
        <h3>Your Day Master</h3>
        <p>The Heavenly Stem of the Day Pillar is called the Day Master. It is the reference point used to discuss the other elements and relationships in a traditional chart.</p>
      </section>
      <section>
        <h3>Five Elements balance</h3>
        <p>The chart associates stems and branches with Wood, Fire, Earth, Metal, and Water. A simple element count is useful context, but it is not the same as a complete favorable-element analysis.</p>
      </section>
      <section>
        <h3>Optional true solar time</h3>
        <p>Clock time follows civil time zones. When a listed city is selected and correction is enabled, the calculator uses its longitude to estimate local solar time. An unlisted city can still be used with the local clock time entered, without longitude correction.</p>
      </section>
    </div>

    <div class="tool-seo-links">
      <p><strong>Verify the method:</strong> review the <a href="/methodology.html">calculation rules and limitations</a>, reproduce the <a href="/test-cases.html">public boundary test cases</a>, or use the <a href="/how-to-choose-bazi-calculator.html">eight-point BaZi calculator checklist</a>. Then learn about the <a href="/bazi-day-master-guide.html">Day Master</a>, <a href="/bazi-ten-gods.html">Ten Gods</a>, and <a href="/bazi-luck-pillars.html">Luck Pillars</a>.</p>
    </div>

    <ExpertCredential variant="card" />

    <section class="tool-faq" aria-labelledby="calculator-faq-title">
      <h3 id="calculator-faq-title">BaZi calculator questions</h3>
      <details>
        <summary>What is a BaZi calculator?</summary>
        <p>A BaZi calculator converts a birth date and time into the Four Pillars of Destiny: the Year, Month, Day, and Hour pillars. Each pillar contains a Heavenly Stem and an Earthly Branch, producing the eight characters known as BaZi.</p>
      </details>
      <details>
        <summary>What information do I need to calculate my BaZi chart?</summary>
        <p>A birth date is required. Birth time determines the Hour Pillar, while birthplace can be used for optional true solar time correction. If the time or city is unknown, the chart should be read with those limitations in mind.</p>
      </details>
      <details>
        <summary>Does this BaZi calculator use true solar time?</summary>
        <p>Yes. True solar time correction is optional and applies when a listed city with longitude data is selected. If a birthplace is not in the quick list, you can still use its name and continue with the local clock time entered.</p>
      </details>
      <details>
        <summary>Is a BaZi calculator scientifically proven?</summary>
        <p>No. BaZi is a traditional Chinese metaphysical and calendrical system, not a scientifically validated method for predicting life outcomes. The chart calculation can be reproduced, while interpretations remain cultural and symbolic.</p>
      </details>
    </section>
  </ToolSeoContent>
</Base>

<style>
  .calc-hero {
    padding-top: calc(68px + clamp(2.5rem, 6vh, 4.5rem));
    text-align: center;
  }
  .calc-hero .eyebrow { justify-content: center; }
  .calc-hero h1 { margin-top: 0.9rem; font-size: clamp(2.35rem, 5vw, 3.8rem); }
  .calc-intro { max-width: 720px; margin: 1rem auto 0; color: var(--bone-dim); line-height: 1.8; }
  .calc-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 720px;
    margin: 1.35rem auto 0;
    padding: 0;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background: rgba(212, 175, 106, 0.035);
    list-style: none;
  }
  .calc-benefits li { display: grid; gap: 0.2rem; padding: 0.9rem 1rem; }
  .calc-benefits li + li { border-left: 1px solid var(--line-soft); }
  .calc-benefits strong { color: var(--gold-bright); font-size: 0.78rem; letter-spacing: 0.04em; }
  .calc-benefits span { color: var(--bone-faint); font-size: 0.72rem; }
  .calc-page-wrap {
    padding-top: clamp(1.8rem, 4vh, 3rem);
  }
  @media (max-width: 560px) {
    .calc-benefits { grid-template-columns: 1fr; }
    .calc-benefits li + li { border-top: 1px solid var(--line-soft); border-left: 0; }
  }
</style>
