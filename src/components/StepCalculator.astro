          <small>${isZh ? '第' : 'Chapter '}${String(section.number).padStart(2, '0')}${isZh ? '章' : ''}</small>
          <strong>${escapeHtml(section.title)}</strong>
        </span>
      </a>
    `).join('');

    $('ccProGrid')!.innerHTML = sections.map((section) => `
      <article class="cc-ls-card" id="report-${escapeHtml(section.key)}" data-section="${section.number}">
        <div class="cc-report-title">
          <span class="cc-report-mark han">${escapeHtml(section.icon)}</span>
          <div>
            <span class="cc-report-kicker">${isZh ? `第 ${section.number} 章 · 共 12 章` : `Section ${section.number} of 12`}</span>
            <h5>${escapeHtml(section.title)}</h5>
          </div>
        </div>
        <p class="cc-report-intro">${escapeHtml(section.intro)}</p>
        <div class="cc-report-groups">
          ${section.groups.map((group) => `
            <section class="cc-report-group">
