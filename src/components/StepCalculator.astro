      { key: 'carry', icon: '🎒', title: 'What to Carry', items: guide.carry },
      { key: 'routine', icon: '⏰', title: 'Daily Routine', items: guide.routine },
      { key: 'diet', icon: '🍽️', title: 'Diet', items: guide.diet },
      { key: 'conduct', icon: '💬', title: 'Conduct & Speech', items: guide.conduct },
