---
// StepCalculator — multi-step birth data wizard
// 1. Birth Date → 2. Birth Hour → 3. Birth City
// Progress bar + clickable back + localStorage persistence + True Solar Time
import { TEMPORARY_FREE_ACCESS } from '../lib/paypal/products';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
---

<section class="step-calc-section" id="calculator" aria-label={isZh ? '八字排盘' : 'BaZi calculator'} data-step-calculator data-lang={lang}>
  <div class="wrap">
    <div class="section-head center" data-reveal>
      <p class="eyebrow center"><span class="han">排盘</span> {isZh ? '四柱命盘' : 'The Calculator'}</p>
      <h2 class="section-title">{isZh ? <>排出你的<em>四柱八字</em></> : <>Cast Your <em>Four Pillars</em></>}</h2>
      <p class="section-sub">{isZh ? '依次填写出生信息，即刻生成传统八字命盘。' : 'One step at a time. Your answers are saved as you go.'}</p>
    </div>

    <div class="sc-shell panel" data-reveal>
      <!-- Welcome back banner -->
      <div class="sc-welcome" id="scWelcome" hidden>
        <div class="sc-welcome-inner">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.8" stroke-linecap="round"><path d="M12 2v4m0 12v4M4.9 4.9l2.8 2.8m8.6 8.6l2.8 2.8M2 12h4m12 0h4M4.9 19.1l2.8-2.8m8.6-8.6l2.8-2.8"/></svg>
          <span>{isZh ? '已为你保留上次填写的信息' : 'Welcome back — we kept your details'}</span>
          <button class="sc-welcome-continue" id="scWelcomeContinue">{isZh ? '继续排盘 →' : 'Continue →'}</button>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="sc-progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="3">
        <div class="sc-progress-track">
          <div class="sc-progress-fill" id="scProgressFill"></div>
        </div>
        <div class="sc-progress-steps" id="scProgressSteps">
          <button class="sc-step-dot active" data-step="0" aria-label={isZh ? '第一步：出生日期' : 'Step 1: Birth Date'}>
            <span class="sc-dot-num">1</span>
            <span class="sc-dot-label">{isZh ? '日期' : 'Date'}</span>
          </button>
          <button class="sc-step-dot" data-step="1" aria-label={isZh ? '第二步：出生时辰' : 'Step 2: Birth Hour'} disabled>
            <span class="sc-dot-num">2</span>
            <span class="sc-dot-label">{isZh ? '时辰' : 'Hour'}</span>
          </button>
          <button class="sc-step-dot" data-step="2" aria-label={isZh ? '第三步：出生城市' : 'Step 3: Birth City'} disabled>
            <span class="sc-dot-num">3</span>
            <span class="sc-dot-label">{isZh ? '城市' : 'City'}</span>
          </button>
        </div>
      </div>

      <!-- ============= STEP 1: DATE ============= -->
      <div class="sc-step" id="scStep0">
        <div class="sc-step-content">
          <h3 class="sc-step-title">{isZh ? '你的出生日期是？' : 'When were you born?'}</h3>
          <p class="sc-step-sub">{isZh ? '出生年月日决定年柱、月柱与日柱，是命盘的根基。' : 'Your birth date forms the foundation of your BaZi chart.'}</p>
          <div class="sc-date-wrap">
            <span class="sc-date-label">{isZh ? '出生日期' : 'Date of Birth · 出生日期'}</span>
            <input
              class="sc-date-input"
              type="date"
              id="scDate"
              min="1900-01-01"
              max="2030-12-31"
              required
            />
          </div>
          <div class="sc-gender-row">
            <span class="sc-date-label">{isZh ? '性别' : 'Gender'}</span>
            <div class="sc-gender-options">
              <label class="sc-gender-btn">
                <input type="radio" name="scGender" value="male" />
                <span>{isZh ? '男' : 'Male'}</span>
              </label>
              <label class="sc-gender-btn">
                <input type="radio" name="scGender" value="female" />
                <span>{isZh ? '女' : 'Female'}</span>
              </label>
            </div>
          </div>
          <button class="btn btn-gold btn-lg sc-next" id="scNext0" disabled>
            {isZh ? '下一步' : 'Continue'}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="sc-hint">{isZh ? '按回车键继续' : 'Press Enter to continue'}</p>
        </div>
      </div>

      <!-- ============= STEP 2: HOUR ============= -->
      <div class="sc-step" id="scStep1" hidden>
        <div class="sc-step-content">
          <h3 class="sc-step-title">{isZh ? '你的出生时辰是？' : 'What time were you born?'}</h3>
          <p class="sc-step-sub">{isZh ? '出生时辰决定时柱，关系晚运、潜能与内在追求。' : 'Your birth time determines the Hour Pillar, the most personal part of your chart.'}</p>

          <div class="sc-hour-grid" id="scHourGrid">
            {[
              ['23', '子 Rat', '23:00–00:59'],
              ['1', '丑 Ox', '01:00–02:59'],
              ['3', '寅 Tiger', '03:00–04:59'],
              ['5', '卯 Rabbit', '05:00–06:59'],
              ['7', '辰 Dragon', '07:00–08:59'],
              ['9', '巳 Snake', '09:00–10:59'],
              ['11', '午 Horse', '11:00–12:59'],
              ['13', '未 Goat', '13:00–14:59'],
              ['15', '申 Monkey', '15:00–16:59'],
              ['17', '酉 Rooster', '17:00–18:59'],
              ['19', '戌 Dog', '19:00–20:59'],
              ['21', '亥 Pig', '21:00–22:59'],
            ].map(([val, label, range]) => (
              <button class="sc-hour-btn" type="button" data-hour={val}>
                <span class="sc-hour-num">{val}:00</span>
                <span class="sc-hour-name han">{label.split(' ')[0]}</span>
                {!isZh && <span class="sc-hour-en">{label.split(' ')[1]}</span>}
                <span class="sc-hour-range">{range}</span>
              </button>
            ))}
          </div>

          <div class="sc-options">
            <button class="sc-option-btn" id="scUnknownHour" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M9.5 9.5a3 3 0 0 1 5 2c0 3-4 3-4 3"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg>
              {isZh ? '不知道出生时辰' : "I don't know my birth time"}
            </button>

            <label class="sc-toggle">
              <input type="checkbox" id="scSolarToggle" />
              <span class="sc-toggle-track">
                <span class="sc-toggle-thumb"></span>
              </span>
              <span class="sc-toggle-label">
                {isZh ? '真太阳时校正' : 'True Solar Time correction'}
                <small>{isZh ? '按出生地经度校正时辰' : 'Account for your longitude (professional)'}</small>
              </span>
            </label>
          </div>

          <button class="btn btn-gold btn-lg sc-next" id="scNext1" disabled>
            {isZh ? '下一步' : 'Continue'}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>

      <!-- ============= STEP 3: CITY ============= -->
      <div class="sc-step" id="scStep2" hidden>
        <div class="sc-step-content">
          <h3 class="sc-step-title">{isZh ? '你的出生城市是？' : 'Where were you born?'}</h3>
          <p class="sc-step-sub">{isZh ? '出生地可用于真太阳时校正；不清楚也可以跳过。' : 'Your birthplace allows a more precise solar-time calculation. You may skip this step if unknown.'}</p>

          <div class="sc-city-search" id="scCitySearch">
            <div class="sc-city-input-wrap">
              <svg class="sc-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7.5"/><path d="M20 20l-3.5-3.5"/></svg>
              <input
                class="sc-city-input"
                type="text"
                id="scCityInput"
                placeholder={isZh ? '搜索城市，如北京、上海、广州' : 'Search city… (e.g. Beijing, London, New York)'}
                autocomplete="off"
                aria-autocomplete="list"
                aria-controls="scCityList"
                aria-expanded="false"
              />
              <button class="sc-city-clear" id="scCityClear" type="button" aria-label="Clear" hidden>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </div>
            <ul class="sc-city-list" id="scCityList" role="listbox" hidden></ul>
          </div>

          <!-- Selected city chip -->
          <div class="sc-city-selected" id="scCitySelected" hidden>
            <span class="sc-city-chip">
              <span class="sc-chip-dot"></span>
              <span class="sc-chip-name" id="scCityChipName"></span>
              <span class="sc-chip-country" id="scCityChipCountry"></span>
              <button class="sc-chip-remove" id="scCityChipRemove" aria-label="Remove city">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </span>
            <p class="sc-city-solar" id="scCitySolar" hidden></p>
          </div>

          <button class="btn btn-ghost sc-skip" id="scSkipCity" type="button">
            {isZh ? '跳过，不知道出生地' : "Skip — I don't know"}
          </button>

          <button class="btn btn-gold btn-lg sc-next" id="scNext2" disabled>
            {isZh ? '生成我的八字命盘' : 'Generate My BaZi Chart'}
            <span class="han" aria-hidden="true">生成</span>
          </button>
        </div>
      </div>

      <!-- ============= LOADING & RESULTS ============= -->
      <div class="sc-loading" id="scLoading" hidden>
        <svg class="bagua" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="46" fill="none" stroke="rgba(212,175,106,0.25)" stroke-width="1" />
          <g class="bagua-spin">
            {Array.from({ length: 8 }).map((_, i) => (
              <g transform={`rotate(${i * 45} 50 50)`}>
                <rect x="44" y="6" width="12" height="3" rx="1" fill="#d4af6a" opacity="0.9" />
                <rect x="44" y="11" width="12" height="3" rx="1" fill="#d4af6a" opacity={i % 2 ? 0.35 : 0.9} />
                <rect x="44" y="16" width="12" height="3" rx="1" fill="#d4af6a" opacity={i % 3 ? 0.9 : 0.35} />
              </g>
            ))}
          </g>
          <circle cx="50" cy="50" r="17" fill="none" stroke="#d4af6a" stroke-width="1.2" />
          <path d="M50 33a17 17 0 0 1 0 34 8.5 8.5 0 0 1 0-17 8.5 8.5 0 0 0 0-17z" fill="#d4af6a" opacity="0.85" />
          <circle cx="50" cy="41.5" r="2.6" fill="#0b0d17" />
          <circle cx="50" cy="58.5" r="2.6" fill="#d4af6a" />
        </svg>
        <ol class="sc-cast-steps">
          <li><span class="han">解码</span> {isZh ? '读取出生信息' : 'Reading birth details'}</li>
          <li><span class="han">建模</span> {isZh ? '推算四柱干支' : 'Calculating Four Pillars'}</li>
          <li><span class="han">定主</span> {isZh ? '确定日主与格局' : 'Identifying Day Master'}</li>
          <li><span class="han">生成</span> {isZh ? '生成命理解读' : 'Preparing your BaZi reading'}</li>
        </ol>
      </div>

      <div class="calc-results" id="calcResults" hidden aria-live="polite">
        <!-- ===== RESULT HEADER ===== -->
        <div class="cc-header">
          <div class="cc-badge" id="ccBadge">
            <span class="cc-badge-han han" id="ccDayMaster"></span>
            <span class="cc-badge-label">{isZh ? '日主' : 'Day Master'}</span>
          </div>
          <h3 class="cc-name" id="ccName"></h3>
          <p class="cc-subtitle" id="ccSubtitle"></p>
        </div>

        <!-- ===== FOUR PILLARS ===== -->
        <div class="cc-modules">
          <div class="cc-module-label">
            <span class="han">四柱</span> {isZh ? '八字命盘' : 'Four Pillars'}
          </div>
          <div class="pillars-grid" id="pillarsGrid"></div>
          <div class="pillar-strength" id="pillarStrength"></div>
        </div>

        <!-- ===== FIVE ELEMENTS ===== -->
        <div class="cc-section">
          <div class="cc-section-head">
            <span class="han">五行</span> {isZh ? '五行强弱' : 'Five Elements'}
          </div>
          <div class="cc-attrs">
            <div class="cc-attrs-bars" id="attrBars"></div>
            <div class="cc-attrs-summary" id="attrSummary"></div>
          </div>
        </div>

        <!-- ===== DESTINY VERDICT ===== -->
        <div class="cc-section cc-verdict-section">
          <div class="cc-section-head">
            <span class="han">命断</span> {isZh ? '格局与流年' : 'Destiny Verdict'}
          </div>
          <div id="ccVerdict"></div>
        </div>

        <!-- ===== TRAITS ===== -->
        <div class="cc-section">
          <div class="cc-section-head">
            <span class="han">天赋</span> {isZh ? '性情与优势' : 'Traits'}
          </div>
          <div class="cc-traits" id="ccTraits"></div>
        </div>

        <!-- ===== ENVIRONMENT ===== -->
        <div class="cc-section">
          <div class="cc-section-head">
            <span class="han">环境</span> {isZh ? '方位指引' : 'Environment'}
          </div>
          <div class="cc-env" id="ccEnv"></div>
        </div>

        <!-- ===== GUARDIAN SPIRIT ===== -->
        <div class="cc-section cc-guardian-section">
          <div class="cc-section-head">
            <span class="han">守护</span> {isZh ? '命局守护意象' : 'Your Guardian Spirit'}
          </div>
          <div class="cc-guardian-card">
            <span class="cc-guardian-seal han" aria-hidden="true">守</span>
            <div class="cc-guardian-copy">
              <h4><span class="han" id="guardianChinese"></span><span id="guardianName"></span></h4>
              <p class="cc-guardian-title" id="guardianTitle"></p>
              <p class="cc-guardian-background" id="guardianBackground"></p>
            </div>
          </div>
        </div>

        <!-- ===== PAYWALL ===== -->
        <div class="cc-paywall" id="ccPaywall">
          <h4>{isZh ? '完整人生蓝图' : 'Full Life Blueprint'}</h4>
          <p>{isZh ? '解锁 12 章完整命书，深入查看事业、财富、感情、健康、喜用五行、日常开运与个人风水。' : 'Unlock your complete 12-section reading, including Career, Wealth, Relationships, Health, lucky elements, daily alignment, and personalized Feng Shui.'}</p>
          <button class="btn btn-gold btn-lg" id="unlockProBtn">{isZh ? '解锁完整命书 — $9.90' : 'Unlock Full Blueprint — $9.90'}</button>
        </div>

        <!-- ===== PRO: 12-SECTION LIFE BLUEPRINT ===== -->
        <div class="cc-pro" id="ccPro" hidden>
          <header class="cc-report-cover">
            <span class="cc-cover-seal han" aria-hidden="true">命书</span>
            <div class="cc-cover-copy">
              <span class="cc-cover-kicker">{isZh ? '个人八字命书' : 'Personal BaZi Dossier · 八字命书'}</span>
              <h3>{isZh ? '完整人生蓝图' : 'Your Complete Life Blueprint'}</h3>
              <p>{isZh ? '依据四柱、日主与五行强弱生成十二章个人命理解读。' : 'Twelve personalized chapters drawn from your Four Pillars, Day Master, and Five-Element balance.'}</p>
            </div>
            {TEMPORARY_FREE_ACCESS && <span class="cc-free-badge">{isZh ? '限时免费' : 'Limited-Time Free'}</span>}
          </header>
          <div class="cc-report-meta" aria-label="Report profile">
            <div><span>{isZh ? '日主' : 'Day Master'}</span><strong id="ccReportDayMaster"></strong></div>
            <div><span>{isZh ? '命局主势' : 'Core Current'}</span><strong id="ccReportElement"></strong></div>
            <div><span>{isZh ? '调候五行' : 'Growth Element'}</span><strong id="ccReportGrowth"></strong></div>
            <div><span>{isZh ? '章节' : 'Chapters'}</span><strong>12</strong></div>
          </div>
          <nav class="cc-report-index" id="ccReportIndex" aria-label="Life Blueprint chapters"></nav>
          <div class="cc-pro-grid" id="ccProGrid"></div>
        </div>

        <div class="next-tools" aria-label="Continue exploring">
          <p><span class="han">续</span> {isZh ? '继续探索' : 'Continue exploring'}</p>
          <div class="next-tools-grid">
            {!isZh && <a href="/chinese-name.html" class="next-tool">
              <span class="han" aria-hidden="true">名</span>
              <span><strong>Find Your Chinese Name</strong><small>Turn your birth chart into a meaningful given name.</small></span>
              <b aria-hidden="true">→</b>
            </a>}
            {!isZh && <a href="/bazi-reading.html" class="next-tool">
              <span class="han" aria-hidden="true">命</span>
              <span><strong>See the Full BaZi Reading</strong><small>Compare the free chart with the optional Life Blueprint report.</small></span>
              <b aria-hidden="true">→</b>
            </a>}
            <a href={isZh ? '/zh/love-match.html' : '/love-match.html'} class="next-tool">
              <span class="han" aria-hidden="true">缘</span>
              <span><strong>{isZh ? '八字合盘' : 'Try Love Match'}</strong><small>{isZh ? '比较两个人的日柱、五行与相处模式。' : 'Compare your Five Elements with someone special.'}</small></span>
              <b aria-hidden="true">→</b>
            </a>
            <a href={isZh ? '/zh/palm-reading.html' : '/palm-reading.html'} class="next-tool">
              <span class="han" aria-hidden="true">掌</span>
              <span><strong>{isZh ? '传统手相' : 'Palm Reading'}</strong><small>{isZh ? '依照男左女右，以掌纹解读性情与运势。' : 'Explore visible palm lines through traditional Chinese palmistry.'}</small></span>
              <b aria-hidden="true">→</b>
            </a>
          </div>
        </div>

        <div class="results-actions">
          <button class="btn btn-ghost" id="shareBtn">{isZh ? '分享结果' : 'Share Result'}</button>
          <button class="btn btn-gold" id="pdfBtn">{isZh ? '打印 / 保存 PDF' : 'Print / Save as PDF'}</button>
          <button class="btn btn-ghost" id="recastBtn">{isZh ? '重新排盘' : 'Start Over'}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .step-calc-section {}
  .sc-shell {
    max-width: 680px;
    margin-inline: auto;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    overflow: hidden;
    position: relative;
    min-height: 420px;
  }

  /* Welcome back */
  .sc-welcome { margin-bottom: 1.4rem; }
  .sc-welcome[hidden] { display: none; }
  .sc-welcome-inner {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    padding: 0.9rem 1.2rem;
    border: 1px solid rgba(212, 175, 106, 0.25);
    border-radius: var(--radius);
    background: rgba(212, 175, 106, 0.06);
    color: var(--gold-bright);
    font-size: 0.88rem;
    font-weight: 500;
  }
  .sc-welcome-inner svg { flex: none; }
  .sc-welcome-continue {
    margin-left: auto;
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--gold);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  .sc-welcome-continue:hover { background: rgba(212, 175, 106, 0.12); color: var(--gold-bright); }

  /* Progress */
  .sc-progress { margin-bottom: 2rem; }
  .sc-progress-track {
    height: 3px;
    background: var(--line-soft);
    border-radius: 2px;
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .sc-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--gold-deep), var(--gold));
    border-radius: 2px;
    transition: width 0.4s var(--ease-out);
  }
  .sc-progress-steps {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
  }
  .sc-step-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--bone-faint);
    transition: color 0.3s, transform 0.3s;
    padding: 0.3rem;
  }
  .sc-step-dot[disabled] { cursor: default; opacity: 0.5; }
  .sc-step-dot.active { color: var(--gold-bright); }
  .sc-step-dot.active .sc-dot-num {
    background: var(--gold);
    color: #0f0b02;
    box-shadow: 0 0 16px rgba(212, 175, 106, 0.45);
  }
  .sc-step-dot.done { color: var(--gold); }
  .sc-step-dot.done .sc-dot-num {
    background: var(--gold-deep);
    color: #0f0b02;
  }
  .sc-dot-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--line-strong);
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.3s var(--ease-out);
  }
  .sc-dot-label {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Step */
  .sc-step { animation: scStepIn 0.4s var(--ease-out); }
  .sc-step[hidden] { display: none !important; }
  @keyframes scStepIn {
    from { opacity: 0; transform: translateY(12px); }
  }
  .sc-step-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sc-step-title { font-size: clamp(1.5rem, 3vw, 1.9rem); margin-bottom: 0.5rem; }
  .sc-step-sub { color: var(--bone-dim); font-size: 0.92rem; max-width: 42ch; margin-bottom: 1.8rem; }

  /* Step 1 — Date */
  .sc-date-wrap { position: relative; margin-bottom: 1.8rem; }
  .sc-date-input {
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    color: var(--bone);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 5vw, 2.2rem);
    padding: 1rem 1rem;
    text-align: center;
    width: 100%;
    max-width: 340px;
    box-sizing: border-box;
    color-scheme: dark;
    transition: border-color 0.3s, box-shadow 0.3s;
    -webkit-appearance: none;
  }
  .sc-date-input::-webkit-datetime-edit { padding: 0; text-align: center; }
  .sc-date-input::-webkit-datetime-edit-fields-wrapper { text-align: center; }
  .sc-date-input::-webkit-datetime-edit-text { color: var(--bone-dim); opacity: 0.6; }
  /* Show dd / mm / yyyy placeholder when empty */
  .sc-date-input:not(:valid)::-webkit-datetime-edit-year-field,
  .sc-date-input:not(:valid)::-webkit-datetime-edit-month-field,
  .sc-date-input:not(:valid)::-webkit-datetime-edit-day-field { color: var(--bone-dim); }
  .sc-date-label {
    display: block;
    font-size: 0.75rem;
    color: var(--bone-dim);
    text-align: center;
    margin-bottom: 0.4rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sc-date-input:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(212, 175, 106, 0.18);
  }
  .sc-date-input:valid { border-color: var(--gold); }

  .sc-gender-row { margin-bottom: 1.6rem; }
  .sc-gender-options {
    display: flex; gap: 0.6rem; justify-content: center; margin-top: 0.4rem;
  }
  .sc-gender-btn {
    flex: 1; max-width: 160px;
  }
  .sc-gender-btn input { position: absolute; opacity: 0; pointer-events: none; }
  .sc-gender-btn span {
    display: block; text-align: center; padding: 0.7rem 0.5rem;
    border: 1px solid var(--line-soft); border-radius: var(--radius-s);
    background: var(--ink-1); color: var(--bone-dim);
    font-size: 0.9rem; cursor: pointer; transition: all 0.2s;
  }
  .sc-gender-btn input:checked + span {
    border-color: var(--gold); background: rgba(212,175,106,0.08); color: var(--gold);
    font-weight: 600;
  }
  .sc-gender-btn span:hover { border-color: var(--line); }

  /* Step 2 — Hour */
  .sc-hour-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.55rem;
    margin-bottom: 1.6rem;
    width: 100%;
  }
  @media (max-width: 640px) {
    .sc-hour-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 420px) {
    .sc-hour-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .sc-hour-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.8rem 0.4rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-s);
    background: var(--ink-1);
    cursor: pointer;
    transition: border-color 0.25s, background 0.25s, transform 0.2s;
  }
  .sc-hour-btn:hover {
    border-color: var(--gold);
    background: rgba(212, 175, 106, 0.06);
  }
  .sc-hour-btn.selected {
    border-color: var(--gold);
    background: rgba(212, 175, 106, 0.12);
    box-shadow: 0 0 18px rgba(212, 175, 106, 0.2);
    transform: scale(1.03);
  }
  .sc-hour-num { font-size: 0.68rem; color: var(--bone-faint); }
  .sc-hour-name { font-size: 1.4rem; color: var(--gold-bright); }
  .sc-hour-en { font-size: 0.7rem; color: var(--bone-dim); font-weight: 600; }
  .sc-hour-range { font-size: 0.62rem; color: var(--bone-faint); }

  .sc-options {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    max-width: 400px;
    margin-bottom: 1.8rem;
  }
  .sc-option-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: rgba(212, 175, 106, 0.03);
    color: var(--bone-dim);
    cursor: pointer;
    font-size: 0.88rem;
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .sc-option-btn:hover { border-color: var(--gold); color: var(--bone); }
  .sc-option-btn.active {
    border-style: solid;
    border-color: var(--gold);
    background: rgba(212, 175, 106, 0.08);
    color: var(--gold-bright);
  }
  .sc-option-badge {
    margin-left: auto;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  /* Toggle switch */
  .sc-toggle {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    cursor: pointer;
    font-size: 0.88rem;
    user-select: none;
  }
  .sc-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
  .sc-toggle-track {
    position: relative;
    width: 42px;
    height: 24px;
    background: var(--ink-3);
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    flex: none;
    transition: background 0.3s, border-color 0.3s;
  }
  .sc-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    background: var(--bone-dim);
    border-radius: 50%;
    transition: transform 0.3s var(--ease-out), background 0.3s;
  }
  .sc-toggle input:checked + .sc-toggle-track {
    background: rgba(212, 175, 106, 0.2);
    border-color: var(--gold);
  }
  .sc-toggle input:checked + .sc-toggle-track .sc-toggle-thumb {
    transform: translateX(18px);
    background: var(--gold-bright);
  }
  .sc-toggle-label {
    display: flex;
    flex-direction: column;
    color: var(--bone-dim);
  }
  .sc-toggle-label small {
    font-size: 0.7rem;
    color: var(--bone-faint);
    margin-top: 0.1rem;
  }

  /* Step 3 — City */
  .sc-city-search {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin-bottom: 1rem;
  }
  .sc-city-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .sc-search-icon {
    position: absolute;
    left: 1rem;
    color: var(--bone-faint);
    pointer-events: none;
  }
  .sc-city-input {
    width: 100%;
    min-height: 52px;
    padding: 0.8rem 2.8rem 0.8rem 2.8rem;
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    color: var(--bone);
    font-size: 1rem;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .sc-city-input:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(212, 175, 106, 0.15);
  }
  .sc-city-input::placeholder { color: var(--bone-faint); }
  .sc-city-clear {
    position: absolute;
    right: 0.7rem;
    background: none;
    border: 0;
    color: var(--bone-faint);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 50%;
    transition: color 0.2s, background 0.2s;
  }
  .sc-city-clear:hover { color: var(--bone); background: var(--ink-3); }
  .sc-city-clear[hidden] { display: none; }

  .sc-city-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    max-height: 260px;
    overflow-y: auto;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 20px 48px -16px rgba(0,0,0,0.7);
    list-style: none;
    padding: 0.4rem;
    margin: 0;
    z-index: 10;
  }
  .sc-city-list[hidden] { display: none; }
  .sc-city-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-s);
    cursor: pointer;
    color: var(--bone-dim);
    font-size: 0.9rem;
    transition: background 0.15s, color 0.15s;
  }
  .sc-city-item:hover, .sc-city-item.highlight {
    background: rgba(212, 175, 106, 0.1);
    color: var(--gold-bright);
  }
  .sc-city-item-flag { font-size: 1.1rem; width: 1.4rem; text-align: center; }
  .sc-city-item-name { flex: 1; font-weight: 500; }
  .sc-city-item-country { font-size: 0.75rem; color: var(--bone-faint); }
  .sc-city-item-tz { font-size: 0.68rem; color: var(--gold-deep); background: rgba(212,175,106,0.08); padding: 0.1rem 0.45rem; border-radius: 999px; }

  /* City chip */
  .sc-city-selected { margin-bottom: 1rem; text-align: center; }
  .sc-city-selected[hidden] { display: none; }
  .sc-city-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem 0.5rem 0.9rem;
    border: 1px solid rgba(212, 175, 106, 0.35);
    border-radius: 999px;
    background: rgba(212, 175, 106, 0.08);
    font-size: 0.92rem;
  }
  .sc-chip-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px rgba(212, 175, 106, 0.5);
  }
  .sc-chip-name { color: var(--gold-bright); font-weight: 600; }
  .sc-chip-country { color: var(--bone-faint); font-size: 0.78rem; }
  .sc-chip-remove {
    background: none;
    border: 0;
    color: var(--bone-faint);
    cursor: pointer;
    padding: 0.2rem;
    border-radius: 50%;
    transition: color 0.2s, background 0.2s;
  }
  .sc-chip-remove:hover { color: var(--cinnabar); background: rgba(224,87,74,0.1); }
  .sc-city-solar {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--bone-faint);
    font-style: italic;
  }
  .sc-skip {
    margin-bottom: 1.4rem;
  }

  .sc-next { min-width: 200px; }
  .sc-hint { margin-top: 0.8rem; font-size: 0.72rem; color: var(--bone-faint); }

  /* Loading (reuse existing styles) */
  .sc-loading { display: grid; place-items: center; gap: 2rem; padding: 2.5rem 0; }
  .sc-loading[hidden] { display: none; }
  .bagua { width: 110px; height: 110px; }
  .bagua-spin { transform-origin: 50px 50px; animation: spin 14s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .sc-cast-steps {
    list-style: none; padding: 0; display: grid; gap: 0.55rem;
  }
  .sc-cast-steps li {
    display: flex; align-items: center; gap: 0.7rem;
    color: var(--bone-faint); font-size: 0.92rem;
    opacity: 0.3; transform: translateX(8px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s, color 0.5s;
  }
  .sc-cast-steps li.active { opacity: 1; transform: none; color: var(--gold-bright); }
  .sc-cast-steps li.done { opacity: 0.65; color: var(--bone-dim); }
  .sc-cast-steps li .han { font-size: 0.8rem; color: var(--gold-deep); width: 3.2rem; }

  /* ── Results ── */
  .calc-results[hidden] { display: none; }
  .calc-results { animation: resIn 0.5s var(--ease-out); }
  @keyframes resIn { from { opacity: 0; transform: translateY(14px); } }

  /* Card header */
  .cc-header { text-align: center; margin-bottom: 2rem; }
  .cc-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 1rem;
    padding: 0.5rem 1.2rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--dm-color, var(--gold)) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--dm-color, var(--gold)) 8%, transparent);
  }
  .cc-badge-han {
    font-size: 1.6rem;
    color: var(--dm-color, var(--gold-bright));
    text-shadow: 0 0 18px color-mix(in srgb, var(--dm-color, var(--gold)) 40%, transparent);
    letter-spacing: 0.15em;
  }
  .cc-badge-label {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }
  .cc-name {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    margin-bottom: 0.35rem;
  }
  .cc-subtitle {
    color: var(--bone-dim);
    font-size: 0.88rem;
    max-width: 48ch;
    margin-inline: auto;
  }

  /* Modules (pillars) */
  .cc-modules { margin-bottom: 1.8rem; }
  .cc-module-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.8rem;
  }
  .cc-module-label .han { font-size: 0.85rem; color: var(--gold-deep); }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.55rem;
  }
  @media (max-width: 500px) { .pillars-grid { grid-template-columns: repeat(2, 1fr); } }
  .ptile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.9rem 0.3rem 0.75rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-s);
    background: var(--ink-1);
    animation: steleIn 0.7s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }
  .ptile.core {
    border-color: var(--dm-color, var(--gold));
    box-shadow: 0 0 20px color-mix(in srgb, var(--dm-color, var(--gold)) 25%, transparent);
  }
  .ptile.locked { opacity: 0.4; }
  .ptile-tag {
    position: absolute;
    top: -8px;
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--dm-color, var(--gold));
    color: #0f0b02;
    font-weight: 700;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
  }
  .ptile-han {
    font-size: 1.8rem;
    line-height: 1.2;
    color: var(--c, var(--bone));
    text-shadow: 0 0 14px color-mix(in srgb, var(--c, var(--gold)) 35%, transparent);
    font-family: var(--font-han);
  }
  .ptile-en { font-size: 0.64rem; color: var(--bone-dim); font-weight: 600; }
  .ptile-label { font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bone-faint); }
  @keyframes steleIn { from { opacity: 0; transform: translateY(12px); } }

  /* Section headers */
  .cc-section {
    margin-bottom: 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-soft);
  }
  .cc-section-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .cc-section-head .han { font-size: 0.85rem; color: var(--gold-deep); }

  :global(.cc-verdict) {
    padding: 1.25rem;
    border: 1px solid rgba(212,175,106,.35);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-s);
    background: linear-gradient(135deg, rgba(212,175,106,.11), rgba(212,175,106,.025));
  }
  :global(.cc-verdict-kicker) {
    display: block;
    color: var(--cinnabar-light);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :global(.cc-verdict h4) { margin: 0.35rem 0 0.65rem; font-size: 1.25rem; }
  :global(.cc-verdict-lead) { color: var(--bone); font-family: var(--font-display); font-size: 1rem; line-height: 1.75; }
  :global(.cc-verdict-proof) { display: grid; gap: 0.55rem; margin-top: 1rem; }
  :global(.cc-verdict-proof p) { margin: 0; color: var(--bone-dim); font-size: 0.8rem; line-height: 1.65; }
  :global(.cc-verdict-proof strong) { color: var(--gold-bright); }
  :global(.cc-verdict-timing) { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  :global(.cc-verdict-timing h5) { margin: 0 0 0.35rem; color: var(--gold-bright); font-size: 0.9rem; }
  :global(.cc-verdict-timing p) { margin: 0; color: var(--bone-dim); font-size: 0.82rem; line-height: 1.65; }
  :global(.cc-verdict-action) { margin-top: 0.9rem; color: var(--bone); font-size: 0.84rem; line-height: 1.65; }
  :global(.cc-verdict-maxim) { margin: 0.9rem 0 0; color: var(--gold-bright); font-family: var(--font-display); font-style: italic; font-size: 0.95rem; line-height: 1.55; }

  /* Attributes — element bars (from charts.ts) */
  .ebars { display: grid; gap: 0.5rem; margin-bottom: 1.2rem; }
  .ebar-row { display: flex; align-items: center; gap: 0.6rem; font-size: 0.82rem; }
  .ebar-han { font-family: var(--font-han); width: 1.2rem; text-align: center; font-size: 1rem; }
  .ebar-name { width: 3.8rem; color: var(--bone-dim); font-weight: 500; }
  .ebar-track { flex: 1; height: 8px; background: var(--ink-2); border-radius: 4px; overflow: hidden; border: 1px solid var(--line-soft); }
  .ebar-fill { display: block; height: 100%; border-radius: 4px; transition: width 1s var(--ease-out); }
  .ebar-fill.dom { box-shadow: 0 0 10px currentColor; }
  .ebar-count { width: 2.2rem; text-align: right; color: var(--bone-faint); font-size: 0.78rem; }

  /* Attributes — keep old grid for compat */
  .cc-attrs-bars { display: grid; gap: 0.55rem; margin-bottom: 1rem; }
  .attr-row {
    display: grid;
    grid-template-columns: 2rem 1fr auto 3rem;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-s);
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    transition: border-color 0.35s, box-shadow 0.35s;
  }
  .attr-row.dominant {
    border-color: color-mix(in srgb, var(--dm-color, var(--gold)) 30%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--dm-color, var(--gold)) 10%, transparent);
  }
  .attr-row.deficient { border-color: rgba(224,87,74,0.2); }
  .attr-icon {
    font-size: 1.2rem;
    font-family: var(--font-han);
    text-align: center;
  }
  .attr-icon { color: var(--bone-dim); }
  .attr-row.dominant .attr-icon { color: var(--dm-color, var(--gold-bright)); }
  .attr-info { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .attr-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--bone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .attr-name small {
    font-size: 0.66rem;
    font-weight: 400;
    color: var(--bone-faint);
    margin-left: 0.3rem;
  }
  .attr-status {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .attr-row.deficient .attr-status { color: var(--cinnabar); }
  .attr-bar-wrap {
    height: 6px;
    background: var(--ink-2);
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--line-soft);
  }
  .attr-bar {
    height: 100%;
    border-radius: 3px;
    transition: width 1s var(--ease-out);
  }
  .attr-val {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--bone-dim);
    text-align: right;
  }
  .attr-row.dominant .attr-val { color: var(--gold-bright); }
  .cc-attrs-summary {
    padding: 0.9rem 1rem;
    border-radius: var(--radius-s);
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    font-size: 0.85rem;
    color: var(--bone-dim);
    line-height: 1.7;
  }

  /* Traits */
  .trait-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }
  .trait-tag {
    font-size: 0.78rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--gold-bright);
    background: rgba(212,175,106,0.06);
    font-weight: 500;
  }
  .trait-notes { display: grid; gap: 0.6rem; }
  .trait-note {
    display: flex;
    gap: 0.65rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-s);
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    font-size: 0.84rem;
    color: var(--bone-dim);
  }
  .trait-note strong { display: block; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bone-faint); margin-bottom: 0.15rem; }

  /* The trait and environment cards are rendered after hydration. */
  :global(#ccTraits .trait-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }
  :global(#ccTraits .trait-tag) {
    display: inline-flex;
