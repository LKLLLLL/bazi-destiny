          <small>${isZh ? `久处容易消耗命局${data.elements.dominant}气，重要事项尽量少朝这些方向。` : `Long exposure drains your ${domEn} energy — minimize facing these directions.`}</small>
        </div>
      </div>`;

    // Guardian Spirit
    const guardian = getGuardianSpirit(data);
    $('guardianChinese')!.textContent = guardian.chinese;
    $('guardianName')!.textContent = isZh ? '' : guardian.name;
    $('guardianTitle')!.textContent = isZh ? `${p.day.stem}${p.day.branch}日主的守护象征` : guardian.title;
    $('guardianBackground')!.textContent = isZh
      ? `${guardian.chinese}象征在压力中守住${data.elements.dominant}的本性，同时主动补足${data.elements.deficient}气。你的天赋只有落实为长期行动，才会真正成为命运的助力。`
      : guardian.background;

    // Paywall state — paying customers always see the full blueprint
    const paywall = $('ccPaywall');
    const pro = $('ccPro');
    if (isUnlocked('pro')) {
      if (paywall) paywall.style.display = 'none';
      renderProLifestyle();
    } else {
      if (paywall) paywall.style.display = '';
      if (pro) pro.hidden = true;
      void paymentStatusReady.then((status) => {
        if (status.pro && currentData === data) {
          if (paywall) paywall.style.display = 'none';
          renderProLifestyle();
        }
      });
    }
  }


  function renderProLifestyle() {
