<script>
  import { CITIES, searchCities, solarTimeCorrection } from '../data/cities';
  import BaZiEngine from '../lib/bazi/engine';
  import Readings from '../lib/bazi/readings';
  import { elementsDonut, elementBars, compass, pillarStrengthCards, ELEM_EN, ELEM_COLOR, STEM_EN, BRANCH_EN, ZODIAC_EMOJI } from '../lib/charts';
  import { resolveUnlock, isUnlocked } from '../lib/paypal';
  import { getLifestyleGuide } from '../lib/bazi/lifestyle';

  const LS_KEY = 'bazi_stepcalc_data';

  const $ = (id: string) => document.getElementById(id);

  // ── State ──
  interface CalcState {
    date: string;
    hour: string;       // '' | '23'|'1'|...|'unknown'
    cityName: string;
    cityLon: number;
    cityLat: number;
    cityTimezone: number;
    useSolarTime: boolean;
    gender: 'male' | 'female' | '';
    cityData?: typeof CITIES[0]; // cached full city object to avoid re-lookup
  }

  const state: CalcState = {
    date: '',
    hour: '',
    cityName: '',
    cityLon: 0,
    cityLat: 0,
    cityTimezone: 8,
    useSolarTime: false,
    gender: '',
  };

  let currentStep = 0;
  let currentData: any = null;
  let loadTimer: ReturnType<typeof setInterval> | null = null;
  let loadTimeout: ReturnType<typeof setTimeout> | null = null;

  // ── localStorage ──
  function saveState() {
    try {
      const { cityData, ...rest } = state;
      localStorage.setItem(LS_KEY, JSON.stringify(rest));
    } catch {}
  }
  function loadState(): boolean {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return false;
      const saved = JSON.parse(raw);
      if (saved.date) {
        state.date = saved.date;
        state.hour = saved.hour || '';
        state.cityName = saved.cityName || '';
        state.cityLon = saved.cityLon || 0;
        state.cityLat = saved.cityLat || 0;
        state.cityTimezone = saved.cityTimezone || 8;
        state.useSolarTime = saved.useSolarTime || false;
        state.gender = saved.gender || '';
        return true;
      }
    } catch {}
    return false;
  }

  // ── Progress ──
  function updateProgress() {
    const fill = $('scProgressFill');
    const dots = $('scProgressSteps')?.querySelectorAll('.sc-step-dot');
    if (fill) fill.style.width = `${(currentStep / 2) * 100}%`;
    dots?.forEach((d, i) => {
      const btn = d as HTMLButtonElement;
      btn.classList.remove('active', 'done');
      if (i < currentStep) btn.classList.add('done');
      if (i === currentStep) btn.classList.add('active');
      btn.disabled = i > currentStep;
    });
  }

  function goToStep(n: number) {
    if (n < 0 || n > 2) return;
    // Only allow 1 step forward at a time, but any step back
    if (n > currentStep + 1) return;
    currentStep = n;
    for (let i = 0; i <= 2; i++) {
      const el = $(`scStep${i}`);
      if (el) el.hidden = i !== n;
    }
    updateProgress();
    if (n === 0) setTimeout(() => $('scDate')?.focus(), 100);
    if (n === 2) setTimeout(() => $('scCityInput')?.focus(), 100);
  }

  // ── Step 1: Date ──
  const dateInput = $('scDate') as HTMLInputElement;
  const next0 = $('scNext0') as HTMLButtonElement;

  dateInput?.addEventListener('input', () => {
    const v = dateInput.value;
    state.date = v;
    updateNext0();
    saveState();
  });

  document.querySelectorAll<HTMLInputElement>('input[name="scGender"]').forEach(r => {
    r.addEventListener('change', () => {
      state.gender = r.value as 'male' | 'female';
      updateNext0();
      saveState();
    });
  });

  function updateNext0() {
    next0.disabled = !(state.date && state.gender);
  }

  dateInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !next0.disabled) goToStep(1);
  });

  next0?.addEventListener('click', () => goToStep(1));

  // ── Step 2: Hour ──
  const hourBtns = $('scHourGrid')?.querySelectorAll('.sc-hour-btn');
  const unknownBtn = $('scUnknownHour');
  const solarToggle = $('scSolarToggle') as HTMLInputElement;
  const next1 = $('scNext1') as HTMLButtonElement;

  function selectHour(val: string) {
    state.hour = val;
    hourBtns?.forEach((b) => b.classList.toggle('selected', (b as HTMLElement).dataset.hour === val));
    unknownBtn?.classList.toggle('active', val === 'unknown');
    next1.disabled = !val;
    saveState();
  }

  hourBtns?.forEach((b) => b.addEventListener('click', () => {
    selectHour((b as HTMLElement).dataset.hour!);
    solarToggle.checked = false;
    state.useSolarTime = false;
    saveState();
  }));

  unknownBtn?.addEventListener('click', () => selectHour('unknown'));
  solarToggle?.addEventListener('change', () => {
    state.useSolarTime = solarToggle.checked;
    saveState();
  });
  next1?.addEventListener('click', () => goToStep(2));

  // ── Step 3: City ──
  const cityInput = $('scCityInput') as HTMLInputElement;
  const cityList = $('scCityList') as HTMLUListElement;
  const cityClear = $('scCityClear');
  const citySelected = $('scCitySelected');
  const cityChipName = $('scCityChipName');
  const cityChipCountry = $('scCityChipCountry');
  const cityChipRemove = $('scCityChipRemove');
  const citySolar = $('scCitySolar');
  const skipCity = $('scSkipCity');
  const next2 = $('scNext2') as HTMLButtonElement;

  let cityResults: typeof CITIES = [];
  let cityHighlightIdx = -1;

  function showCityList() {
    cityList.hidden = false;
    cityInput.setAttribute('aria-expanded', 'true');
  }
  function hideCityList() {
    cityList.hidden = true;
    cityInput.setAttribute('aria-expanded', 'false');
    cityHighlightIdx = -1;
  }

  function renderCityList(query: string) {
    cityResults = searchCities(query);
    cityHighlightIdx = -1;
    cityList.innerHTML = cityResults.map((c, i) => `
      <li class="sc-city-item" role="option" data-idx="${i}">
        <span class="sc-city-item-flag">${getFlag(c.country)}</span>
        <span class="sc-city-item-name">${c.name} <span class="han" style="font-size:.78rem;color:var(--bone-faint)">${c.nameCN}</span></span>
        <span class="sc-city-item-country">${c.country}</span>
        <span class="sc-city-item-tz">UTC${c.timezone >= 0 ? '+' : ''}${c.timezone}</span>
      </li>
    `).join('');
    if (cityResults.length > 0) showCityList();
    else hideCityList();
  }

  const COUNTRY_FLAGS: Record<string, string> = {
    'China': '🇨🇳', 'Japan': '🇯🇵', 'South Korea': '🇰🇷', 'Mongolia': '🇲🇳',
    'Singapore': '🇸🇬', 'Malaysia': '🇲🇾', 'Thailand': '🇹🇭', 'Indonesia': '🇮🇩',
    'Philippines': '🇵🇭', 'Vietnam': '🇻🇳', 'Myanmar': '🇲🇲',
    'India': '🇮🇳', 'Pakistan': '🇵🇰', 'Bangladesh': '🇧🇩', 'Sri Lanka': '🇱🇰', 'Nepal': '🇳🇵',
    'UAE': '🇦🇪', 'Qatar': '🇶🇦', 'Saudi Arabia': '🇸🇦', 'Turkey': '🇹🇷', 'Israel': '🇮🇱', 'Iran': '🇮🇷',
    'United Kingdom': '🇬🇧', 'France': '🇫🇷', 'Germany': '🇩🇪', 'Italy': '🇮🇹', 'Spain': '🇪🇸',
    'Netherlands': '🇳🇱', 'Belgium': '🇧🇪', 'Switzerland': '🇨🇭', 'Austria': '🇦🇹',
    'Sweden': '🇸🇪', 'Norway': '🇳🇴', 'Denmark': '🇩🇰', 'Poland': '🇵🇱',
    'Russia': '🇷🇺', 'Czech Republic': '🇨🇿', 'Hungary': '🇭🇺', 'Portugal': '🇵🇹',
    'Ireland': '🇮🇪', 'Greece': '🇬🇷',
    'United States': '🇺🇸', 'Canada': '🇨🇦', 'Mexico': '🇲🇽',
    'Brazil': '🇧🇷', 'Argentina': '🇦🇷', 'Chile': '🇨🇱', 'Peru': '🇵🇪', 'Colombia': '🇨🇴',
    'Australia': '🇦🇺', 'New Zealand': '🇳🇿',
    'Egypt': '🇪🇬', 'Nigeria': '🇳🇬', 'Kenya': '🇰🇪', 'South Africa': '🇿🇦', 'Morocco': '🇲🇦', 'Ethiopia': '🇪🇹',
    'Taiwan, China': '🇨🇳', 'Hong Kong, China': '🇨🇳', 'Macao, China': '🇨🇳',
  };

  function getFlag(country: string): string {
    return COUNTRY_FLAGS[country] || '🌐';
  }

  function selectCity(city: typeof CITIES[0]) {
    state.cityName = city.name;
    state.cityLat = city.lat;
    state.cityLon = city.lon;
    state.cityTimezone = city.timezone;
    state.cityData = city; // cache full object to avoid re-lookup
    cityInput.value = '';
    hideCityList();
    cityClear!.hidden = true;

    cityChipName!.textContent = city.name;
    cityChipCountry!.textContent = `· ${city.nameCN} · ${city.country}`;
    citySelected!.hidden = false;
    next2.disabled = false;

    if (state.useSolarTime && solarToggle?.checked) {
      const corr = solarTimeCorrection(city);
      const sign = corr >= 0 ? '+' : '';
      const absMin = Math.abs(Math.round(corr));
      citySolar!.hidden = false;
      citySolar!.textContent = `☀ True Solar Time correction: ${sign}${absMin} min${city.name !== 'Beijing' ? ` (at ${city.lon.toFixed(1)}° longitude)` : ''}`;
    } else {
      citySolar!.hidden = true;
    }
    saveState();
  }

  let cityDebounceTimer: ReturnType<typeof setTimeout>;

  cityInput?.addEventListener('input', () => {
    const q = cityInput.value;
    cityClear!.hidden = !q;
    clearTimeout(cityDebounceTimer);
    if (q.trim()) {
      cityDebounceTimer = setTimeout(() => renderCityList(q), 150);
    } else {
      hideCityList();
    }
  });

  cityInput?.addEventListener('keydown', (e) => {
    if (!cityResults.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      cityHighlightIdx = Math.min(cityHighlightIdx + 1, cityResults.length - 1);
      updateHighlight();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      cityHighlightIdx = Math.max(cityHighlightIdx - 1, 0);
      updateHighlight();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (cityHighlightIdx >= 0 && cityHighlightIdx < cityResults.length) {
        selectCity(cityResults[cityHighlightIdx]);
      } else if (cityResults.length === 1) {
        selectCity(cityResults[0]);
      }
    } else if (e.key === 'Escape') {
      hideCityList();
      cityInput.blur();
    }
  });

  function updateHighlight() {
    cityList.querySelectorAll('.sc-city-item').forEach((el, i) => {
      el.classList.toggle('highlight', i === cityHighlightIdx);
    });
    const highlighted = cityList.querySelector('.highlight');
    highlighted?.scrollIntoView({ block: 'nearest' });
  }

  cityList?.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest('.sc-city-item');
    if (!item) return;
    const idx = parseInt((item as HTMLElement).dataset.idx || '');
    if (!isNaN(idx) && cityResults[idx]) selectCity(cityResults[idx]);
  });

  cityClear?.addEventListener('click', () => {
    cityInput.value = '';
    cityClear!.hidden = true;
    hideCityList();
    cityInput.focus();
  });

  cityChipRemove?.addEventListener('click', () => {
    state.cityName = '';
    state.cityLon = 0;
    state.cityLat = 0;
    citySelected!.hidden = true;
    next2.disabled = true;
    saveState();
    cityInput.focus();
  });

  document.addEventListener('click', (e) => {
    const search = $('scCitySearch');
    if (search && !search.contains(e.target as Node)) hideCityList();
  });

  skipCity?.addEventListener('click', () => {
    state.cityName = '';
    state.cityLon = 0;
    state.cityLat = 0;
    next2.disabled = false;
    if (citySelected) citySelected.hidden = true;
    saveState();
    doCalculate();
  });

  next2?.addEventListener('click', () => doCalculate());

  // ── Progress dots click to go back ──
  $('scProgressSteps')?.addEventListener('click', (e) => {
    const dot = (e.target as HTMLElement).closest('.sc-step-dot');
    if (!dot || (dot as HTMLButtonElement).disabled) return;
    const step = parseInt((dot as HTMLElement).dataset.step || '');
    if (!isNaN(step)) goToStep(step);
  });

  // ── Calculate ──
  function doCalculate() {
    const { date, hour, cityName, cityLat, cityLon, cityTimezone, useSolarTime } = state;
    if (!date) return;

    const d = new Date(date + 'T00:00:00');
    const year = d.getFullYear();
    const month = d.getMonth() + 1;
    const day = d.getDate();

    let hourNum = parseInt(hour, 10);
    if (isNaN(hourNum)) hourNum = 12; // unknown → default noon

    // True Solar Time correction
    if (useSolarTime && cityName) {
      // Use cached city data to avoid O(n) re-lookup
      const city = state.cityData || CITIES.find((c) => c.name === cityName);
      if (city) {
        const corr = solarTimeCorrection(city);
        hourNum = hourNum + corr / 60;
        // wrap around
        if (hourNum >= 24) hourNum -= 24;
        if (hourNum < 0) hourNum += 24;
      }
    }

    // Hide steps, show loading — clear any previous animation
    if (loadTimer) clearInterval(loadTimer);
    if (loadTimeout) clearTimeout(loadTimeout);
    for (let i = 0; i <= 2; i++) {
      const el = $(`scStep${i}`);
      if (el) el.hidden = true;
    }
    $('scWelcome')!.hidden = true;
    $('scLoading')!.hidden = false;

    const steps = $('scLoading')!.querySelectorAll('.sc-cast-steps li');
    steps.forEach((s) => s.classList.remove('active', 'done'));
    let idx = 0;
    loadTimer = setInterval(() => {
      if (idx > 0) { steps[idx - 1]?.classList.remove('active'); steps[idx - 1]?.classList.add('done'); }
      if (idx < steps.length) steps[idx]?.classList.add('active');
      idx++;
      if (idx > steps.length) { clearInterval(loadTimer!); loadTimer = null; }
    }, 550);

    // Compute immediately (synchronous, ~5ms) then show after animation completes
    const animSteps = steps.length;
    const animDuration = animSteps * 550; // 4 steps × 550ms = 2200ms
    const minDisplay = 1200; // minimum loading display time

    const useFourPillars = hour !== 'unknown';
    let data: any;

    if (useFourPillars) {
      data = BaZiEngine.calculate(date, hourNum);
    } else {
      data = BaZiEngine.calculate(date, 12);
      data.isThreePillar = true;
      data.hourUnknown = true;
    }

    currentData = {
      ...data,
      gender: state.gender,
      date,
      hour,
      cityName,
      useSolarTime,
      isThreePillar: !useFourPillars,
    };
    (window as any).currentReading = currentData;

    const showResults = () => {
      // Prevent double-show on rescan
      if ($('scLoading')?.hidden) return;
      $('scLoading')!.hidden = true;
      $('calcResults')!.hidden = false;
      renderResults(currentData);
      $('calcResults')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // Show results after animation completes, with a minimum display time
    loadTimeout = setTimeout(showResults, Math.max(animDuration, minDisplay));
  }

  // ── RPG Character Card Render ──
  function pillarTile(label: string, pillar: any, isCore: boolean, idx: number): string {
    const color = ELEM_COLOR[pillar?.element] || 'var(--gold)';
    const tag = isCore ? 'Core' : '';
    return `<div class="ptile${isCore ? ' core' : ''}" style="--d:${idx * 0.09}s;--c:${color}">
      <span class="ptile-tag">${tag}</span>
      <span class="ptile-han han">${pillar?.stem || '—'}${pillar?.branch || '—'}</span>
      <span class="ptile-en">${STEM_EN[pillar?.stem] || '?'}</span>
      <span class="ptile-label">${label}</span>
    </div>`;
  }

  function renderResults(data: any) {
    const p = data.pillars;
    const yearAnimal = p.year ? BRANCH_EN[p.year.branch] : 'Unknown';
    const domEn = ELEM_EN[data.elements.dominant];
    const defEn = ELEM_EN[data.elements.deficient];
    const domColor = ELEM_COLOR[data.elements.dominant] || 'var(--gold)';
    const defColor = ELEM_COLOR[data.elements.deficient] || 'var(--bone-dim)';
    const birthYear = new Date(data.date + 'T00:00:00').getFullYear();

    // Header
    $('ccDayMaster')!.textContent = `${p.day?.stem || '?'}${p.day?.branch || '?'}`;
    $('ccBadge')!.setAttribute('style', `--dm-color:${domColor}`);
    const genderLabel = data.gender === 'male' ? '♂' : data.gender === 'female' ? '♀' : '';
    $('ccName')!.textContent = `${genderLabel} ${yearAnimal} ${ZODIAC_EMOJI[yearAnimal] || '✦'}`;
    $('ccSubtitle')!.textContent = data.isThreePillar
      ? `Born ${birthYear} · Core Engine: ${STEM_EN[p.day.stem]} · Primary Attribute: ${domEn}`
      : `Born ${birthYear} · Core Engine: ${STEM_EN[p.day.stem]} · Primary Attribute: ${domEn}`;

    // Modules
    $('pillarsGrid')!.innerHTML =
      pillarTile('Origin', p.year, false, 0) +
      pillarTile('Nature', p.month, false, 1) +
      pillarTile('Identity', p.day, true, 2) +
      (data.isThreePillar
        ? `<div class="ptile locked" style="--d:0.27s"><span class="ptile-han han">?</span><span class="ptile-en">Unknown</span><span class="ptile-label">Potential</span></div>`
        : pillarTile('Potential', p.hour, false, 3));

    // Pillar Strength gauges
    const ps = $('pillarStrength');
    if (ps && !data.isThreePillar) ps.innerHTML = pillarStrengthCards(p);

    // Attributes
    const elemMap: Record<string, { en: string; cn: string; desc: string }> = {
      '木': { en: 'Wood', cn: '木', desc: 'Growth & creativity' },
      '火': { en: 'Fire', cn: '火', desc: 'Passion & energy' },
      '土': { en: 'Earth', cn: '土', desc: 'Stability & grounding' },
      '金': { en: 'Metal', cn: '金', desc: 'Precision & clarity' },
      '水': { en: 'Water', cn: '水', desc: 'Wisdom & adaptability' },
    };
    // Use proven elementBars function from charts.ts
    const el = $('attrBars');
    if (el) el.innerHTML = elementBars(data.elements);

    $('attrSummary')!.innerHTML = `
      <p style="margin-top:0.5rem"><strong style="color:${defColor}">Growth area: ${defEn}</strong> — weaving small ${defEn}-element habits into your day brings balance and unlocks latent potential.</p>`;

    // Traits
    const persona = Readings.getPersonality(p.day.stem, data.elements.dominant);
    const traits: string[] = persona?.traits || ['Adaptable', 'Curious', 'Reflective'];
    const strength = persona?.strength || 'Natural resilience and adaptability';
    const weakness = persona?.weakness || 'May overthink under pressure';

    $('ccTraits')!.innerHTML = `
      <div class="trait-tags">
        ${traits.map((t: string) => `<span class="trait-tag">${t}</span>`).join('')}
      </div>
      <div class="trait-notes">
        <div class="trait-note"><span class="trait-icon">✓</span><div><strong>Strength</strong><span>${strength}</span></div></div>
        <div class="trait-note"><span class="trait-icon">⚡</span><div><strong>Watch for</strong><span>${weakness}</span></div></div>
      </div>`;

    // Environment
    const d = data.directions;
    $('ccEnv')!.innerHTML = `
      <div class="env-item">
        <span class="env-icon">🧭</span>
        <div>
          <strong>Best facing</strong>
          <span>${d.auspicious?.join(' · ') || 'East · South'}</span>
          <small>Face these when working, negotiating, or placing your desk.</small>
        </div>
      </div>
      <div class="env-item">
        <span class="env-icon">⚠️</span>
        <div>
          <strong>Drain zones</strong>
          <span>${d.inauspicious?.join(' · ') || 'West'}</span>
          <small>Long exposure drains your ${domEn} energy — minimize facing these directions.</small>
        </div>
      </div>`;

    // Paywall state — paying customers always see the full blueprint
    const paywall = $('ccPaywall');
    const pro = $('ccPro');
    if (isUnlocked()) {
      if (paywall) paywall.style.display = 'none';
      renderProLifestyle();
    } else {
      if (paywall) paywall.style.display = '';
      if (pro) pro.hidden = true;
    }
  }


  function renderProLifestyle() {
    if (!currentData) return;
    const guide = getLifestyleGuide(currentData.elements.dominant, currentData.pillars.day.stem);
    const sections: Array<{ key: string; icon: string; title: string; items: string[] }> = [
