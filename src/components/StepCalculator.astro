      </article>`;

    // Traits
    const persona = isZh ? PERSONALITY_ZH[p.day.element] : Readings.getPersonality(p.day.stem, p.day.element);
    const traits: string[] = persona?.traits || (isZh ? ['适应力强', '善观察', '重思考'] : ['Adaptable', 'Curious', 'Reflective']);
    const strength = persona?.strength || (isZh ? '有韧性，能随环境调整' : 'Natural resilience and adaptability');
    const weakness = persona?.weakness || (isZh ? '压力大时容易思虑过多' : 'May overthink under pressure');

    $('ccTraits')!.innerHTML = `
      <div class="trait-tags">
        ${traits.map((t: string) => `<span class="trait-tag">${t}</span>`).join('')}
      </div>
      <div class="trait-notes">
        <div class="trait-note"><div><strong>${isZh ? '优势' : 'Strength'}</strong><span>${strength}</span></div></div>
        <div class="trait-note"><div><strong>${isZh ? '需要留意' : 'Watch for'}</strong><span>${weakness}</span></div></div>
      </div>`;

    // Environment
    const d = data.directions;
    $('ccEnv')!.innerHTML = `
      <div class="env-item">
        <div>
          <strong>${isZh ? '有利方位' : 'Best facing'}</strong>
          <span>${isZh ? (d.auspicious?.map((x: string) => DIRECTION_ZH[x] || x).join(' · ') || '东 · 南') : (d.auspicious?.join(' · ') || 'East · South')}</span>
          <small>${isZh ? '工作、谈判或安放书桌时，可优先面向这些方位。' : 'Face these when working, negotiating, or placing your desk.'}</small>
        </div>
      </div>
      <div class="env-item">
        <div>
          <strong>${isZh ? '耗气方位' : 'Drain zones'}</strong>
