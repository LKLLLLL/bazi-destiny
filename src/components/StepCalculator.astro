      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const day = currentData.pillars.day;
    $('ccReportDayMaster')!.textContent = `${day.stem}${day.branch}${isZh ? '' : ` · ${STEM_EN[day.stem] || ''}`}`;
    $('ccReportElement')!.textContent = isZh ? `${currentData.elements.dominant}行` : (ELEM_EN[currentData.elements.dominant] || currentData.elements.dominant);
    $('ccReportGrowth')!.textContent = isZh ? `${currentData.elements.deficient}行` : (ELEM_EN[currentData.elements.deficient] || currentData.elements.deficient);
    $('ccReportIndex')!.innerHTML = sections.map((section) => `
      <a class="cc-index-link" href="#report-${escapeHtml(section.key)}">
        <span class="cc-index-mark han">${escapeHtml(section.icon)}</span>
