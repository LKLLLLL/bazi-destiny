    // Open the tailored print view. If popups are blocked, print the current report instead.
    const printWin = window.open('', '_blank');
    if (printWin) {
      printWin.document.write(html);
      printWin.document.close();
      printWin.addEventListener('load', () => {
        printWin.focus();
        printWin.print();
      });
    } else {
      window.print();
    }
  });
  $('shareBtn')?.addEventListener('click', () => {
    const elem = currentData ? ELEM_EN[currentData.elements.dominant] : '';
    const dm = currentData ? STEM_EN[currentData.pillars.day.stem] : '';
    const text = isZh
      ? `我的八字命盘：日主 ${currentData?.pillars.day.stem}${currentData?.pillars.day.branch} · 命局主势 ${currentData?.elements.dominant} · 免费排盘：https://mybazidestiny.com/zh/calculator.html`
      : `My BaZi chart: Day Master ${dm} · Dominant Element ${elem} · Discover yours: https://mybazidestiny.com/calculator.html`;
    if (navigator.share) navigator.share({ title: isZh ? '我的八字命盘' : 'My Life Blueprint', text }).catch(() => {});
    else navigator.clipboard?.writeText(text).then(() => alert(isZh ? '结果链接已复制' : 'Result link copied!'));
  });

  $('recastBtn')?.addEventListener('click', () => {
    $('calcResults')!.hidden = true;
    currentData = null;
    try { localStorage.removeItem(LS_KEY); } catch {}
    currentStep = 0;
    for (let i = 0; i <= 2; i++) {
      const el = $(`scStep${i}`);
      if (el) el.hidden = i !== 0;
    }
    state.date = ''; state.hour = ''; state.cityName = '';
    state.gender = '';
    (dateInput as HTMLInputElement).value = '';
    document.querySelectorAll<HTMLInputElement>('input[name="scGender"]').forEach((r) => { r.checked = false; });
    next0.disabled = true;
    selectHour('');
    if (citySelected) citySelected.hidden = true;
    next2.disabled = true;
    updateProgress();
    setTimeout(() => dateInput?.focus(), 200);
  });

  // ── PayPal Unlock ──
  $('unlockProBtn')?.addEventListener('click', () => { (window as any).__baziUpgrade?.('pro', currentData); });
  
  // Restore the chart only after the server confirms the PayPal order.
  void paymentStatusReady.then((status) => {
    const returned = new URLSearchParams(window.location.search).get('checkout') === 'complete';
    const pending = returned && status.pro ? readPendingCheckout('pro') as any : null;
    if (pending?.date) {
      currentData = pending;
      clearPendingCheckout();
      (window as any).currentReading = currentData;
      for (let i = 0; i <= 2; i++) { const el = $(`scStep${i}`); if (el) el.hidden = true; }
      $('scWelcome')!.hidden = true;
      $('calcResults')!.hidden = false;
      window.history.replaceState({}, document.title, window.location.pathname);
      renderResults(currentData);
    }
  });


  // Debug mode — only available in dev environment, add ?debug=1 to URL to skip paywall
  if (import.meta.env.DEV && typeof window !== 'undefined' && window.location.search.includes('debug=1')) {
    setTimeout(() => {
      const pw = $('ccPaywall');
      if (pw) pw.style.display = 'none';
      if (currentData) {
        renderProLifestyle();
      } else {
        // Auto-fill some data for quick preview
        const data = BaZiEngine.calculate('1990-06-15', 9);
        currentData = { ...data, name: 'Debug', date: '1990-06-15', hour: '9', isThreePillar: false };
        (window as any).currentReading = currentData;
        for (let i = 0; i <= 2; i++) { const el = $(`scStep${i}`); if (el) el.hidden = true; }
        $('scWelcome')!.hidden = true;
        $('calcResults')!.hidden = false;
        renderResults(currentData);
        if (pw) pw.style.display = 'none';
        renderProLifestyle();
      }
    }, 500);
  }

  // ── Init ──
  const hasSaved = loadState();
  if (hasSaved) {
    $('scWelcome')!.hidden = false;
    $('scWelcomeContinue')?.addEventListener('click', () => {
      $('scWelcome')!.hidden = true;
      // Restore state
      if (state.date) {
        (dateInput as HTMLInputElement).value = state.date;
        currentStep = state.hour ? (state.cityName ? 2 : 1) : 0;
      }
      if (state.gender) {
        const radio = document.querySelector<HTMLInputElement>(`input[name="scGender"][value="${state.gender}"]`);
        if (radio) radio.checked = true;
      }
      updateNext0();
      if (state.hour) selectHour(state.hour);
      if (state.cityName) {
        const city = CITIES.find((c) => c.name === state.cityName);
        if (city) selectCity(city);
      }
      if (state.useSolarTime && solarToggle) solarToggle.checked = true;
      goToStep(currentStep);
    });
  }

  // Explicit initial state
  $('scStep1')!.hidden = true;
  $('scStep2')!.hidden = true;
  $('scLoading')!.hidden = true;
  $('calcResults')!.hidden = true;
  updateProgress();
</script>
