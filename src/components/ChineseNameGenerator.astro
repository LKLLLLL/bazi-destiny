<section class="name-tool panel" aria-labelledby="name-tool-title">
  <div class="name-intro">
    <p class="eyebrow center"><span class="han">取名</span> Your Chinese Name</p>
    <h1 id="name-tool-title">Find a Chinese name that <em>means something.</em></h1>
    <p>
      We combine your BaZi and birth season with classical poetry and traditional botanical imagery
      to find three names shaped around you.
    </p>
  </div>

  <form id="nameForm" class="name-form">
    <div class="field-grid">
      <label class="field">
        <span>Your current name <small>Optional</small></span>
        <input id="englishName" name="englishName" type="text" maxlength="60" autocomplete="name" placeholder="Alex" />
      </label>
      <label class="field">
        <span>Date of birth</span>
        <input id="birthDate" name="birthDate" type="date" min="1900-01-01" max="2030-12-31" required />
      </label>
      <div class="field time-field">
        <label class="field-label" for="birthTime">Birth time <small>Optional</small></label>
        <input id="birthTime" name="birthTime" type="time" />
      </div>
      <label class="unknown-time">
        <input id="unknownBirthTime" type="checkbox" />
        <span>I don’t know my birth time</span>
      </label>
    </div>
    <p class="prefill-note" id="prefillNote" hidden><span aria-hidden="true">✓</span> We kept the birth details from your BaZi reading.</p>

    <fieldset class="choice-group">
      <legend>Name character</legend>
      <div class="segmented">
        <label><input type="radio" name="gender" value="neutral" checked /><span>Gender-neutral</span></label>
        <label><input type="radio" name="gender" value="feminine" /><span>Feminine</span></label>
        <label><input type="radio" name="gender" value="masculine" /><span>Masculine</span></label>
      </div>
    </fieldset>

    <div class="method-note">
      <span class="han" aria-hidden="true">诗 · 时 · 本草</span>
      <p><strong>One thoughtful process, three cultural directions.</strong> We will choose one name from classical poetry, one from your birth season, and one from Chinese herbal and botanical tradition.</p>
    </div>

    <p class="form-error" id="formError" role="alert" hidden></p>
    <button class="btn btn-gold btn-lg generate-btn" type="submit">
      Find My Chinese Name <span class="han">取名</span>
    </button>
    <p class="privacy-note">Three names are free · Best-name verdict $1.99 one-time · Your details stay in your browser</p>
  </form>

  <div class="name-results" id="nameResults" hidden aria-live="polite">
    <div class="results-heading">
      <p class="result-kicker">Three names chosen for you</p>
      <h2 id="resultGreeting">Your Chinese given names</h2>
      <p id="elementSummary"></p>
    </div>
    <div class="name-cards" id="nameCards"></div>
    <div class="name-verdict" id="nameVerdict"></div>
    <div class="results-actions">
      <button class="btn btn-ghost" type="button" id="startOver">Adjust my choices</button>
      <a class="btn btn-gold" id="exploreBazi" href="/calculator.html?from=chinese-name">Explore My Full BaZi</a>
    </div>
  </div>
</section>

<aside class="surname-note" aria-labelledby="surname-title">
  <span class="surname-mark han" aria-hidden="true">姓</span>
  <div>
    <h2 id="surname-title">Why we give you a given name, not a surname</h2>
    <p>
      Chinese surnames carry family history and are usually inherited. Out of respect for that tradition,
      we create only your given name: a personal name you can use naturally in study, work, travel, and friendships.
    </p>
  </div>
</aside>

<script>
  import { generateChineseNames, type NameGender } from '../lib/chinese-names';
  import { trackEvent } from '../lib/analytics';
  import { clearPendingCheckout, getPaymentStatus, isUnlocked, readPendingCheckout } from '../lib/paypal';

  interface NameFormState {
    birthDate: string;
    time: string;
    englishName: string;
    gender: NameGender;
  }

  const form = document.getElementById('nameForm') as HTMLFormElement;
  const results = document.getElementById('nameResults') as HTMLElement;
  const cards = document.getElementById('nameCards') as HTMLElement;
  const error = document.getElementById('formError') as HTMLElement;
  const greeting = document.getElementById('resultGreeting') as HTMLElement;
  const elementSummary = document.getElementById('elementSummary') as HTMLElement;
  const nameVerdict = document.getElementById('nameVerdict') as HTMLElement;
  const startOver = document.getElementById('startOver') as HTMLButtonElement;
  const birthTimeInput = document.getElementById('birthTime') as HTMLInputElement;
  const unknownBirthTime = document.getElementById('unknownBirthTime') as HTMLInputElement;
  const birthDateInput = document.getElementById('birthDate') as HTMLInputElement;
  const prefillNote = document.getElementById('prefillNote') as HTMLElement;
  const paymentStatusReady = getPaymentStatus();
  let currentCheckoutState: NameFormState | null = null;

  const elementPurpose: Record<string, string> = {
    Wood: 'growth, direction, and the courage to begin',
    Fire: 'visibility, warmth, and expressive confidence',
    Earth: 'stability, trust, and the power to sustain',
    Metal: 'clarity, standards, and refined judgment',
    Water: 'wisdom, adaptability, and long-range vision',
  };

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
  })[character] ?? character);

  unknownBirthTime.addEventListener('change', () => {
    if (unknownBirthTime.checked) birthTimeInput.value = '';
    birthTimeInput.disabled = unknownBirthTime.checked;
  });

  try {
    const saved = JSON.parse(localStorage.getItem('bazi_stepcalc_data') ?? 'null');
    if (saved?.date) {
      birthDateInput.value = saved.date;
      if (saved.hour === 'unknown') {
        unknownBirthTime.checked = true;
        birthTimeInput.disabled = true;
      } else if (saved.hour !== '' && Number.isFinite(Number(saved.hour))) {
        birthTimeInput.value = `${String(Number(saved.hour)).padStart(2, '0')}:00`;
      }
      prefillNote.hidden = false;
    }
  } catch {}

  function readFormState(): NameFormState | null {
    const values = new FormData(form);
    const birthDate = String(values.get('birthDate') ?? '');
    if (!birthDate) {
      error.textContent = 'Please enter your date of birth.';
      error.hidden = false;
      return null;
    }
    error.hidden = true;
    return {
      birthDate,
      time: unknownBirthTime.checked ? '' : String(values.get('birthTime') ?? ''),
      englishName: String(values.get('englishName') ?? '').trim(),
      gender: String(values.get('gender')) as NameGender,
    };
  }

  function applyFormState(state: NameFormState) {
    birthDateInput.value = state.birthDate;
    birthTimeInput.value = state.time;
    unknownBirthTime.checked = !state.time;
    birthTimeInput.disabled = !state.time;
    const nameInput = document.getElementById('englishName') as HTMLInputElement;
    nameInput.value = state.englishName;
    form.querySelector<HTMLInputElement>(`input[name="gender"][value="${state.gender}"]`)?.click();
  }

  function lockedVerdictHtml() {
    return `
      <div class="name-verdict-lock">
        <div class="name-verdict-lock-main">
          <span class="name-verdict-lock-seal han" aria-hidden="true">择</span>
          <div>
            <span class="name-verdict-kicker">命名结论 · Personalized naming verdict</span>
            <h3>Which of these three names is your strongest overall choice?</h3>
            <p>We have compared all three across your BaZi balance, cultural source, pronunciation, meaning, and modern Chinese usage. Unlock the final selection and the reasoning behind it.</p>
          </div>
        </div>
        <div class="name-verdict-lock-signals" aria-label="Verdict criteria">
          <span><strong>01</strong> Element fit</span>
          <span><strong>02</strong> Meaning &amp; sound</span>
          <span><strong>03</strong> Modern usage</span>
        </div>
        <div class="name-verdict-lock-action">
          <button class="btn btn-gold btn-lg" type="button" id="unlockNamingBtn">Unlock My Best Name — $1.99</button>
          <small>One-time PayPal payment · No subscription</small>
        </div>
      </div>`;
  }

  function unlockedVerdictHtml(generated: ReturnType<typeof generateChineseNames>) {
    const primary = generated.names.find((name) => name.element === generated.deficientElement) || generated.names[0];
    const primaryImpression = primary.impression.replace(/\.$/, '');
    const comparison = generated.names.map((name) => {
      const isPrimary = name.hanzi === primary.hanzi;
      return `<div${isPrimary ? ' class="is-winner"' : ''}><span>${isPrimary ? 'Best overall' : name.inspirationLabel}</span><strong class="han">${name.hanzi}</strong><small>${isPrimary ? `Strongest ${generated.deficientElementEnglish} balance with the most complete naming fit.` : `${name.element} imagery with a more specific cultural direction.`}</small></div>`;
    }).join('');
    return `
      <div class="name-verdict-topline">
        <span class="name-verdict-kicker">命名结论 · Naming verdict</span>
        <span class="name-verdict-status">Unlocked · Primary recommendation</span>
      </div>
      <div class="name-verdict-main">
        <div class="name-verdict-identity" aria-label="Recommended name: ${escapeHtml(primary.hanzi)}, ${escapeHtml(primary.pinyin)}">
          <span class="name-verdict-seal han" aria-hidden="true">首选</span>
          <strong class="name-verdict-hanzi han">${primary.hanzi}</strong>
          <span class="name-verdict-pinyin">${primary.pinyin}</span>
          <small>${primary.pronunciation}</small>
        </div>
        <div class="name-verdict-summary">
          <p class="name-verdict-eyeline">Best overall fit for your naming balance</p>
          <h3>The clearest balance of meaning, sound, and destiny symbolism.</h3>
          <p>${primary.meaning} It supports the quality your chart needs most while still reading as a natural, culturally grounded given name.</p>
        </div>
      </div>
      <dl class="name-verdict-signals">
        <div>
          <dt><span>01</span> Element fit</dt>
          <dd><strong>${generated.deficientElementEnglish} · ${generated.deficientElement}</strong><small>Strengthens ${elementPurpose[generated.deficientElementEnglish]}.</small></dd>
        </div>
        <div>
          <dt><span>02</span> Cultural source</dt>
          <dd><strong>${primary.sourceLabel}</strong><small>A traceable traditional reference, not a decorative translation.</small></dd>
        </div>
        <div>
          <dt><span>03</span> Native impression</dt>
          <dd><strong>${primaryImpression}</strong><small>How the name is likely to feel in modern Chinese use.</small></dd>
        </div>
      </dl>
      <div class="name-verdict-comparison">
        <h4>How the three names compare</h4>
        <div>${comparison}</div>
      </div>
      <div class="name-verdict-decision">
        <span class="han" aria-hidden="true">定</span>
        <p><strong>Final choice</strong> Choose <span class="han">${primary.hanzi}</span> when you want the most complete recommendation. The other two names remain strong alternatives for a more seasonal or botanical identity.</p>
      </div>`;
  }

  async function renderNames(state: NameFormState, scroll = true) {
    currentCheckoutState = state;
    const { birthDate, time, englishName, gender } = state;
    const hour = time ? Number(time.split(':')[0]) + Number(time.split(':')[1]) / 60 : undefined;
    const generated = generateChineseNames({
      birthDate,
      birthHour: hour,
      englishName,
      gender,
    });

    try {
      const rawHour = time ? Number(time.split(':')[0]) : null;
      const pillarHour = rawHour === null ? 'unknown' : rawHour === 0 ? '23' : String(Math.floor((rawHour + 1) / 2) * 2 - 1);
      localStorage.setItem('bazi_stepcalc_data', JSON.stringify({
        date: birthDate,
        hour: pillarHour,
        cityName: '',
        cityLon: 0,
        cityLat: 0,
        cityTimezone: 8,
        useSolarTime: false,
        gender: '',
      }));
    } catch {}

    greeting.textContent = englishName ? `${englishName}, meet your Chinese names` : 'Your Chinese given names';
    const basis = time ? 'Your birth chart, read alongside your birth season,' : 'Reading your birth date in its seasonal context';
    elementSummary.textContent = `${basis} shows a clear naming need: strengthen ${generated.deficientElementEnglish} (${generated.deficientElement}) through imagery of ${elementPurpose[generated.deficientElementEnglish]}.`;
    cards.innerHTML = generated.names.map((name) => `
      <article class="name-card">
        <div class="name-plaque">
          <div class="plaque-corner plaque-corner-a" aria-hidden="true"></div>
          <div class="plaque-corner plaque-corner-b" aria-hidden="true"></div>
          <div class="name-rank">${name.inspirationLabel}</div>
          <div class="name-identity">
            <div class="name-hanzi han">${name.hanzi}</div>
            <div class="name-romanization"><h3>${name.pinyin}</h3><p>${name.pronunciation}</p></div>
          </div>
          <span class="name-seal han" aria-hidden="true">名</span>
        </div>
        <div class="name-explanation">
          <p class="name-meaning">${name.meaning}</p>
          <dl class="character-meanings">
            ${name.characters.map((character) => `<div><dt class="han">${character.hanzi}</dt><dd>${character.meaning}</dd></div>`).join('')}
          </dl>
          <div class="source-block">
            <span>${name.sourceLabel}</span>
            <blockquote class="han" lang="zh-CN">${name.sourceQuote}</blockquote>
            <p>${name.sourceNote}</p>
          </div>
          <p class="native-note"><strong>Native-speaker impression</strong>${name.impression}</p>
        </div>
        <button class="copy-name" type="button" data-name="${escapeHtml(name.hanzi)} · ${escapeHtml(name.pinyin)}" aria-label="Copy ${escapeHtml(name.hanzi)}">
          Copy name
        </button>
      </article>
    `).join('');

    nameVerdict.classList.add('is-locked');
    nameVerdict.innerHTML = lockedVerdictHtml();
    results.hidden = false;
    if (scroll) results.scrollIntoView({ behavior: 'smooth', block: 'start' });

    await paymentStatusReady;
    if (isUnlocked('naming')) {
      nameVerdict.classList.remove('is-locked');
      nameVerdict.innerHTML = unlockedVerdictHtml(generated);
    } else {
      trackEvent('view_paywall', {
        product_tier: 'naming',
        currency: 'USD',
        value: 1.99,
        page_path: window.location.pathname,
      });
    }

    trackEvent('generate_chinese_name', {
      tool_name: 'chinese_name',
      result_count: generated.names.length,
      birth_time_provided: Boolean(time),
    });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const state = readFormState();
    if (state) await renderNames(state);
  });

  nameVerdict.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('#unlockNamingBtn');
    if (!button || !currentCheckoutState) return;
    (window as any).__baziUpgrade?.('naming', currentCheckoutState);
  });

  cards.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-name');
    if (!button) return;
    await navigator.clipboard.writeText(button.dataset.name ?? '');
    button.textContent = 'Copied';
    window.setTimeout(() => { button.textContent = 'Copy name'; }, 1400);
  });

  startOver.addEventListener('click', () => {
    results.hidden = true;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  void (async () => {
    const params = new URLSearchParams(window.location.search);
    const completed = params.get('checkout') === 'complete';
    const cancelled = params.get('payment') === 'cancel';
    if (!completed && !cancelled) return;
    if (cancelled) {
      trackEvent('checkout_cancel', {
        product_tier: 'naming',
        currency: 'USD',
        value: 1.99,
      });
    }
    const pending = readPendingCheckout('naming') as Partial<NameFormState> | null;
    if (cancelled) clearPendingCheckout();
    if (!pending?.birthDate || !['neutral', 'feminine', 'masculine'].includes(String(pending.gender))) return;
    const state: NameFormState = {
      birthDate: String(pending.birthDate),
      time: typeof pending.time === 'string' ? pending.time : '',
      englishName: typeof pending.englishName === 'string' ? pending.englishName : '',
      gender: pending.gender as NameGender,
    };
    applyFormState(state);
    if (completed) await getPaymentStatus(true);
    await renderNames(state, false);
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (completed && isUnlocked('naming')) clearPendingCheckout();
  })();
</script>

<style>
  .name-tool { padding: clamp(1.4rem, 4vw, 3rem); }
  .name-intro { max-width: 43rem; margin-inline: auto; text-align: center; }
  .name-intro h1 { font-size: clamp(2.2rem, 5vw, 3.7rem); }
  .name-intro h1 em { color: var(--gold); font-style: italic; }
  .name-intro > p:last-child { margin-top: 1rem; color: var(--bone-dim); }
  .name-form { max-width: 52rem; margin: 2.5rem auto 0; }
  .field-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .field, .choice-group { min-width: 0; }
  .field > span, .field-label, .choice-group legend { display: block; margin-bottom: 0.55rem; color: var(--bone); font-size: 0.82rem; font-weight: 600; letter-spacing: 0; text-transform: none; }
  .field small { color: var(--bone-faint); font-weight: 400; margin-left: 0.25rem; }
  .field > input { width: 100%; min-height: 48px; padding: 0.7rem 0.85rem; color-scheme: dark; border: 1px solid var(--line-strong); border-radius: var(--radius-s); background: var(--ink-2); outline: none; }
  .field > input:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,175,106,.1); }
  .time-field > input:disabled { cursor: not-allowed; opacity: .45; }
  .unknown-time { grid-column: 3; display: inline-flex; align-items: center; justify-self: start; gap: 0.5rem; min-height: 30px; margin-top: -0.5rem; padding: 0.35rem 0.6rem; border: 1px solid var(--line); border-radius: var(--radius-s); background: rgba(212,175,106,.035); color: var(--bone-faint); font-size: 0.68rem; line-height: 1; letter-spacing: 0; text-transform: none; white-space: nowrap; cursor: pointer; }
  .unknown-time input { appearance: none; flex: none; width: 14px; height: 14px; border: 1px solid var(--line-strong); border-radius: 3px; background: var(--ink-1); }
  .unknown-time input:checked { border-color: var(--gold); background: var(--gold); box-shadow: inset 0 0 0 3px var(--ink-1); }
  .unknown-time:hover { color: var(--bone-dim); background: rgba(212,175,106,.04); }
  .prefill-note { margin-top: 0.65rem; color: var(--wood); font-size: 0.72rem; }
  .prefill-note span { margin-right: 0.3rem; }
  .choice-group { border: 0; margin-top: 1.5rem; }
  .segmented { display: grid; gap: 0.6rem; }
  .segmented { grid-template-columns: repeat(3, 1fr); }
  .segmented label { position: relative; cursor: pointer; }
  .segmented input { position: absolute; opacity: 0; pointer-events: none; }
  .segmented span { display: flex; min-height: 48px; padding: 0.72rem 0.8rem; border: 1px solid var(--line); border-radius: var(--radius-s); background: rgba(212,175,106,.035); align-items: center; justify-content: center; text-align: center; transition: border-color .2s, background .2s; }
  .segmented input:checked + span { border-color: var(--gold); background: rgba(212,175,106,.13); color: var(--gold-bright); }
  .segmented input:focus-visible + span { outline: 2px solid var(--gold); outline-offset: 2px; }
  .method-note { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: center; margin-top: 1.5rem; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-s); background: rgba(212,175,106,.04); }
  .method-note > span { color: var(--gold); font-size: 0.86rem; white-space: nowrap; }
  .method-note p { color: var(--bone-dim); font-size: 0.8rem; line-height: 1.55; }
  .method-note strong { color: var(--bone); }
  .generate-btn { display: flex; margin: 1.8rem auto 0; }
  .privacy-note { margin-top: 0.65rem; text-align: center; color: var(--bone-faint); font-size: 0.76rem; }
  .form-error { margin-top: 1rem; text-align: center; color: #f08b80; }
  .name-results { scroll-margin-top: 90px; margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .results-heading { max-width: 42rem; margin: 0 auto 1.8rem; text-align: center; }
  .result-kicker { color: var(--gold); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; }
  .results-heading h2 { margin-top: 0.35rem; font-size: clamp(1.8rem, 4vw, 2.7rem); }
