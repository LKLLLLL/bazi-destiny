  .name-verdict::before { content: ''; position: absolute; top: 0; left: 0; width: 7rem; height: 2px; background: var(--gold); }
  .name-verdict.is-locked { padding-top: 0; border: 1px solid rgba(212,175,106,.32); background: linear-gradient(145deg, rgba(212,175,106,.095), rgba(212,175,106,.02)); }
  .name-verdict.is-locked::before { width: 35%; }
  :global(.name-verdict-lock-main) { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: center; padding: clamp(1.4rem, 4vw, 2.1rem); }
  :global(.name-verdict-lock-seal) { display: grid; width: 4.4rem; height: 4.4rem; place-items: center; border: 1px solid var(--cinnabar); color: var(--cinnabar-light); font-size: 1.65rem; transform: rotate(-3deg); box-shadow: inset 0 0 0 5px rgba(178,59,48,.06); }
  :global(.name-verdict-lock-main h3) { max-width: 35rem; margin: 0.45rem 0 0.6rem; font-size: clamp(1.35rem, 3vw, 1.85rem); line-height: 1.2; }
  :global(.name-verdict-lock-main p) { max-width: 38rem; color: var(--bone-dim); font-size: 0.86rem; line-height: 1.7; }
  :global(.name-verdict-lock-signals) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--line-soft); }
  :global(.name-verdict-lock-signals span) { display: flex; gap: 0.55rem; align-items: center; padding: 0.9rem 1.1rem; border-right: 1px solid var(--line-soft); color: var(--bone-dim); font-size: 0.74rem; font-weight: 600; }
  :global(.name-verdict-lock-signals span:last-child) { border-right: 0; }
  :global(.name-verdict-lock-signals strong) { color: var(--cinnabar-light); font-family: var(--font-display); }
  :global(.name-verdict-lock-action) { display: flex; gap: 0.8rem 1.2rem; align-items: center; justify-content: space-between; padding: 1.15rem clamp(1.4rem, 4vw, 2.1rem); }
  :global(.name-verdict-lock-action small) { color: var(--bone-faint); font-size: 0.7rem; }
  :global(.name-verdict-topline) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 1.35rem; }
  :global(.name-verdict-kicker) { color: var(--cinnabar-light); font-size: 0.64rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  :global(.name-verdict-status) { color: var(--gold); font-size: 0.66rem; font-weight: 700; text-transform: uppercase; }
