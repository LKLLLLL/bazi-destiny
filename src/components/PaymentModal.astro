---
// Shared payment modal for paid reports and personalized verdicts.
---

<div class="pay-modal" id="paymentModal" hidden role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="pay-modal-card">
    <button class="pay-modal-close" id="modalClose" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 2l12 12M14 2L2 14"/></svg>
    </button>
    <div class="pay-modal-seal" aria-hidden="true">印</div>
    <h3 id="modalTitle">Unlock Life Blueprint</h3>
    <p id="modalDesc" class="pay-modal-desc"></p>
    <div id="modalPrice" class="pay-modal-price"></div>
    <div id="modalFeatures" class="pay-modal-features"></div>
    <button class="btn btn-gold btn-lg btn-full" id="checkoutBtn">Pay &amp; Unlock</button>
    <p class="pay-modal-note" id="checkoutNote" aria-live="polite">Secure checkout via PayPal · One-time payment, yours forever</p>
  </div>
</div>

<style>
  .pay-modal:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: rgba(4, 5, 10, 0.78);
    backdrop-filter: blur(8px);
    animation: fadeIn 0.25s ease;
    overscroll-behavior: contain;
    touch-action: none;
  }
  :global(html.pay-modal-open) { overscroll-behavior: none; }
  @keyframes fadeIn { from { opacity: 0; } }
  .pay-modal-card {
    position: relative;
    width: min(430px, 100%);
    max-height: min(85vh, calc(100dvh - 2.5rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
    background: linear-gradient(170deg, var(--ink-2), var(--ink-1));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 2.2rem 1.8rem 1.8rem;
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.9), var(--glow-gold);
    animation: riseIn 0.35s var(--ease-out);
    text-align: center;
  }
  @keyframes riseIn { from { opacity: 0; transform: translateY(18px) scale(0.98); } }
  .pay-modal-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--bone-faint);
    border: 1px solid var(--line-soft);
    transition: color 0.25s, border-color 0.25s;
  }
  .pay-modal-close:hover { color: var(--bone); border-color: var(--line-strong); }
  .pay-modal-seal {
    width: 52px;
    height: 52px;
    margin: 0 auto 1.1rem;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(155deg, #e86050, var(--cinnabar) 45%, var(--cinnabar-deep));
    color: #fdf6ec;
    font-family: var(--font-han);
    font-size: 1.5rem;
    transform: rotate(-3deg);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14), 0 10px 24px -8px rgba(224, 87, 74, 0.6);
  }
  .pay-modal-card h3 { font-size: 1.7rem; margin-bottom: 0.6rem; }
  .pay-modal-desc { color: var(--bone-dim); font-size: 0.95rem; margin-bottom: 1.2rem; }
  .pay-modal-price {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--gold-bright);
    margin-bottom: 1.2rem;
  }
  .pay-modal-price small { font-size: 1rem; color: var(--bone-faint); font-weight: 400; font-family: var(--font-body); }
  .pay-modal-features {
    text-align: left;
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.2rem;
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-s);
    font-size: 0.9rem;
    color: var(--bone-dim);
  }
  .pay-modal-note { margin-top: 0.9rem; font-size: 0.78rem; color: var(--bone-faint); }
</style>

<script>
  import { PAYPAL_PRODUCTS, startCheckout, TEMPORARY_FREE_ACCESS, type Tier } from '../lib/paypal';
  import { trackEvent } from '../lib/analytics';

  const modal = document.getElementById('paymentModal');
  const title = document.getElementById('modalTitle');
  const desc = document.getElementById('modalDesc');
  const price = document.getElementById('modalPrice');
  const features = document.getElementById('modalFeatures');
  const checkoutBtn = document.getElementById('checkoutBtn') as HTMLButtonElement | null;
  const checkoutNote = document.getElementById('checkoutNote');
  let selectedTier: Tier = 'pro';
  let pendingReading: unknown = null;
  let lockedScrollY = 0;
  let scrollLocked = false;
  let returnFocus: HTMLElement | null = null;
  const bodyStyle = {
    position: '',
    top: '',
    left: '',
    right: '',
    width: '',
    overflow: '',
  };

  function lockPage() {
    if (scrollLocked) return;
    const body = document.body;
    lockedScrollY = window.scrollY;
    bodyStyle.position = body.style.position;
    bodyStyle.top = body.style.top;
    bodyStyle.left = body.style.left;
    bodyStyle.right = body.style.right;
    bodyStyle.width = body.style.width;
    bodyStyle.overflow = body.style.overflow;
    body.style.position = 'fixed';
    body.style.top = `-${lockedScrollY}px`;
    body.style.left = '0';
    body.style.right = '0';
    body.style.width = '100%';
    body.style.overflow = 'hidden';
    document.documentElement.classList.add('pay-modal-open');
    scrollLocked = true;
  }

  function unlockPage() {
    if (!scrollLocked) return;
    const body = document.body;
    body.style.position = bodyStyle.position;
    body.style.top = bodyStyle.top;
    body.style.left = bodyStyle.left;
    body.style.right = bodyStyle.right;
    body.style.width = bodyStyle.width;
    body.style.overflow = bodyStyle.overflow;
    document.documentElement.classList.remove('pay-modal-open');
    window.scrollTo(0, lockedScrollY);
    scrollLocked = false;
  }

  const COPY: Record<Tier, { title: string; desc: string; price: string; features: string[]; btn: string }> = {
    pro: {
      title: 'Unlock Life Blueprint',
      desc: 'The complete BaZi reading — Career, Wealth, Relationships, Health, personalized Feng Shui guidance, and daily alignment practices.',
      price: '$9.90 <small>one-time</small>',
      features: [
        '✓ Full 12-section BaZi reading',
        '✓ Personalized Feng Shui analysis',
        '✓ Lucky numbers, colors & directions',
        '✓ Yours forever — one-time payment',
      ],
      btn: 'Pay $9.90 — Unlock Now',
    },
    synergy: {
      title: 'Unlock Synergy Boost Guide',
      desc: '',
      price: '',
      features: [
        '✓ Morning Ritual — daily sync practice',
        '✓ Communication Style — speak each other\'s language',
        '✓ Shared Activities — co-create and bond deeper',
        '✓ Home Energy — optimize your shared space',
        '✓ Conflict Resolution — cool down and reconnect',
      ],
      btn: 'Pay $4.90 — Unlock Now',
    },
    naming: {
      title: 'Unlock Your Best Chinese Name',
      desc: 'Reveal which of your three names offers the strongest overall balance of BaZi symbolism, meaning, pronunciation, and modern Chinese usage.',
      price: '$1.99 <small>one-time</small>',
      features: [
        '✓ One clear primary recommendation',
        '✓ Element-balance reasoning',
        '✓ Cultural-source assessment',
        '✓ Native-speaker usage verdict',
      ],
      btn: 'Pay $1.99 — Reveal My Best Name',
    },
  };

  function openFreeAccess(tier: Tier, reading?: unknown) {
    if (tier === 'pro') {
      window.location.assign('/calculator.html');
      return;
    }
    if (tier === 'naming') {
      window.location.assign('/chinese-name.html?checkout=complete');
      return;
    }
    if (!reading || typeof reading !== 'object') {
      window.location.assign('/love-match.html');
      return;
    }
    const value = reading as Record<string, unknown>;
    const query = new URLSearchParams({
      n1: String(value.n1 || 'Person 1'),
      n2: String(value.n2 || 'Person 2'),
      e1: String(value.e1 || 'Wood'),
      e2: String(value.e2 || 'Fire'),
    });
    window.location.assign(`/synergy-guide.html?${query}`);
  }

  function open(tier: Tier, reading?: unknown) {
    if (TEMPORARY_FREE_ACCESS) {
      openFreeAccess(tier, reading);
      return;
    }
    returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    selectedTier = tier;
    if (reading) pendingReading = reading;
    const c = COPY[tier];
    if (title) title.textContent = c.title;
    if (desc) { desc.style.display = c.desc ? '' : 'none'; desc.textContent = c.desc; }
    if (price) { price.style.display = c.price ? '' : 'none'; price.innerHTML = c.price; }
    if (features) features.innerHTML = c.features.map((f) => `<div>${f}</div>`).join('');
    if (checkoutBtn) checkoutBtn.innerHTML = `💳 ${c.btn}`;
    if (checkoutBtn) checkoutBtn.disabled = false;
    if (checkoutNote) checkoutNote.textContent = 'Secure checkout via PayPal · One-time payment, yours forever';
    if (modal) {
      lockPage();
      modal.hidden = false;
      requestAnimationFrame(() => document.getElementById('modalClose')?.focus());
    }
  }
  function close() {
    if (modal) modal.hidden = true;
    unlockPage();
    returnFocus?.focus();
    returnFocus = null;
  }

  (window as any).__baziUpgrade = (tier: Tier, reading?: unknown) => open(tier, reading);
  (window as any).__baziSetPendingReading = (reading: unknown) => { pendingReading = reading; };

  checkoutBtn?.addEventListener('click', async () => {
    const product = PAYPAL_PRODUCTS[selectedTier];
    const value = Number(product.price);
    const item = { item_id: product.itemId, item_name: product.name, price: value, quantity: 1 };
    trackEvent('click_payment', {
      product_tier: selectedTier,
      currency: 'USD',
      value,
    });
    trackEvent('begin_checkout', {
      currency: 'USD',
      value,
      items: [item],
    });
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Opening PayPal...';
    if (checkoutNote) checkoutNote.textContent = 'Creating a secure order...';
    try {
      await startCheckout(selectedTier, pendingReading);
    } catch (error) {
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = `💳 ${COPY[selectedTier].btn}`;
      if (checkoutNote) checkoutNote.textContent = error instanceof Error ? error.message : 'Checkout is temporarily unavailable.';
    }
  });
  document.getElementById('modalClose')?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>
