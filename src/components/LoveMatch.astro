---
interface Props {
  /** compact = teaser on home; full = standalone page */
  variant?: 'full';
  lang?: 'en' | 'zh';
}
const { variant = 'full', lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const hourOptions = [
  [23, '23:00 – 00:59 · 子时 Rat'], [1, '01:00 – 02:59 · 丑时 Ox'], [3, '03:00 – 04:59 · 寅时 Tiger'],
  [5, '05:00 – 06:59 · 卯时 Rabbit'], [7, '07:00 – 08:59 · 辰时 Dragon'], [9, '09:00 – 10:59 · 巳时 Snake'],
  [11, '11:00 – 12:59 · 午时 Horse'], [13, '13:00 – 14:59 · 未时 Goat'], [15, '15:00 – 16:59 · 申时 Monkey'],
  [17, '17:00 – 18:59 · 酉时 Rooster'], [19, '19:00 – 20:59 · 戌时 Dog'], [21, '21:00 – 22:59 · 亥时 Pig'],
] as const;
---

<div class="lovematch panel" data-lovematch data-variant={variant} data-lang={lang}>
  <form class="lm-form" novalidate>
    <div class="lm-pair">
      <fieldset class="lm-person">
        <legend><span class="lm-dot p1"></span> {isZh ? '你' : 'Person One'}</legend>
        <div class="field">
          <label>{isZh ? '姓名' : 'Name'}</label>
          <input class="input" type="text" name="name1" placeholder={isZh ? '你的名字（可不填）' : 'First name'} maxlength="30" />
        </div>
        <div class="field">
          <label>{isZh ? '出生日期' : 'Birth Date'}</label>
          <input class="input" type="date" name="date1" min="1900-01-01" max="2030-12-31" />
        </div>
        <div class="field">
          <label>{isZh ? '出生时辰' : 'Birth Hour'}</label>
          <select class="select" name="hour1">
            <option value="">{isZh ? '选择时辰…' : 'Select hour…'}</option>
            {hourOptions.map(([v, label]) => <option value={v}>{isZh ? label.replace(/\s[A-Za-z]+$/, '') : label}</option>)}
          </select>
        </div>
      </fieldset>

      <div class="lm-heart" aria-hidden="true">
        <svg viewBox="0 0 32 30" width="30" height="28"><path d="M16 28S2 19.6 2 10.3C2 5 6 2 10 2c2.6 0 4.7 1.3 6 3.3C17.3 3.3 19.4 2 22 2c4 0 8 3 8 8.3C30 19.6 16 28 16 28z" fill="none" stroke="#e0574a" stroke-width="1.6"/></svg>
      </div>

      <fieldset class="lm-person">
        <legend><span class="lm-dot p2"></span> {isZh ? '对方' : 'Person Two'}</legend>
        <div class="field">
          <label>{isZh ? '姓名' : 'Name'}</label>
          <input class="input" type="text" name="name2" placeholder={isZh ? '对方名字（可不填）' : 'First name'} maxlength="30" />
        </div>
        <div class="field">
          <label>{isZh ? '出生日期' : 'Birth Date'}</label>
          <input class="input" type="date" name="date2" min="1900-01-01" max="2030-12-31" />
        </div>
        <div class="field">
          <label>{isZh ? '出生时辰' : 'Birth Hour'}</label>
          <select class="select" name="hour2">
            <option value="">{isZh ? '选择时辰…' : 'Select hour…'}</option>
            {hourOptions.map(([v, label]) => <option value={v}>{isZh ? label.replace(/\s[A-Za-z]+$/, '') : label}</option>)}
          </select>
        </div>
      </fieldset>
    </div>

    <button type="submit" class="btn btn-love btn-lg btn-full lm-submit">
      {isZh ? '查看两人的合婚结果' : 'Test Our Compatibility'}
      <span class="han" aria-hidden="true">合八字</span>
    </button>
    <p class="lm-note">{isZh ? '无需注册 · 即时生成 · 出生信息不会保存' : 'No account needed · Results in seconds · Nothing is stored'}</p>
  </form>

  <div class="lm-results" hidden></div>

  <!-- Dynamically injected by JS after results -->
  <div id="lmExtras"></div>
</div>

<style>
  .lovematch { padding: clamp(1.4rem, 4vw, 2.4rem); }
  .lm-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.2rem;
    align-items: center;
  }
  @media (max-width: 680px) {
    .lm-pair { grid-template-columns: 1fr; }
    .lm-heart { transform: rotate(90deg); }
  }
  .lm-person {
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 1.2rem 1.2rem 1.3rem;
    display: grid;
    gap: 0.9rem;
    background: var(--ink-1);
  }
  .lm-person legend {
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .lm-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .lm-dot.p1 { background: var(--gold); box-shadow: 0 0 10px var(--gold); }
  .lm-dot.p2 { background: var(--cinnabar); box-shadow: 0 0 10px var(--cinnabar); }
  .lm-heart { display: grid; place-items: center; }
  .lm-submit { margin-top: 1.4rem; }
  .lm-note { text-align: center; margin-top: 0.8rem; font-size: 0.78rem; color: var(--bone-faint); }

  /* results */
  .lm-results { margin-top: 1.6rem; }
  .lm-score-hero {
    text-align: center;
    padding: 1.6rem 1rem 1.8rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .lm-score-hero .tier {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    margin-top: 0.4rem;
  }
  .lm-pair-names { margin-top: 0.6rem; color: var(--bone); font-weight: 600; letter-spacing: 0.02em; }
  .lm-dayline { margin-top: 0.5rem; color: var(--bone-faint); font-size: 0.88rem; font-style: italic; }

  .lm-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin: 1.2rem 0; }
  @media (max-width: 640px) { .lm-grid3 { grid-template-columns: 1fr; } }
  .lm-mini {
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-s);
    padding: 1rem;
    text-align: center;
  }
  .lm-mini .k { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bone-faint); }
  .lm-mini .v { font-family: var(--font-display); font-size: 1.7rem; margin: 0.25rem 0; }
  .lm-mini .d { font-size: 0.78rem; color: var(--bone-dim); }

  .lm-block {
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    margin-bottom: 1rem;
  }
  .lm-block h5 { font-family: var(--font-display); font-size: 1.2rem; margin-bottom: 0.4rem; }
  .lm-block .sub { font-size: 0.8rem; color: var(--bone-faint); margin-bottom: 1rem; }

  .lm-dp-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; }
  @media (max-width: 560px) { .lm-dp-row { grid-template-columns: 1fr; } }
  .dp-card { text-align: center; padding: 1rem; border: 1px solid var(--line-soft); border-radius: var(--radius-s); }
  .dp-card .who { font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bone-faint); display: block; margin-bottom: 0.5rem; }
  .dp-card .stem { display: block; font-family: var(--font-display); font-size: 1.3rem; color: var(--bone); }
  .dp-card .branch { display: block; font-size: 0.85rem; color: var(--bone-dim); margin-top: 0.15rem; }
  .dp-card .elem { display: inline-block; margin-top: 0.55rem; font-size: 0.72rem; font-weight: 700; padding: 0.15rem 0.65rem; border-radius: 999px; }
  .lm-vs { color: var(--cinnabar); font-family: var(--font-display); font-size: 1.4rem; text-align: center; }

  .hbadges { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.9rem; }
  .hbadge { font-size: 0.76rem; padding: 0.3rem 0.75rem; border-radius: 999px; border: 1px solid; }
  .hbadge.good { color: var(--wood); border-color: color-mix(in srgb, var(--wood) 45%, transparent); background: color-mix(in srgb, var(--wood) 9%, transparent); }
  .hbadge.warn { color: var(--fire); border-color: color-mix(in srgb, var(--fire) 45%, transparent); background: color-mix(in srgb, var(--fire) 9%, transparent); }

  .lm-tips { display: grid; gap: 0.6rem; }
  .lm-tip { display: flex; gap: 0.65rem; font-size: 0.9rem; color: var(--bone-dim); }
  .lm-tip .ico { color: var(--gold); flex: none; }

  .lm-share {
    text-align: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem 1.6rem;
    background: linear-gradient(170deg, rgba(224, 87, 74, 0.06), transparent 60%), var(--ink-1);
    margin-bottom: 1.2rem;
  }
  .lm-share-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }
  .lm-share-actions .btn { padding-left: 1.5rem; padding-right: 1.5rem; }
  .lm-board {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    background: var(--ink-1);
    flex-wrap: wrap;
  }
  .lm-board .trophy { font-size: 1.6rem; }
  .lm-board .txt { flex: 1; min-width: 200px; font-size: 0.88rem; color: var(--bone-dim); }
  .lm-board .txt strong { color: var(--bone); display: block; font-size: 0.95rem; margin-bottom: 0.15rem; }

  .lm-board-section, .lm-synergy-section { margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid var(--line-soft); }
  .lm-board-section.is-hidden, .lm-synergy-section.is-hidden { display: none; }

  .lm-paywall {
    margin-top: 1.2rem;
    padding: 1.8rem 1.6rem;
    text-align: center;
    border: 1px dashed rgba(224, 87, 74, 0.35);
    border-radius: var(--radius);
    background: linear-gradient(170deg, rgba(224, 87, 74, 0.05), transparent 60%), var(--ink-1);
  }
  .lm-paywall-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .lm-paywall h5 { font-family: var(--font-display); font-size: 1.2rem; margin-bottom: 0.5rem; }
  .lm-paywall p { color: var(--bone-dim); font-size: 0.88rem; max-width: 44ch; margin: 0 auto 1.2rem; }

  .lm-synergy { margin-top: 1.2rem; padding-top: 1.2rem; border-top: 1px solid var(--line-soft); }
  .lm-synergy.is-hidden { display: none; }
  .lm-synergy h5 { font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 1rem; }
  .lm-synergy-grid { display: grid; gap: 0.8rem; }
  .lm-syn-card {
    display: flex; gap: 0.8rem;
    padding: 1rem;
    border-radius: var(--radius-s);
    background: var(--ink-1);
    border: 1px solid var(--line-soft);
  }
  .lm-syn-icon { font-size: 1.3rem; flex: none; }
  .lm-syn-card h6 { font-size: 0.85rem; color: var(--gold-bright); margin-bottom: 0.25rem; }
  .lm-syn-card p { font-size: 0.82rem; color: var(--bone-dim); line-height: 1.6; }
</style>

<script>
  import BaZiEngine from '../lib/bazi/engine';
  import Compatibility from '../lib/bazi/compatibility';
  import { scoreRing, ELEM_EN, ELEM_COLOR, STEM_EN, BRANCH_EN } from '../lib/charts';
  import { showToast } from '../lib/toast';

  document.querySelectorAll<HTMLElement>('[data-lovematch]').forEach((root) => {
    const isZh = root.dataset.lang === 'zh';
    const form = root.querySelector<HTMLFormElement>('.lm-form');
    const results = root.querySelector<HTMLElement>('.lm-results');
    if (!form || !results) return;

    // --- inline validation helpers ---
    function clearErrors() {
      form?.querySelectorAll('.field-error').forEach((el) => el.remove());
      form?.querySelectorAll('.input.error, .select.error, .input.valid, .select.valid').forEach((el) => {
        el.classList.remove('error', 'valid');
      });
      form?.classList.remove('shake');
    }

    function showErr(input: HTMLInputElement | HTMLSelectElement, msg: string) {
      const field = input.closest('.field');
      if (!field) return;
      field.querySelector('.field-error')?.remove();
      input.classList.remove('valid');
      input.classList.add('error');
      const err = document.createElement('div');
      err.className = 'field-error';
      err.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 7.5v5"/><circle cx="12" cy="16.2" r="0.4" fill="currentColor"/></svg>${msg}`;
      field.appendChild(err);
      input.addEventListener('input', () => clearErrors(), { once: true });
      input.addEventListener('change', () => clearErrors(), { once: true });
    }

    function markValid(input: HTMLInputElement | HTMLSelectElement) {
      input.classList.remove('error');
      input.classList.add('valid');
    }

    // real-time validation on blur
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[type="date"], select').forEach((el) => {
      el.addEventListener('blur', () => {
        const v = el.value;
        if (el.tagName === 'SELECT' && v === '') {
          showErr(el, isZh ? '请选择出生时辰' : 'Birth hour is required');
        } else if (el.type === 'date' && !v) {
          showErr(el, isZh ? '请填写出生日期' : 'Birth date is required');
        } else {
          if (el.type === 'date' && v) {
            const d = new Date(v + 'T00:00:00');
            if (d < new Date('1900-01-01') || d > new Date('2030-12-31')) {
              showErr(el, isZh ? '日期须在 1900 至 2030 年之间' : 'Date must be 1900–2030');
            } else {
              markValid(el);
            }
          } else if (el.tagName === 'SELECT' && v !== '') {
            markValid(el);
          }
        }
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearErrors();
      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement)?.value ?? '';
      const name1 = val('name1').trim() || (isZh ? '你' : 'You');
      const name2 = val('name2').trim() || (isZh ? '对方' : 'Partner');
      const date1 = val('date1'), date2 = val('date2');
      const hour1 = val('hour1'), hour2 = val('hour2');

      let hasErr = false;
      if (!date1) {
        showErr(form.elements.namedItem('date1') as HTMLInputElement, isZh ? '请填写出生日期' : 'Birth date is required');
        hasErr = true;
      }
      if (hour1 === '') {
        showErr(form.elements.namedItem('hour1') as HTMLSelectElement, isZh ? '请选择出生时辰' : 'Birth hour is required');
        hasErr = true;
      }
      if (!date2) {
        showErr(form.elements.namedItem('date2') as HTMLInputElement, isZh ? '请填写出生日期' : 'Birth date is required');
        hasErr = true;
      }
      if (hour2 === '') {
        showErr(form.elements.namedItem('hour2') as HTMLSelectElement, isZh ? '请选择出生时辰' : 'Birth hour is required');
        hasErr = true;
      }
      if (hasErr) {
        form.classList.add('shake');
        setTimeout(() => form.classList.remove('shake'), 500);
        return;
      }
      // Redirect to result page with data in URL
      var params = new URLSearchParams();
      params.set('n1', name1); params.set('d1', date1); params.set('h1', hour1);
      params.set('n2', name2); params.set('d2', date2); params.set('h2', hour2);
      window.location.href = (isZh ? '/zh/love-match-result.html?' : '/love-match-result.html?') + params.toString();
    });
  });
</script>
