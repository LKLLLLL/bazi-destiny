---
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<span class="seal" style={`--seal-size:${size}px`} aria-hidden="true">
  <span class="seal-han">八<br />字</span>
</span>

<style>
  .seal {
    display: inline-grid;
    place-items: center;
    width: var(--seal-size);
    height: var(--seal-size);
    border-radius: 6px;
    background: linear-gradient(155deg, #e86050, var(--cinnabar) 45%, var(--cinnabar-deep));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      inset 0 -6px 12px rgba(90, 16, 8, 0.45),
      0 6px 18px -6px rgba(224, 87, 74, 0.5);
    transform: rotate(-2deg);
    flex: none;
  }
  .seal-han {
    font-family: var(--font-han);
    font-weight: 600;
    font-size: calc(var(--seal-size) * 0.34);
    line-height: 1.02;
    color: #fdf6ec;
    text-align: center;
    text-shadow: 0 1px 2px rgba(90, 16, 8, 0.55);
    letter-spacing: 0.02em;
  }
</style>
