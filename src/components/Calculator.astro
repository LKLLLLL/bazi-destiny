---
// Embedded BaZi calculator — form → casting ritual → full reading.
---

<section class="section calc-section" id="calculator" aria-label="BaZi calculator">
  <div class="wrap">
    <div class="section-head center" data-reveal>
      <p class="eyebrow center"><span class="han">排盘</span> The Calculator</p>
      <h2 class="section-title">Cast Your <em>Four Pillars</em></h2>
      <p class="section-sub">Your birth moment, mapped onto the classical Chinese calendar. Free, instant, no sign-up.</p>
    </div>

    <div class="calc-shell panel" data-reveal>
      <!-- ======== form ======== -->
      <form class="calc-form" id="calcForm" novalidate>
        <div class="calc-form-head">
          <span class="vertical-han" aria-hidden="true">生辰八字</span>
          <div>
            <h3>Your Birth Details</h3>
            <p class="calc-form-sub">Everything stays in your browser — we never store birth data.</p>
          </div>
        </div>

        <div class="calc-grid">
          <div class="field">
            <label for="userName">Name <span class="opt">optional</span></label>
            <input class="input" type="text" id="userName" placeholder="How should we address you?" maxlength="50" />
          </div>
          <div class="field">
            <label for="birthDate">Birth Date</label>
            <input class="input" type="date" id="birthDate" required min="1900-01-01" max="2030-12-31" />
          </div>
          <div class="field">
            <label for="birthHour">Birth Hour <span class="opt">时辰</span></label>
            <select class="select" id="birthHour" required>
              <option value="">Select hour…</option>
              <option value="23">23:00 – 00:59 · 子时 Rat</option>
              <option value="1">01:00 – 02:59 · 丑时 Ox</option>
              <option value="3">03:00 – 04:59 · 寅时 Tiger</option>
              <option value="5">05:00 – 06:59 · 卯时 Rabbit</option>
              <option value="7">07:00 – 08:59 · 辰时 Dragon</option>
              <option value="9">09:00 – 10:59 · 巳时 Snake</option>
              <option value="11">11:00 – 12:59 · 午时 Horse</option>
              <option value="13">13:00 – 14:59 · 未时 Goat</option>
              <option value="15">15:00 – 16:59 · 申时 Monkey</option>
              <option value="17">17:00 – 18:59 · 酉时 Rooster</option>
              <option value="19">19:00 – 20:59 · 戌时 Dog</option>
              <option value="21">21:00 – 22:59 · 亥时 Pig</option>
            </select>
          </div>
          <div class="field">
            <label for="userGender">Gender</label>
            <select class="select" id="userGender">
              <option value="female">Female</option>
              <option value="male">Male</option>
              <option value="other">Prefer not to say</option>
            </select>
          </div>
          <div class="field calc-span-2">
            <label for="birthLocation">Birth Place <span class="opt">optional · for Feng Shui</span></label>
            <input class="input" type="text" id="birthLocation" placeholder="City, Country" maxlength="100" />
          </div>
        </div>

        <div class="calc-note">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 7.5v5"/><circle cx="12" cy="16.2" r="0.4" fill="currentColor"/></svg>
          <span><strong>The hour matters.</strong> BaZi accuracy depends on the exact two-hour shichen — pick the closest you know.</span>
        </div>

        <button type="submit" class="btn btn-gold btn-lg btn-full">
          Reveal My Chart
          <span class="han" aria-hidden="true">排盘</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>

      <!-- ======== casting ritual ======== -->
      <div class="calc-loading" id="calcLoading" hidden aria-live="polite">
        <svg class="bagua" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="46" fill="none" stroke="rgba(212,175,106,0.25)" stroke-width="1" />
          <g class="bagua-spin">
            {Array.from({ length: 8 }).map((_, i) => (
              <g transform={`rotate(${i * 45} 50 50)`}>
                <rect x="44" y="6" width="12" height="3" rx="1" fill="#d4af6a" opacity="0.9" />
                <rect x="44" y="11" width="12" height="3" rx="1" fill="#d4af6a" opacity={i % 2 ? 0.35 : 0.9} />
                <rect x="44" y="16" width="12" height="3" rx="1" fill="#d4af6a" opacity={i % 3 ? 0.9 : 0.35} />
              </g>
            ))}
          </g>
          <circle cx="50" cy="50" r="17" fill="none" stroke="#d4af6a" stroke-width="1.2" />
          <path d="M50 33a17 17 0 0 1 0 34 8.5 8.5 0 0 1 0-17 8.5 8.5 0 0 0 0-17z" fill="#d4af6a" opacity="0.85" />
          <circle cx="50" cy="41.5" r="2.6" fill="#0b0d17" />
          <circle cx="50" cy="58.5" r="2.6" fill="#d4af6a" />
        </svg>
        <ol class="cast-steps">
          <li data-step="0"><span class="han">排四柱</span> Casting the Four Pillars</li>
          <li data-step="1"><span class="han">量五行</span> Weighing the Five Elements</li>
          <li data-step="2"><span class="han">定日主</span> Reading the Day Master</li>
          <li data-step="3"><span class="han">起风水</span> Aligning your Feng Shui</li>
        </ol>
      </div>

      <!-- ======== results ======== -->
      <div class="calc-results" id="calcResults" hidden aria-live="polite">
        <div class="results-head">
          <p class="eyebrow"><span class="han">你的命盘</span> Your Reading</p>
          <h3 class="results-greeting" id="resultGreeting"></h3>
          <p class="results-sub" id="resultSubtitle"></p>
        </div>

        <div class="pillars-grid" id="pillarsGrid"></div>
        <div class="pillar-strength" id="pillarStrength"></div>

        <div class="results-duo">
          <div class="panel inset chart-panel">
            <h4>Five Elements · <span class="han">五行</span></h4>
            <div class="donut-wrap" id="elemDonut"></div>
          </div>
          <div class="panel inset">
            <h4>Elemental Balance</h4>
            <div class="ebars" id="elemBars"></div>
            <div class="elem-highlights" id="elemHighlights"></div>
          </div>
        </div>

        <div class="panel inset reading-card" id="cardPersonality">
          <div class="reading-head">
            <h4>Personality &amp; Day Master <span class="badge-free">Free</span></h4>
          </div>
          <div class="reading-body" id="readingPersonality"></div>
        </div>

        <div class="panel inset reading-card" id="cardLuckyFree">
          <div class="reading-head">
            <h4>Lucky Directions <span class="badge-free">Free</span></h4>
          </div>
          <div class="lucky-free-grid">
            <div id="luckyCompassMini" class="lucky-compass"></div>
            <div class="reading-body" id="luckyDirections"></div>
          </div>
        </div>

        <!-- paywall -->
        <div class="paywall" id="paywallCard">
          <div class="paywall-seal" aria-hidden="true">封</div>
          <h4>The deeper reading is sealed</h4>
          <p>Career &amp; Wealth, Relationships, Health, your full Feng Shui compass and a PDF report — unlocked once, yours forever.</p>
          <div class="paywall-actions">
            <button class="btn btn-gold" id="unlockProBtn">Unlock Destiny Master — $9.90</button>
            <button class="btn btn-ghost" id="unlockUltBtn">Soul Guide — $29.90</button>
          </div>
        </div>

        <!-- pro content -->
        <div class="pro-grid" id="proGrid" hidden>
          <div class="panel inset reading-card" id="cardCareer">
            <div class="reading-head"><h4>Career &amp; Wealth <span class="han">事业</span></h4></div>
            <div class="reading-body" id="readingCareer"></div>
          </div>
          <div class="panel inset reading-card" id="cardRelationships">
            <div class="reading-head"><h4>Love &amp; Relationships <span class="han">姻缘</span></h4></div>
            <div class="reading-body" id="readingRelationships"></div>
          </div>
          <div class="panel inset reading-card" id="cardHealth">
            <div class="reading-head"><h4>Health &amp; Energy <span class="han">健康</span></h4></div>
            <div class="reading-body" id="readingHealth"></div>
          </div>
          <div class="panel inset reading-card" id="cardLuckyPro">
            <div class="reading-head"><h4>Your Lucky Kit <span class="han">开运</span></h4></div>
            <div class="reading-body" id="luckyProGrid"></div>
          </div>
          <div class="panel inset reading-card pro-span" id="cardFengShui">
            <div class="reading-head"><h4>Personal Feng Shui <span class="han">风水</span></h4></div>
            <div class="fengshui-grid">
              <div class="reading-body">
                <div id="readingFengShui"></div>
                <div id="fshuiTips" class="fshui-tips"></div>
              </div>
              <div id="fengShuiCompass" class="lucky-compass big"></div>
            </div>
          </div>
        </div>

        <div class="results-actions">
          <button class="btn btn-ghost" id="shareBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
            Share Reading
          </button>
          <a class="btn btn-ghost" id="twitterShare" target="_blank" rel="noopener">Post on X</a>
          <a class="btn btn-ghost" id="facebookShare" target="_blank" rel="noopener">Facebook</a>
          <a class="btn btn-ghost" id="whatsappShare" target="_blank" rel="noopener">WhatsApp</a>
          <button class="btn btn-ghost" id="pdfBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            PDF Report
          </button>
          <button class="btn btn-ghost" id="recastBtn">Cast Another Chart</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .calc-section { scroll-margin-top: 84px; }
  .calc-shell {
    max-width: 860px;
    margin-inline: auto;
    padding: clamp(1.4rem, 4vw, 2.6rem);
    overflow: hidden;
  }

  /* form */
  .calc-form-head {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    margin-bottom: 1.6rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .calc-form-head h3 { font-size: 1.55rem; }
  .calc-form-sub { color: var(--bone-faint); font-size: 0.85rem; margin-top: 0.3rem; }
  .vertical-han { font-size: 0.85rem; height: 5.5rem; padding-top: 0.2rem; }

  .calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem 1.2rem;
  }
  .calc-span-2 { grid-column: span 2; }
  @media (max-width: 620px) {
    .calc-grid { grid-template-columns: 1fr; }
    .calc-span-2 { grid-column: auto; }
  }

  .calc-note {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 1.3rem 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-s);
    color: var(--bone-dim);
    font-size: 0.86rem;
    background: rgba(212, 175, 106, 0.04);
  }
  .calc-note svg { flex: none; margin-top: 0.2rem; color: var(--gold); }
  .calc-note strong { color: var(--bone); }

  /* loading */
  .calc-form {
    transition: opacity 0.35s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .calc-form[hidden] {
    display: block;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    position: absolute;
    visibility: hidden;
  }

  .calc-loading { display: grid; place-items: center; gap: 2rem; padding: 2.5rem 0; }
  .calc-loading[hidden] { display: none; }
  .calc-loading.is-entering {
    animation: loadIn 0.45s var(--ease-out);
  }
  @keyframes loadIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  .bagua { width: 110px; height: 110px; }
  .bagua-spin { transform-origin: 50px 50px; animation: spin 14s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .cast-steps { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .cast-steps li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--bone-faint);
    font-size: 0.92rem;
    opacity: 0.3;
    transform: translateX(8px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out), color 0.5s;
  }
  .cast-steps li.active {
    opacity: 1;
    transform: none;
    color: var(--gold-bright);
    text-shadow: 0 0 18px rgba(212, 175, 106, 0.3);
  }
  .cast-steps li.active .han {
    color: var(--gold);
    text-shadow: 0 0 12px rgba(212, 175, 106, 0.5);
  }
  .cast-steps li .han { font-size: 0.8rem; color: var(--gold-deep); width: 3.2rem; transition: color 0.5s, text-shadow 0.5s; }
  .cast-steps li.done {
    opacity: 0.65;
    color: var(--bone-dim);
  }
  .cast-steps li.done .han {
    color: var(--gold);
  }

  /* results */
  .calc-results[hidden] { display: none; }
  .calc-results {
    animation: resIn 0.5s var(--ease-out);
  }
  @keyframes resIn {
    from { opacity: 0; transform: translateY(14px); }
  }
  .results-head { text-align: center; margin-bottom: 2rem; }
  .results-head .eyebrow { justify-content: center; display: inline-flex; }
  .results-greeting { font-size: clamp(1.7rem, 3.4vw, 2.3rem); }
  .results-sub { color: var(--bone-dim); margin-top: 0.7rem; max-width: 56ch; margin-inline: auto; font-size: 0.95rem; }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    margin-bottom: 1.6rem;
  }
  @media (max-width: 620px) { .pillars-grid { grid-template-columns: repeat(2, 1fr); } }

  .stele {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 1.1rem 0.5rem 1rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background: var(--ink-1);
    animation: steleIn 0.7s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes steleIn { from { opacity: 0; transform: translateY(16px); } }
  .stele.day { border-color: var(--gold); box-shadow: var(--glow-gold); }
  .stele-label {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }
  .stele-han {
    font-family: var(--font-han);
    font-size: 2.5rem;
    line-height: 1.15;
    text-shadow: 0 0 24px color-mix(in srgb, var(--c, #d4af6a) 45%, transparent);
    color: var(--c, var(--bone));
  }
  .stele-en { font-size: 0.72rem; color: var(--bone-dim); font-weight: 600; }
  .stele-sub { font-size: 0.66rem; color: var(--bone-faint); }
  .stele-master {
    position: absolute;
    top: -9px;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--gold);
    color: #0f0b02;
    font-weight: 700;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
  }

  .results-duo {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 720px) { .results-duo { grid-template-columns: 1fr; } }

  .panel.inset { padding: 1.4rem; box-shadow: none; }
  .panel.inset h4 { font-size: 1.15rem; margin-bottom: 1rem; }
  .chart-panel { display: flex; flex-direction: column; }
  .donut-wrap { max-width: 240px; margin-inline: auto; width: 100%; }

  .ebars { display: grid; gap: 0.5rem; margin-bottom: 1.2rem; }
  .ebar-row { display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem; }
  .ebar-han { font-family: var(--font-han); width: 1.1rem; text-align: center; }
  .ebar-name { width: 3.4rem; color: var(--bone-dim); }
  .ebar-track { flex: 1; height: 7px; background: var(--ink-1); border-radius: 4px; overflow: hidden; border: 1px solid var(--line-soft); }
  .ebar-fill { display: block; height: 100%; border-radius: 4px; opacity: 0.85; transition: width 1s var(--ease-out); }
  .ebar-fill.dom { opacity: 1; box-shadow: 0 0 10px currentColor; }
  .ebar-count { width: 2.2rem; text-align: right; color: var(--bone-faint); font-size: 0.75rem; }

  .elem-highlights { display: grid; gap: 0.7rem; }
  .hl-card {
    padding: 0.9rem 1.05rem;
    border-radius: var(--radius-s);
    border: 1px solid var(--line-soft);
    background: var(--ink-1);
    font-size: 0.85rem;
    color: var(--bone-dim);
  }
  .hl-card strong { color: var(--bone); display: block; margin-bottom: 0.25rem; font-size: 0.9rem; }
  .hl-card .hl-tag { color: var(--gold); }

  .reading-card { margin-bottom: 1rem; }
  .reading-head h4 { display: flex; align-items: center; gap: 0.6rem; font-size: 1.2rem; }
  .reading-head .han { color: var(--gold-deep); font-size: 0.95rem; }
  .badge-free {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-weight: 600;
  }
  .reading-body { color: var(--bone-dim); font-size: 0.93rem; line-height: 1.8; }
  .reading-body strong { color: var(--bone); }
  .reading-body ul { list-style: none; padding: 0; margin: 0.5rem 0 1rem; display: grid; gap: 0.3rem; }
  .reading-body p + p { margin-top: 0.6rem; }
  .reading-body .rt-traits { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.7rem 0 1rem; }
  .reading-body .rt-trait {
    font-size: 0.76rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.22rem 0.7rem;
    color: var(--gold-bright);
    background: rgba(212, 175, 106, 0.06);
  }

  .lucky-free-grid { display: grid; grid-template-columns: 180px 1fr; gap: 1.4rem; align-items: center; }
  @media (max-width: 620px) { .lucky-free-grid { grid-template-columns: 1fr; } }
  .lucky-compass { max-width: 180px; margin-inline: auto; width: 100%; }
  .lucky-compass.big { max-width: 260px; }

  /* paywall */
  .paywall {
    margin: 1.4rem 0;
    padding: 2rem 1.6rem;
    text-align: center;
    border: 1px dashed rgba(224, 87, 74, 0.45);
    border-radius: var(--radius);
    background:
      linear-gradient(170deg, rgba(224, 87, 74, 0.07), rgba(212, 175, 106, 0.04)),
      var(--ink-1);
  }
  .paywall-seal {
    width: 46px;
    height: 46px;
    margin: 0 auto 0.9rem;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(155deg, #e86050, var(--cinnabar) 45%, var(--cinnabar-deep));
    color: #fdf6ec;
    font-family: var(--font-han);
    font-size: 1.3rem;
    transform: rotate(-3deg);
  }
  .paywall h4 { font-size: 1.4rem; margin-bottom: 0.5rem; }
  .paywall p { color: var(--bone-dim); font-size: 0.92rem; max-width: 46ch; margin: 0 auto 1.3rem; }
  .paywall-actions { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }

  .pro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .pro-grid .reading-card { margin-bottom: 0; }
  .pro-span { grid-column: span 2; }
  @media (max-width: 720px) {
    .pro-grid { grid-template-columns: 1fr; }
    .pro-span { grid-column: auto; }
  }
  .fengshui-grid { display: grid; grid-template-columns: 1fr 260px; gap: 1.4rem; align-items: start; }
  @media (max-width: 720px) { .fengshui-grid { grid-template-columns: 1fr; } }

  .fshui-tips { display: grid; gap: 0.55rem; margin-top: 1.1rem; }
  .fshui-tip {
    padding: 0.7rem 0.95rem;
    border-radius: var(--radius-s);
    border: 1px solid var(--line-soft);
    background: var(--ink-1);
    font-size: 0.86rem;
    color: var(--bone-dim);
  }
  .fshui-tip strong { color: var(--gold-bright); }

  .lucky-kit { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
  @media (max-width: 560px) { .lucky-kit { grid-template-columns: 1fr; } }
  .kit-item {
    text-align: center;
    padding: 1rem 0.8rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-s);
    background: var(--ink-1);
  }
  .kit-item h5 { font-family: var(--font-body); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bone-faint); margin-bottom: 0.5rem; font-weight: 600; }
  .kit-value { font-family: var(--font-display); font-size: 1.35rem; color: var(--gold-bright); }
  .kit-value small { display: block; font-family: var(--font-body); font-size: 0.7rem; color: var(--bone-faint); }
  .kit-colors { display: flex; justify-content: center; gap: 0.35rem; }
  .kit-colors span { width: 22px; height: 22px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.15); }

  .results-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-soft);
  }

  @media print {
    .calc-form, .results-actions, .paywall, .site-header, .site-footer, #starfield { display: none !important; }
    body { background: #fff; color: #111; }
    body::before { display: none; }
    .panel, .panel.inset, .stele, .hl-card { border-color: #ddd; background: #fff; box-shadow: none; }
  }
</style>

<script>
  import BaZiEngine from '../lib/bazi/engine';
  import Readings from '../lib/bazi/readings';
  import { elementsDonut, elementBars, compass, pillarStrengthCards, ELEM_EN, ELEM_COLOR, BRANCH_EN, STEM_EN, ZODIAC_EMOJI } from '../lib/charts';
  import { resolveUnlock, isUnlocked } from '../lib/paypal';
  import { showToast } from '../lib/toast';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const form = $('calcForm') as HTMLFormElement | null;
  const loadingEl = $('calcLoading');
  const resultsEl = $('calcResults');
  let currentData: any = null;
  let unlocked = false;

  /* ---------- inline validation ---------- */

  function clearFieldErrors() {
    form?.querySelectorAll('.field-error').forEach((el) => el.remove());
    form?.querySelectorAll('.input.error, .select.error, .input.valid, .select.valid').forEach((el) => {
      el.classList.remove('error', 'valid');
    });
    form?.classList.remove('shake');
  }

  function showFieldError(input: HTMLInputElement | HTMLSelectElement, message: string) {
    // Remove any existing error for this field
    const field = input.closest('.field');
    if (!field) return;
    field.querySelector('.field-error')?.remove();
    input.classList.remove('valid');
    input.classList.add('error');
    const err = document.createElement('div');
    err.className = 'field-error';
    err.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 7.5v5"/><circle cx="12" cy="16.2" r="0.4" fill="currentColor"/></svg>${message}`;
    field.appendChild(err);
    input.addEventListener('input', () => clearFieldErrors(), { once: true });
    input.addEventListener('change', () => clearFieldErrors(), { once: true });
  }

  function markFieldValid(input: HTMLInputElement | HTMLSelectElement) {
    input.classList.remove('error');
    input.classList.add('valid');
  }

  // Real-time validation on blur/change
  const dateInput = $('birthDate') as HTMLInputElement | null;
  const hourSelect = $('birthHour') as HTMLSelectElement | null;

  dateInput?.addEventListener('blur', () => {
    const v = dateInput.value;
    if (!v) {
      showFieldError(dateInput, 'Please select your birth date');
    } else {
      const d = new Date(v + 'T00:00:00');
      if (d < new Date('1900-01-01') || d > new Date('2030-12-31')) {
        showFieldError(dateInput, 'Date must be between 1900 and 2030');
      } else {
        markFieldValid(dateInput);
      }
    }
  });

  hourSelect?.addEventListener('blur', () => {
    if (hourSelect.value === '') {
      showFieldError(hourSelect, 'Birth hour is required for accuracy');
    } else {
      markFieldValid(hourSelect);
    }
  });

  /* ---------- rendering ---------- */

  function pillarStele(label: string, pillar: any, sub: string, isDay: boolean, idx: number): string {
    const color = ELEM_COLOR[pillar.element];
    const animal = BRANCH_EN[pillar.branch];
    return `<div class="stele${isDay ? ' day' : ''}" style="--d:${idx * 0.09}s;--c:${color}">
      ${isDay ? '<span class="stele-master">Day Master</span>' : ''}
      <span class="stele-label">${label}</span>
      <span class="stele-han">${pillar.stem}${pillar.branch}</span>
      <span class="stele-en">${STEM_EN[pillar.stem]}</span>
      <span class="stele-sub">${animal} · ${sub}</span>
    </div>`;
  }

  function renderResults(data: any) {
    const p = data.pillars;
    const yearAnimal = BRANCH_EN[p.year.branch];
    const emoji = ZODIAC_EMOJI[yearAnimal] || '✦';
    const domEn = ELEM_EN[data.elements.dominant];
    const defEn = ELEM_EN[data.elements.deficient];
    const birthYear = new Date(data.birthDate + 'T00:00:00').getFullYear();

    $('resultGreeting')!.textContent = `${data.name}, you are a ${yearAnimal} ${emoji}`;
    $('resultSubtitle')!.textContent =
      `Born in ${birthYear} — your Four Pillars carry ${data.yearName} year energy. ` +
      `Your Day Master is ${STEM_EN[p.day.stem]}, and ${domEn} leads your chart.`;

    $('pillarsGrid')!.innerHTML =
      pillarStele('Year · 年柱', p.year, `${birthYear}`, false, 0) +
      pillarStele('Month · 月柱', p.month, 'Inner nature', false, 1) +
      pillarStele('Day · 日柱', p.day, 'True self', true, 2) +
      pillarStele('Hour · 时柱', p.hour, 'Hidden potential', false, 3);

    // Pillar Strength gauges
    $('pillarStrength')!.innerHTML = pillarStrengthCards(p);

    $('elemDonut')!.innerHTML = elementsDonut(data.elements);
    $('elemBars')!.innerHTML = elementBars(data.elements);
    const descs: Record<string, string> = {
      Wood: 'growth, creativity, flexibility',
      Fire: 'passion, energy, transformation',
      Earth: 'stability, nourishment, grounding',
      Metal: 'clarity, precision, strength',
      Water: 'wisdom, flow, intuition',
    };
    $('elemHighlights')!.innerHTML = `
      <div class="hl-card"><strong><span class="hl-tag">★</span> Dominant — ${domEn}</strong>
        ${descs[domEn]}. This is your natural superpower; it colors how you think, work and love.</div>
      <div class="hl-card"><strong><span class="hl-tag">☆</span> To strengthen — ${defEn}</strong>
        ${descs[defEn]}. Weaving small ${defEn}-element rituals into your day restores balance.</div>`;

    // personality (free)
    const persona = Readings.getPersonality(p.day.stem, data.elements.dominant);
    $('readingPersonality')!.innerHTML = persona
      ? `<p><strong>${persona.title}.</strong> ${persona.summary}</p>
         <div class="rt-traits">${(persona.traits || []).map((t: string) => `<span class="rt-trait">${t}</span>`).join('')}</div>
         <p><strong>Core strength:</strong> ${persona.strength}</p>
         <p><strong>Watch for:</strong> ${persona.weakness}</p>
         <p><strong>Ideal path:</strong> ${persona.idealPath}</p>`
      : `<p>${data.dayStemMeaning} ${data.dayBranchMeaning}</p>`;

    // lucky directions (free)
    const d = data.directions;
    $('luckyCompassMini')!.innerHTML = compass(d, ELEM_COLOR[data.elements.dominant]);
    $('luckyDirections')!.innerHTML = `
      <p>Your auspicious directions are <strong>${d.auspicious.join(' and ')}</strong> — face these when working, negotiating, or placing your desk and bed.</p>
      <p style="margin-top:.5rem">Avoid long periods facing <strong>${d.inauspicious.join(' or ')}</strong>; those directions drain your ${domEn} energy.</p>`;
  }

  function renderPro(data: any) {
    const career = Readings.getCareer(data.elements.dominant);
    const rel = Readings.getRelationship(data.elements.dominant);
    const health = Readings.getHealth(data.elements.dominant);
    const fs = Readings.getFengShui(data.elements.dominant, data.pillars.day.stem, data.elements.dominant);
    const lucky = data.lucky;

    $('readingCareer')!.innerHTML = `
      <p>${career.overview}</p>
      <p><strong>Strengths</strong></p><ul>${career.strengths.map((s: string) => `<li>• ${s}</li>`).join('')}</ul>
      <p><strong>Challenges to watch</strong></p><ul>${career.challenges.map((s: string) => `<li>• ${s}</li>`).join('')}</ul>
      <p><strong>Wealth-building tips</strong></p><ul>${career.wealthTips.map((s: string) => `<li>• ${s}</li>`).join('')}</ul>`;

    $('readingRelationships')!.innerHTML = `
      <p><strong>Your style:</strong> ${rel.overview}</p>
      <p><strong>Ideal partner:</strong> ${rel.idealPartner}</p>
      <p><strong>Communication:</strong> ${rel.communication}</p>
      <p><strong>Growth areas</strong></p><ul>${(rel.growthAreas || []).map((s: string) => `<li>• ${s}</li>`).join('')}</ul>`;

    $('readingHealth')!.innerHTML = `
      <p>${health.overview}</p>
      <p><strong>Areas to watch</strong></p><ul>${(health.commonConcerns || []).map((s: string) => `<li>• ${s}</li>`).join('')}</ul>
      <p><strong>Wellness recommendations</strong></p><ul>${(health.wellnessTips || []).map((s: string) => `<li>• ${s}</li>`).join('')}</ul>`;

    $('luckyProGrid')!.innerHTML = `
      <div class="lucky-kit">
        <div class="kit-item"><h5>Lucky Numbers</h5><div class="kit-value">${lucky.numbers.join(' · ')}</div></div>
        <div class="kit-item"><h5>Element</h5><div class="kit-value">${lucky.element}<small>${lucky.tones}</small></div></div>
        <div class="kit-item"><h5>Lucky Colors</h5>
          <div class="kit-colors">${lucky.colors.map((c: string, i: number) => `<span style="background:${c}" title="${lucky.colorNames[i]}"></span>`).join('')}</div>
        </div>
      </div>`;

    $('readingFengShui')!.innerHTML = `<p>${fs.overview}</p>`;
    $('fshuiTips')!.innerHTML = (fs.tips || []).slice(0, 5).map((tip: string) => {
      const parts = tip.split(' — ');
      return `<div class="fshui-tip"><strong>${parts[0]}</strong>${parts[1] ? ' — ' + parts[1] : ''}</div>`;
    }).join('');
    $('fengShuiCompass')!.innerHTML = compass(data.directions, ELEM_COLOR[data.elements.dominant]);
  }

  function unlockUI(scroll = false) {
    unlocked = true;
    const paywall = $('paywallCard');
    if (paywall) paywall.style.display = 'none';
    const grid = $('proGrid');
    if (grid) {
      grid.hidden = false;
      grid.querySelectorAll('.reading-card').forEach((el, i) => {
        const card = el as HTMLElement;
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        setTimeout(() => {
          card.style.transition = 'opacity .6s var(--ease-out), transform .6s var(--ease-out)';
          card.style.opacity = '1';
          card.style.transform = 'none';
        }, 120 * i);
      });
    }
    if (currentData) renderPro(currentData);
    if (scroll) $('cardCareer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ---------- flow ---------- */

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    clearFieldErrors();
    const date = ($('birthDate') as HTMLInputElement)?.value;
    const hourRaw = ($('birthHour') as HTMLSelectElement)?.value;
    if (!date) {
      showFieldError($('birthDate') as HTMLInputElement, 'Please select your birth date');
      form?.classList.add('shake');
      setTimeout(() => form?.classList.remove('shake'), 500);
      $('birthDate')?.focus();
      return;
    }
    if (hourRaw === '' || hourRaw == null) {
      showFieldError($('birthHour') as HTMLSelectElement, 'Birth hour is required for accuracy');
      form?.classList.add('shake');
      setTimeout(() => form?.classList.remove('shake'), 500);
      $('birthHour')?.focus();
      return;
    }
    const d = new Date(date + 'T00:00:00');
    if (d < new Date('1900-01-01') || d > new Date('2030-12-31')) {
      showFieldError($('birthDate') as HTMLInputElement, 'Date must be between 1900 and 2030');
      form?.classList.add('shake');
      setTimeout(() => form?.classList.remove('shake'), 500);
      return;
    }

    const name = ($('userName') as HTMLInputElement)?.value.trim();
    const hour = parseInt(hourRaw, 10);
    const gender = ($('userGender') as HTMLSelectElement)?.value;
    const location = ($('birthLocation') as HTMLInputElement)?.value.trim();

    // Disable submit button
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Casting your chart…';
    }

    // Fade out form
    form.style.opacity = '0';
    form.style.transform = 'translateY(-8px)';
    setTimeout(() => {
      form.hidden = true;
      loadingEl!.hidden = false;
      loadingEl!.classList.add('is-entering');
    }, 300);

    const steps = loadingEl!.querySelectorAll('.cast-steps li');
    steps.forEach((s) => s.classList.remove('active', 'done'));
    let idx = 0;
    const timer = setInterval(() => {
      if (idx > 0) {
        steps[idx - 1]?.classList.remove('active');
        steps[idx - 1]?.classList.add('done');
      }
      if (idx < steps.length) steps[idx]?.classList.add('active');
      idx++;
      if (idx > steps.length) clearInterval(timer);
    }, 550);

    // Compute immediately (synchronous, ~5ms) then show after animation completes
    const animDuration = steps.length * 550; // 4 steps × 550ms = 2200ms
    const minDisplay = 1200;

    const data = BaZiEngine.calculate(date, hour);
    currentData = { ...data, name: name || 'Friend', gender, location, birthDate: date };
    (window as any).currentReading = currentData;
    (window as any).__baziSetPendingReading?.(currentData);

    const delay = Math.max(animDuration, minDisplay);
    setTimeout(() => {
      loadingEl!.classList.remove('is-entering');
      loadingEl!.style.opacity = '0';
      loadingEl!.style.transform = 'translateY(-8px)';
      loadingEl!.style.transition = 'opacity 0.35s var(--ease-out), transform 0.4s var(--ease-out)';
      setTimeout(() => {
        loadingEl!.hidden = true;
        loadingEl!.style.opacity = '';
        loadingEl!.style.transform = '';
        loadingEl!.style.transition = '';
        resultsEl!.hidden = false;
        renderResults(currentData);
        if (unlocked || isUnlocked()) unlockUI();
        resultsEl!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 350);
    }, delay);
  });

  /* ---------- paywall / modal ---------- */

  $('unlockProBtn')?.addEventListener('click', () => (window as any).__baziUpgrade?.('pro', currentData));
  $('unlockUltBtn')?.addEventListener('click', () => (window as any).__baziUpgrade?.('ultimate', currentData));

  /* ---------- share & pdf ---------- */

  const shareText = () => {
    const elem = currentData ? ELEM_EN[currentData.elements.dominant] : 'Balanced';
    return `${currentData?.name || 'My'} BaZi Destiny Reading — Dominant Element: ${elem}. Discover yours free:`;
  };
  $('shareBtn')?.addEventListener('click', () => {
    const text = `${shareText()} https://mybazidestiny.com`;
    if (navigator.share) navigator.share({ title: 'BaZi Destiny Reading', text }).catch(() => {});
    else navigator.clipboard?.writeText(text).then(() => showToast('✓ Copied to clipboard!'));
  });
  const wireShare = () => {
    const text = encodeURIComponent(shareText());
    const url = encodeURIComponent('https://mybazidestiny.com');
    const tw = $('twitterShare') as HTMLAnchorElement | null;
    const fb = $('facebookShare') as HTMLAnchorElement | null;
    const wa = $('whatsappShare') as HTMLAnchorElement | null;
    if (tw) tw.href = `https://twitter.com/intent/tweet?text=${text}&url=${url}`;
    if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${url}&quote=${text}`;
    if (wa) wa.href = `https://wa.me/?text=${text}%20${url}`;
  };
  wireShare();
  form?.addEventListener('submit', () => setTimeout(wireShare, 2600));

  $('pdfBtn')?.addEventListener('click', () => {
    if (!currentData) return;
    if (isUnlocked()) window.print();
    else (window as any).__baziUpgrade?.('pro', currentData);
  });

  $('recastBtn')?.addEventListener('click', () => {
    resultsEl!.hidden = true;
    form!.hidden = false;
    form!.style.opacity = '1';
    form!.style.transform = '';
    form!.reset();
    clearFieldErrors();
    currentData = null;
    const submitBtn = form!.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `Reveal My Chart <span class="han" aria-hidden="true">排盘</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
    }
    document.getElementById('calculator')?.scrollIntoView({ behavior: 'smooth' });
  });

  /* ---------- returning from PayPal ---------- */

  const unlock = resolveUnlock();
  if (unlock.unlocked) {
    if (unlock.pending) {
      currentData = unlock.pending;
      (window as any).currentReading = currentData;
      if (form && loadingEl && resultsEl && currentData?.birthDate) {
        form.hidden = true;
        resultsEl.hidden = false;
        renderResults(currentData);
      }
    }
    unlockUI(Boolean(unlock.pending));
  }
</script>
