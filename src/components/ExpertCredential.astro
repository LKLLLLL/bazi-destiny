---
import type { Lang } from '../i18n/ui';
import { YE_QINGCHUN_PROFILE_PATH, YE_QINGCHUN_ZH_PROFILE_PATH } from '../lib/expert';

interface Props {
  lang?: Lang;
  variant?: 'inline' | 'card';
}

const { lang = 'en', variant = 'card' } = Astro.props;
const isZh = lang === 'zh';
const profilePath = isZh ? YE_QINGCHUN_ZH_PROFILE_PATH : YE_QINGCHUN_PROFILE_PATH;
---

<aside class:list={['expert-credential', `expert-credential--${variant}`]} aria-label={isZh ? '传统文化编辑' : 'Traditional culture editor'}>
  <span class="expert-seal han" aria-hidden="true">叶</span>
  <div class="expert-copy">
    <span class="expert-label">{isZh ? '传统文化编辑' : 'Traditional culture editor'}</span>
    <a class="expert-name" href={profilePath}>{isZh ? '叶青春道长' : 'Daoist Priest Ye Qingchun'}</a>
    <span class="expert-role">{isZh ? '惠州元妙古观住持' : 'Abbot of Huizhou Yuanmiao Taoist Temple'}</span>
    {variant === 'card' && (
      <p>
        {isZh
          ? '负责网站道教文化、干支五行、传统历法与姓名文化内容的编辑与语境审核。'
          : 'Provides editorial direction and cultural review for Taoist context, stems and branches, the Five Elements, traditional calendars, and Chinese naming.'}
      </p>
    )}
  </div>
</aside>

<style>
  .expert-credential {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }
  .expert-seal {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.55rem;
    height: 2.55rem;
    border: 1px solid rgba(224, 87, 74, 0.65);
    border-radius: 7px;
    background: linear-gradient(150deg, rgba(224, 87, 74, 0.22), rgba(178, 60, 49, 0.08));
    color: #ef8a7f;
    font-size: 1.3rem;
    box-shadow: 0 8px 24px -14px rgba(224, 87, 74, 0.8);
  }
  .expert-copy { display: grid; min-width: 0; line-height: 1.35; }
  .expert-label {
    color: var(--gold);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .expert-name {
    width: fit-content;
    color: var(--bone);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .expert-name:hover { color: var(--gold-bright); }
  .expert-role { color: var(--bone-faint); font-size: 0.74rem; }
  .expert-credential--inline { margin-top: 1rem; }
  .expert-credential--card {
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(165deg, rgba(212, 175, 106, 0.08), rgba(212, 175, 106, 0.025));
  }
  .expert-credential--card .expert-seal { width: 3.35rem; height: 3.35rem; font-size: 1.65rem; }
  .expert-credential--card .expert-copy { gap: 0.16rem; }
  .expert-credential--card .expert-name { font-size: 1.2rem; }
  .expert-credential--card p { margin-top: 0.45rem; max-width: 64ch; color: var(--bone-dim); font-size: 0.84rem; line-height: 1.65; }
  @media (prefers-color-scheme: light) {
    .expert-seal { color: var(--cinnabar-deep); }
  }
</style>
