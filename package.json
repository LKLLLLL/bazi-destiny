{
  "name": "mybazidestiny",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm analytics:audit && pnpm seo:audit && pnpm geo:audit && node scripts/generate-og-images.mjs && astro build && node scripts/fileformat.mjs && node scripts/verify-dist.mjs",
    "analytics:audit": "node scripts/verify-analytics.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "geo:audit": "node scripts/geo-audit.mjs",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "test:bazi": "node --experimental-strip-types tests/bazi-engine.test.ts",
    "test:payments": "node --experimental-strip-types tests/paypal-unlock.test.ts && node --experimental-strip-types tests/paypal-server.test.ts",
    "test:names": "node --experimental-strip-types tests/chinese-names.test.ts",
    "test:guardians": "node --experimental-strip-types tests/guardian-spirits.test.ts",
    "test": "pnpm test:bazi && pnpm test:names && pnpm test:guardians && pnpm test:payments",
    "preview": "astro preview",
    "postbuild": "echo done"
  },
  "dependencies": {
    "astro": "^5.12.0",
    "@astrojs/vercel": "^8.2.0",
    "@vercel/kv": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "sharp": "^0.35.3",
    "typescript": "^5.8.0"
  }
}
